---
/**
 * SITE SHELL — the NEW BUILD's shared page chrome (/landing, /work,
 * and every page to come): BaseLayout + the top nav (MENU / logo /
 * LET'S CHAT), the menu overlay, and the grain layer, with the
 * page's content slotted between nav and menu.
 *
 * MARKUP ONLY, deliberately: each page boots its own scripts
 * (char-ripple, nav entrance, its sections) so this extraction
 * changes nothing about how /landing builds — the refactor is
 * byte-identical by construction (the holding-refactor precedent).
 * ONE exception to markup-only (Oscar's mobile brief, 2026-08-10):
 * the shared mobile foundation stylesheet is imported here because
 * every new-build page needs it — its rules are all <=1024px/touch
 * gated, so desktop bundles gain bytes but render identically.
 *
 * Scoped to the `landing-v2` class family; pages pass extra body
 * classes via bodyClass (e.g. /work adds `work-page`). Nothing here
 * touches /old, /services or the holding routes.
 */
import BaseLayout from './BaseLayout.astro';
import Menu from '../components/Menu.astro';
import StartProjectModal from '../components/StartProjectModal.astro';
import { START_PROJECT_MODAL } from '../data/flags.js';
import { landingMenuLinks, landingMenuFooterLinks } from '../data/menu.js';
/* R85 (Oscar, 2026-09-06): the TABLET band, 768–1359 — the narrow
   build's structure at tablet proportions. Imported directly after
   mobile.css so it layers over the phone rules at equal specificity,
   later in the cascade. Strictly min/max-gated: the phone (≤767) and
   the shell (≥1360) never see it. */
import '../styles/landing/tablet.css';
/* THE TYPE TOKENS (the foundation task, 2026-09-07): the scale system's one
   source — every role at every band. Nothing reads them yet; Prompt 2
   replaces the mobile and tablet literals with them. Custom properties on
   :root, so the desktop renders exactly as before. */
import '../styles/type-tokens.css';
/* THE REBUILD (2026-09-07): the SHARED CHROME below the seam — the closing
   statement, the footer, the nav, the menu and the drawer at phone and
   tablet proportions, type from the tokens only. Imported after the
   tokens; every rule is max-width gated. */

interface Props {
  title?: string;
  bodyClass?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

/* SEO batch: the shell forwards the head's per-route fields — it used
   to pass only title and bodyClass, which is why every page inherited
   the layout's default description. */
const {
  title = 'The Network Effect',
  bodyClass = 'landing-v2',
  description,
  canonicalPath,
  ogImage,
  noindex,
} = Astro.props;
---

<BaseLayout title={title} bodyClass={bodyClass} htmlClass="js" description={description} canonicalPath={canonicalPath} ogImage={ogImage} noindex={noindex}>
  {/* A11y batch item 4 (Oscar, 2026-09-04): THE SKIP LINK — the first
      tab stop on every route, visible only while focused (the pill
      family, top-left, above the nav tier). Its target is #main: each
      page's <main>, and on the landing page the hero's exposed copy
      block. tabindex="-1" on those targets is what lets the jump
      actually move focus, not just the scroll. */}
  <a class="skip-link" href="#main">Skip to content</a>
  {/* Top nav — the existing chrome and menu behaviour, unchanged. */}
  <header class="home__topbar home__topbar--about">
    <nav class="home__menu-cta" aria-label="Site">
      <button
        type="button"
        class="home__menu-toggle"
        data-menu-toggle
        data-char-ripple-trigger
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Menu"
      >
        <span data-menu-label-menu data-char-ripple>MENU</span>
        <span class="home__menu-toggle-label--close" data-menu-label-close aria-hidden="true">
          <span class="home__menu-toggle-close-text">CLOSE</span>
          <span class="home__menu-toggle-x" data-menu-toggle-x aria-hidden="true">×</span>
        </span>
        {/* MOBILE burger (Figma 0:405 — mobile rebuild 2026-08-13):
            three 16×2 bars at a 5px pitch, white + difference like
            the rest of the topbar. display:none above the seam; on
            mobile the text labels hide and this is the toggle's
            face — the open state draws an X from the outer bars
            (CSS only; menu.js's label choreography keeps running
            for desktop and stays harmless here). */}
        <span class="home__menu-burger" aria-hidden="true">
          <span class="home__menu-burger-bar"></span>
          <span class="home__menu-burger-bar"></span>
          <span class="home__menu-burger-bar"></span>
        </span>
      </button>
    </nav>
    {/* Logo links home (Oscar's rev). The wordmark box stays the
        styled/blend/sweep element; the anchor inside is
        the click surface — nav-motion builds the entrance chars
        INSIDE it so the link survives the char wrap. */}
    {/* NAV RESPEC (frame 17:1637, 2026-08-24): the SSR text is the
        MOBILE wordmark; on desktop ensureLogoChars() swaps it to
        "TheNetworkEffect" (Serrif Medium 24 — landing.css) before
        any wrap or reveal, so the mobile DOM stays byte-identical. */}
    {/* A11y batch item 9: a <div>, not an <h1> — the wordmark is the
        site's name on every route, not the page's title, and as an h1
        it gave every page two top-level headings (or, on the landing
        page, the wrong one). Each page now carries its own h1. The
        class is what everything targets; nothing keyed on the tag. */}
    <div class="home__logo"><a class="home__logo-link" href="/">THE NETWORK EFFECT</a></div>
    {/* THREE DIRECT LINKS (R29, Oscar 2026-09-03 — FOUNDERS rejoins
        the frame 1:643 pair as the third item, same markup and
        treatment): WORK · SERVICES · FOUNDERS, 16px on the 32px gap
        (the size drops from 18 with LET'S CHAT; the wordmark is
        unchanged). The group re-centres on the viewport from its own
        live width — the bar's 1fr / auto / 1fr grid, no stored x.
        Hidden <=1024 where the burger + overlay stay the shipped
        mobile nav (the link exists in the DOM, display:none). */}
    <nav class="home__nav-links" aria-label="Primary">
      <a class="home__nav-link" href="/work" data-char-ripple-trigger
        ><span data-char-ripple>WORK</span></a
      >
      <a class="home__nav-link" href="/services" data-char-ripple-trigger
        ><span data-char-ripple>SERVICES</span></a
      >
      <a class="home__nav-link" href="/founders" data-char-ripple-trigger
        ><span data-char-ripple>FOUNDERS</span></a
      >
    </nav>
    {/* "LET'S CHAT" replaces the visible address (Oscar's rev).
        The arrow is Oscar's supplied SVG
        inlined per his spec: fill="currentColor" (the asset's
        hardcoded white fill stripped, its no-op full-rect clipPath
        dropped) so text + arrow are ONE blended element that can
        never desync under the nav's per-item difference treatment. */}
    {/* LET'S CHAT -> /contact (Oscar, 2026-08-27) — a page link now,
        not a mailto; this also gives desktop its first route to
        /contact (the link-audit finding). The email ruling stays a
        separate decision on the other mailto surfaces. */}
    <a
      class="home__topbar-email"
      href="/contact"
      data-char-ripple-trigger
    >
      <span data-char-ripple>LET’S CHAT</span>
      <svg
        class="home__topbar-email-arrow"
        viewBox="0 0 300 300"
        aria-hidden="true"
        data-char-ripple-arrow
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M44.3693 300L22.9417 277.21L1.51425 255.783L208.333 53.788H5.41863e-06L0 0H300V300H246.212V91.6667L44.3693 300Z"
          fill="currentColor"
        />
      </svg>
    </a>
  </header>

  <slot />

  {/* TODO(menu): the overlay below is the /old site's shared menu
      (data/menu.js drives /old routes) — the new build's own menu
      isn't designed yet. When it lands, add WORK -> /work there.
      Not building or modifying the /old menu now (scope rule). */}
  {/* The new build's items: ONE row — Work / Services / Founders, the
      desktop nav's three in its order (the menu fix, 2026-09-07; was
      3 + 2, then 2 + 2 with a Home row). Contact is the LET'S CHAT CTA
      below them; the wordmark is home. Row layout/spacing in landing.css. */}
  <Menu
    rows={[landingMenuLinks]}
    footerLinks={landingMenuFooterLinks}
  />

  {/* START A PROJECT — the site-wide form modal (R40): a sibling of the
      menu at z400 (the lightbox tier), its logo twin at z401; every
      [data-start-project] on the page opens it. R41: behind the
      START_PROJECT_MODAL flag — on locally, off in a build (the
      triggers fall back to their shipped behaviour). */}
  {START_PROJECT_MODAL && <StartProjectModal />}

  {/* Grain: last-in-body sibling, never an ancestor (blend safety). */}
  <div class="landing-grain" aria-hidden="true"></div>
</BaseLayout>
