---
import '../styles/global.css';
import '../styles/canvas-cursor.css';
import '../styles/page-transition.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  htmlClass?: string;
}

const {
  title = 'The Network Effect',
  description = 'A relationship-led agency.',
  bodyClass = '',
  htmlClass = '',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class:list={[htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={[bodyClass]}>
    <canvas class="canvas-cursor" data-canvas-cursor aria-hidden="true"></canvas>

    <!-- Cover Page Transition overlay — always present, z-index 9999 -->
    <div class="page-cover" aria-hidden="true">
      <div class="page-cover__row"></div>
      <div class="page-cover__row"></div>
    </div>

    <slot />
  </body>
</html>

<script>
  import { initCanvasCursor } from '../scripts/canvas-cursor.js';
  import { initPageTransition } from '../scripts/page-transition.js';
  import { initGradualBlur } from '../scripts/gradual-blur.js';

  let cleanupCanvasCursor = initCanvasCursor();

  initPageTransition();
  initGradualBlur();

  document.addEventListener('astro:before-swap', () => {
    cleanupCanvasCursor();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCanvasCursor = initCanvasCursor();
    initGradualBlur();
  });
</script>
