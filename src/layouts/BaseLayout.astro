---
import '../styles/global.css';
import '../styles/canvas-cursor.css';
/* page-transition cover CSS is INLINE in <head> below — it must be
   present before first paint (see the pre-paint hold block). */

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  htmlClass?: string;
}

const {
  title = 'The Network Effect',
  description = 'A relationship-led agency.',
  bodyClass = '',
  htmlClass = '',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class:list={[htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline define:vars={{ base }}>
      /**
       * Scale-shell boot — 15" (and any sub-1728) viewport support.
       *
       * The site is designed and px-tuned against a 1728px-wide viewport.
       * Below that width, this script hands the load over to the static
       * shell page (public/scale-shell.html) via location.replace — a
       * genuinely fresh document, so nothing from this page's module
       * graph leaks into the shell (document.open() is a no-op from a
       * parser-inserted script, so an in-place rewrite cannot work).
       * The shell mounts this SAME url (?framed=1) in a same-origin
       * <iframe> laid out at design size and transform-scaled to fit.
       * Inside the iframe every viewport unit, innerWidth read, and px
       * constant resolves in design space — no section code changes.
       *
       * Escape hatches: ?noscale serves the page bare (persists for the
       * tab session via sessionStorage); ?noscale=0 re-enables the shell.
       *
       * MOBILE (Oscar's brief, 2026-08-10): at and below MOBILE_MAX the
       * shell NEVER engages — the page serves bare and the native mobile
       * layout (the max-width:1024px blocks + mobile JS paths) is the
       * experience. 1024 is the house seam: the holding pages' proven
       * MOBILE_MAX_WIDTH, and the boundary every new-build stylesheet
       * and driver already gates on. A phone in either orientation
       * (widest: 932 logical) never crosses it; only iPads do, on
       * rotation — that crossing is a full navigation by design (the
       * shell is a different document; there is no in-place handover).
       */
      (function () {
        var DESIGN_WIDTH = 1728;
        var MOBILE_MAX = 1024;
        var params = new URLSearchParams(window.location.search);

        var noscaleParam = params.get('noscale');
        try {
          if (noscaleParam !== null) {
            if (noscaleParam === '0') sessionStorage.removeItem('ne-noscale');
            else sessionStorage.setItem('ne-noscale', '1');
          }
        } catch (e) {
          /* private browsing may block sessionStorage — param still applies */
        }

        // Inside the shell's iframe: never re-shell (top check makes
        // double-nesting impossible even after in-frame navigation drops
        // ?framed=1). Publish URL + title so the shell's address bar
        // tracks navigation.
        if (window.top !== window.self) {
          document.addEventListener('DOMContentLoaded', function () {
            try {
              window.parent.postMessage(
                {
                  type: 'ne-scale-shell:navigated',
                  href: window.location.href,
                  title: document.title,
                },
                window.location.origin
              );
            } catch (e) {
              /* shell missing or blocked — page still works standalone */
            }
          });
          return;
        }

        var noscale;
        if (noscaleParam !== null) {
          noscale = noscaleParam !== '0';
        } else {
          noscale = false;
          try {
            noscale = sessionStorage.getItem('ne-noscale') === '1';
          } catch (e) {}
        }
        if (noscale || params.get('framed') === '1') return;

        function enterShell() {
          /* CARRY THE RELOAD SIGNAL ACROSS THE HANDOVER (Oscar's rev:
             refresh must replay the splash). The shell rewrites the
             address bar to the real path, so a refresh re-requests
             THIS document — which then location.replace()s into the
             shell, and a replace is a 'navigate'. The inner document
             therefore never sees 'reload'. Stash it here, on the only
             document that knows, and let the splash's own decision
             consume it. Landing paths only, so refreshing any other
             page can't arm it. */
          try {
            var navE = performance.getEntriesByType('navigation')[0];
            if (navE && navE.type === 'reload'
                && /^\/(?:landing\/?)?$/.test(window.location.pathname)) {
              sessionStorage.setItem('ne-splash-reload', '1');
            }
          } catch (e) {}
          var p = new URLSearchParams(window.location.search);
          p.set('framed', '1');
          var target =
            window.location.pathname +
            '?' +
            p.toString() +
            window.location.hash;
          window.location.replace(
            base + 'scale-shell.html#' + encodeURIComponent(target)
          );
        }

        // The shell serves ONLY the (MOBILE_MAX, DESIGN_WIDTH) band.
        // Outside it the page stays bare: >=1728 is the design size;
        // <=1024 is native mobile. Either bare mode watches for the
        // window settling INTO the band (monitor drag, iPad rotation)
        // and enters the shell then — the same 300ms settle the
        // original wide-side listener used.
        //
        // TWO width sources, deliberately: the >=1728 side keeps
        // window.innerWidth — the shipped desktop semantics, untouched.
        // The MOBILE side reads documentElement.clientWidth — the SAME
        // measure the max-width:1024px media queries resolve against,
        // so JS and CSS can never disagree about which side of the
        // seam the page is on (innerWidth is also the read known to go
        // stale after emulation/device-toolbar resizes — the
        // scale-shell sizing lesson).
        function mobileWidth() {
          return document.documentElement.clientWidth || window.innerWidth;
        }
        function inShellBand() {
          return mobileWidth() > MOBILE_MAX && window.innerWidth < DESIGN_WIDTH;
        }
        if (!inShellBand()) {
          // Which bare regime booted: scripts and CSS were chosen for
          // THIS side of the seam. If a settled resize crosses it
          // without entering the shell (1728-wide window dragged to
          // phone width, or a mobile-booted window stretched past
          // 1728), one clean reload reboots the right regime — the
          // same full-navigation answer the shell handovers use; an
          // in-place regime swap would strand the booted drivers.
          var bootedMobile = mobileWidth() <= MOBILE_MAX;
          var t;
          var settle = function () {
            clearTimeout(t);
            t = setTimeout(function () {
              if (inShellBand()) {
                enterShell();
                return;
              }
              if ((mobileWidth() <= MOBILE_MAX) !== bootedMobile) {
                window.location.reload();
              }
            }, 300);
          };
          window.addEventListener('resize', settle);
          if (window.visualViewport) {
            window.visualViewport.addEventListener('resize', settle);
          }
          // resize events are not guaranteed to accompany every real
          // viewport change (emulation toolbars, some rotation paths)
          // — observing documentElement catches the layout change
          // itself, the scale-shell's proven self-healing pattern.
          // Its initial fire runs one settle check against the boot
          // regime: a no-op by construction.
          if (window.ResizeObserver) {
            new ResizeObserver(settle).observe(document.documentElement);
          }
          return;
        }

        enterShell();
      })();
    </script>
    {/* ── Page-transition PRE-PAINT hold (the wipe rebuild, Oscar
        2026-08-08). CRITICAL cover CSS + a synchronous boot: both
        must exist before first paint so an arriving page NEVER
        shows raw content before the module executes (the old
        system's deferred gsap.set left exactly that flash window).
        The module (scripts/page-transition.js) owns everything
        after boot; this block only (a) holds the panel closed when
        the load is a transition arrival or a back/forward
        navigation, and (b) arms a vanilla CSS-only failsafe so the
        site is unstrandable even if the module never executes. */}
    <style is:inline>
      .page-cover {
        position: fixed;
        top: -2px;
        bottom: -2px;
        left: -2px;
        width: calc(100vw + 4px); /* 2px overshoot each side — no edge-gap shimmer */
        background: #161616;
        transform: translate3d(-100%, 0, 0); /* rest: parked off the LEFT edge */
        will-change: transform;
        pointer-events: none;
        z-index: 10000; /* above EVERYTHING incl. the canvas cursor (9999) */
      }
      .page-cover--blocking { pointer-events: all; }
      /* The ARRIVING document paints its root black while the cover
         is held, so the inter-document handover (root background
         until first paint) is black at BOTH ends — the departing
         page sets it inline in page-transition.js. Cleared with the
         attribute when the reveal finishes. */
      html[data-ne-cover='hold'],
      html[data-ne-cover='hold'] body { background: #161616; }
      html[data-ne-cover='hold'] .page-cover {
        transform: none !important; /* covered before first paint; module takes over inline */
        pointer-events: all;
      }
      html[data-ne-cover='failsafe-reveal'] .page-cover {
        transform: translate3d(-100%, 0, 0);
        transition: transform 0.65s cubic-bezier(0.66, 0, 0.34, 1);
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) {
        html[data-ne-cover='failsafe-reveal'] .page-cover { transition: none; }
      }
    </style>
    <script is:inline>
      (function () {
        var held = false;
        try {
          if (sessionStorage.getItem('ne-page-transition')) {
            sessionStorage.removeItem('ne-page-transition');
            held = true;
          }
        } catch (e) {
          /* private browsing — no flag, no hold */
        }
        if (!held) {
          /* Fresh back/forward loads carry no flag (the forward doc
             consumed it) but must run the same choreography. */
          try {
            var nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.type === 'back_forward') held = true;
          } catch (e) {}
        }
        if (!held) return;
        var d = document.documentElement;
        d.setAttribute('data-ne-cover', 'hold');
        /* FAILSAFE 1 of 3 (module-independent): if page-transition.js
           never executes (error, blocked JS), force a CSS reveal —
           the site must be unstrandable under the cover, ever. */
        var t = setTimeout(function () {
          d.setAttribute('data-ne-cover', 'failsafe-reveal');
          setTimeout(function () { d.removeAttribute('data-ne-cover'); }, 900);
        }, 2500);
        window.__neCoverBoot = { cancel: function () { clearTimeout(t); } };
      })();
    </script>
    <style is:inline>
      /* ── SPLASH pre-paint (see LandingSplash.astro). MUST be in the
         head: in the body the light page paints first (Oscar's white
         flash). */
  .splash-v2 {
    position: fixed;
    inset: 0;
    z-index: 11000;
    background: #161616;
    will-change: transform;
    /* Hidden by default: only the inline boot below reveals it, so a
       load that should NOT splash never paints black at all. */
    display: none;
  }

  html[data-ne-splash='on'] .splash-v2 { display: block; }

  /* Scroll is locked while the cover is up, and nothing beneath is
     tabbable (the gate is the /old splash's own convention, which
     Menu.astro already honours).

     Keyed on .splash-active ONLY — that class is added pre-paint by
     the inline boot below and REMOVED when the sequence finishes.
     Keying it on [data-ne-splash] instead left the page unscrollable
     for good, because that attribute has to persist to keep the
     entrance's end states from snapping back. */
  html.splash-active,
  html.splash-active body {
    overflow: hidden !important;
  }

  html.splash-active [data-splash-gate] {
    visibility: hidden;
    pointer-events: none;
  }

  .splash-v2__logo {
    /* A TOP-LEVEL FIXED SIBLING of the cover, NOT a child (Oscar's
       rev 3: the logo must LAND in the nav and STAY while the black
       lifts — as a child it rode up off-screen with the cover, which
       read as "disappears, then the black exits").

       It carries DIFFERENCE itself at z 11001 (the contact modal's
       logo-twin precedent — top-level so no ancestor stacking
       context isolates the blend): over the black cover the grey
       renders light; as the cover's edge passes it the backdrop
       becomes the page ground and the SAME element renders black —
       the white-to-black flip Oscar described, done by compositing,
       no swap or crossfade at all. */
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(1);
    z-index: 11001;
    margin: 0;
    display: none;
    /* The NAV WORDMARK'S EXACT treatment (nav respec 2026-08-24:
       Serrif Medium 24 / +0.03em / "TheNetworkEffect") — both
       instances share family/weight/em-tracking/text, so the
       handoff's scale maps one onto the other with pixel-matched
       endpoints by construction. NOTE (flagged): nav wordmark is
       now ALSO 24px, so the travel is near-parity — a pure
       centre-to-top-left move, no shrink. Colour is the site ground
       grey (Oscar's rev 3 — was #fff), matching the loading line. */
    font-family: var(--font-serif-cond);
    font-weight: 500;
    font-synthesis: none;
    font-size: var(--ts-serif-section-size); /* parity with the 34px
       nav wordmark: the handoff is a pure glide */
    line-height: var(--ts-serif-section-lh); /* 38 (guide; frame 39 — guide wins) */
    letter-spacing: var(--ts-serif-section-track);
    text-transform: none;
    color: #eeeef0;
    mix-blend-mode: difference;
    white-space: nowrap;
    transform-origin: 50% 50%;
    pointer-events: none;
  }

  html[data-ne-splash='on'] .splash-v2__logo { display: block; }

  /* Each character starts hidden; splash.js applies the nav's own
     .nav-char-in class, but HERE it runs the splash's own variant
     (Oscar's rev: twice as slow as the nav's 0.45s, with a much
     bigger blur — 10px vs the nav's 3). Scoped to the splash logo,
     so the nav's sweeps everywhere else are untouched. */
  .splash-v2__logo .cr-char {
    display: inline-block;
    opacity: 0;
  }

  /* The wordmark is INVISIBLE until splash.js has split it into
     .cr-char units and armed the ripple (Oscar's report: the logo
     appeared, vanished, then animated in — that gap was the raw
     text painting before the chars existed). visibility, not
     opacity: opacity would make this element its own stacking
     context and break its difference blend. */
  .splash-v2__logo { visibility: hidden; }
  .splash-v2__logo.is-ready { visibility: visible; }

  /* The GROUND is black the moment the splash is on, so no light
     frame can ever paint beneath the cover. Keyed on .splash-active
     (added pre-paint by the boot below, REMOVED when the sequence
     finishes) — NOT on [data-ne-splash], which has to persist to
     hold the entrance's end states and would leave the page black
     for good. */
  html.splash-active,
  html.splash-active body { background: #161616 !important; }

  .splash-v2__logo .cr-char.nav-char-in {
    animation: splash-char-in 0.9s ease-out both;
  }

  @keyframes splash-char-in {
    from {
      opacity: 0;
      filter: blur(10px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  .splash-v2__line {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: #eeeef0; /* the site ground grey (Oscar's rev 3 — was #fff) */
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-v2__line { display: none; }
    .splash-v2__logo .cr-char { opacity: 1; animation: none !important; }
  }
</style>
    <script is:inline>
      (function () {
        /* Landing only — and BEFORE first paint. */
        if (!/^\/(?:landing\/?)?$/.test(window.location.pathname)) return;
        try {
          var p = new URLSearchParams(window.location.search).get('splash');
          var on;
          if (p === '1') on = true;
          else if (p === '0') on = false;
          else if (document.documentElement.getAttribute('data-ne-cover') === 'hold') on = false;
          else {
            /* RELOAD ALWAYS REPLAYS (Oscar's rev): a refresh or hard
               refresh on the landing page shows the sequence again;
               only same-session arrivals that are NOT reloads are
               suppressed by the seen-flag. Internal navigation is
               already excluded above — the wipe owns those loads.

               THE SHELL CAVEAT: below 1728 the page runs inside
               scale-shell.html's iframe, and the shell re-sets
               frame.src on every load — so the INNER document always
               reports 'navigate', never 'reload'. Read the TOP
               document's navigation type when framed (same-origin by
               construction), which is the one that actually knows a
               refresh happened. */
            var navType = '';
            try {
              var perfSrc = (window.top !== window.self && window.top.performance)
                ? window.top.performance
                : window.performance;
              var navEntry = perfSrc.getEntriesByType('navigation')[0];
              navType = navEntry ? navEntry.type : '';
            } catch (e) { /* cross-origin or unsupported — fall through */ }

            /* Either the document itself was reloaded (bare, >=1728)
               or the pre-shell document was and left the marker. */
            var carried = false;
            try {
              carried = !!sessionStorage.getItem('ne-splash-reload');
              if (carried) sessionStorage.removeItem('ne-splash-reload');
            } catch (e) {}

            if (navType === 'reload' || carried) on = true;
            else {
              try { on = !sessionStorage.getItem('ne-splash-seen'); }
              catch (e) { on = true; }
            }
          }
          if (on) {
            document.documentElement.setAttribute('data-ne-splash', 'on');
            document.documentElement.classList.add('splash-active');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={[bodyClass]}>
    <canvas class="canvas-cursor" data-canvas-cursor aria-hidden="true"></canvas>

    <!-- Page-transition wipe panel — single opaque #161616 layer,
         z 10000 (critical CSS inline in head; machine in
         scripts/page-transition.js). Childless + blend-free by
         design: it occludes the difference nav/logo, never
         composites with them. -->
    <div class="page-cover" aria-hidden="true"></div>

    <slot />
  </body>
</html>

<script>
  import { initCanvasCursor } from '../scripts/canvas-cursor.js';
  import { initPageTransition } from '../scripts/page-transition.js';
  import { initGradualBlur } from '../scripts/gradual-blur.js';

  let cleanupCanvasCursor = initCanvasCursor();

  initPageTransition();
  initGradualBlur();

  document.addEventListener('astro:before-swap', () => {
    cleanupCanvasCursor();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCanvasCursor = initCanvasCursor();
    initGradualBlur();
  });
</script>
