---
import '../styles/global.css';
import '../styles/canvas-cursor.css';
/* page-transition cover CSS is INLINE in <head> below — it must be
   present before first paint (see the pre-paint hold block). */

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  htmlClass?: string;
}

const {
  title = 'The Network Effect',
  description = 'A relationship-led agency.',
  bodyClass = '',
  htmlClass = '',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class:list={[htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline define:vars={{ base }}>
      /**
       * Scale-shell boot — 15" (and any sub-1728) viewport support.
       *
       * The site is designed and px-tuned against a 1728px-wide viewport.
       * Below that width, this script hands the load over to the static
       * shell page (public/scale-shell.html) via location.replace — a
       * genuinely fresh document, so nothing from this page's module
       * graph leaks into the shell (document.open() is a no-op from a
       * parser-inserted script, so an in-place rewrite cannot work).
       * The shell mounts this SAME url (?framed=1) in a same-origin
       * <iframe> laid out at design size and transform-scaled to fit.
       * Inside the iframe every viewport unit, innerWidth read, and px
       * constant resolves in design space — no section code changes.
       *
       * Escape hatches: ?noscale serves the page bare (persists for the
       * tab session via sessionStorage); ?noscale=0 re-enables the shell.
       */
      (function () {
        var DESIGN_WIDTH = 1728;
        var params = new URLSearchParams(window.location.search);

        var noscaleParam = params.get('noscale');
        try {
          if (noscaleParam !== null) {
            if (noscaleParam === '0') sessionStorage.removeItem('ne-noscale');
            else sessionStorage.setItem('ne-noscale', '1');
          }
        } catch (e) {
          /* private browsing may block sessionStorage — param still applies */
        }

        // Inside the shell's iframe: never re-shell (top check makes
        // double-nesting impossible even after in-frame navigation drops
        // ?framed=1). Publish URL + title so the shell's address bar
        // tracks navigation.
        if (window.top !== window.self) {
          document.addEventListener('DOMContentLoaded', function () {
            try {
              window.parent.postMessage(
                {
                  type: 'ne-scale-shell:navigated',
                  href: window.location.href,
                  title: document.title,
                },
                window.location.origin
              );
            } catch (e) {
              /* shell missing or blocked — page still works standalone */
            }
          });
          return;
        }

        var noscale;
        if (noscaleParam !== null) {
          noscale = noscaleParam !== '0';
        } else {
          noscale = false;
          try {
            noscale = sessionStorage.getItem('ne-noscale') === '1';
          } catch (e) {}
        }
        if (noscale || params.get('framed') === '1') return;

        function enterShell() {
          var p = new URLSearchParams(window.location.search);
          p.set('framed', '1');
          var target =
            window.location.pathname +
            '?' +
            p.toString() +
            window.location.hash;
          window.location.replace(
            base + 'scale-shell.html#' + encodeURIComponent(target)
          );
        }

        if (window.innerWidth >= DESIGN_WIDTH) {
          // Loaded bare on a wide viewport. If the window later shrinks
          // below the design width (e.g. dragged from an external monitor
          // to the laptop), re-enter the shell once the resize settles.
          var t;
          window.addEventListener('resize', function () {
            clearTimeout(t);
            t = setTimeout(function () {
              if (window.innerWidth < DESIGN_WIDTH) enterShell();
            }, 300);
          });
          return;
        }

        enterShell();
      })();
    </script>
    {/* ── Page-transition PRE-PAINT hold (the wipe rebuild, Oscar
        2026-08-08). CRITICAL cover CSS + a synchronous boot: both
        must exist before first paint so an arriving page NEVER
        shows raw content before the module executes (the old
        system's deferred gsap.set left exactly that flash window).
        The module (scripts/page-transition.js) owns everything
        after boot; this block only (a) holds the panel closed when
        the load is a transition arrival or a back/forward
        navigation, and (b) arms a vanilla CSS-only failsafe so the
        site is unstrandable even if the module never executes. */}
    <style is:inline>
      .page-cover {
        position: fixed;
        top: -2px;
        bottom: -2px;
        left: -2px;
        width: calc(100vw + 4px); /* 2px overshoot each side — no edge-gap shimmer */
        background: #161616;
        transform: translate3d(-100%, 0, 0); /* rest: parked off the LEFT edge */
        will-change: transform;
        pointer-events: none;
        z-index: 10000; /* above EVERYTHING incl. the canvas cursor (9999) */
      }
      .page-cover--blocking { pointer-events: all; }
      html[data-ne-cover='hold'] .page-cover {
        transform: none !important; /* covered before first paint; module takes over inline */
        pointer-events: all;
      }
      html[data-ne-cover='failsafe-reveal'] .page-cover {
        transform: translate3d(-100%, 0, 0);
        transition: transform 0.65s cubic-bezier(0.66, 0, 0.34, 1);
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) {
        html[data-ne-cover='failsafe-reveal'] .page-cover { transition: none; }
      }
    </style>
    <script is:inline>
      (function () {
        var held = false;
        try {
          if (sessionStorage.getItem('ne-page-transition')) {
            sessionStorage.removeItem('ne-page-transition');
            held = true;
          }
        } catch (e) {
          /* private browsing — no flag, no hold */
        }
        if (!held) {
          /* Fresh back/forward loads carry no flag (the forward doc
             consumed it) but must run the same choreography. */
          try {
            var nav = performance.getEntriesByType('navigation')[0];
            if (nav && nav.type === 'back_forward') held = true;
          } catch (e) {}
        }
        if (!held) return;
        var d = document.documentElement;
        d.setAttribute('data-ne-cover', 'hold');
        /* FAILSAFE 1 of 3 (module-independent): if page-transition.js
           never executes (error, blocked JS), force a CSS reveal —
           the site must be unstrandable under the cover, ever. */
        var t = setTimeout(function () {
          d.setAttribute('data-ne-cover', 'failsafe-reveal');
          setTimeout(function () { d.removeAttribute('data-ne-cover'); }, 900);
        }, 2500);
        window.__neCoverBoot = { cancel: function () { clearTimeout(t); } };
      })();
    </script>
  </head>
  <body class:list={[bodyClass]}>
    <canvas class="canvas-cursor" data-canvas-cursor aria-hidden="true"></canvas>

    <!-- Page-transition wipe panel — single opaque #161616 layer,
         z 10000 (critical CSS inline in head; machine in
         scripts/page-transition.js). Childless + blend-free by
         design: it occludes the difference nav/logo, never
         composites with them. -->
    <div class="page-cover" aria-hidden="true"></div>

    <slot />
  </body>
</html>

<script>
  import { initCanvasCursor } from '../scripts/canvas-cursor.js';
  import { initPageTransition } from '../scripts/page-transition.js';
  import { initGradualBlur } from '../scripts/gradual-blur.js';

  let cleanupCanvasCursor = initCanvasCursor();

  initPageTransition();
  initGradualBlur();

  document.addEventListener('astro:before-swap', () => {
    cleanupCanvasCursor();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCanvasCursor = initCanvasCursor();
    initGradualBlur();
  });
</script>
