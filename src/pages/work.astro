---
/**
 * /work — FEATURED WORK, the new build's second route (Figma
 * 27:3103, extracted 2026-08-06; 83px chrome offset subtracted; the
 * file's y107 nav ignored — the shared shell's nav position wins).
 *
 * Fixed-viewport page: left column static (FEATURED/WORK header,
 * the active project's brand-black meta — filters retired
 * 2026-08-26, frame 35:1524), right
 * carousel of 1024×640 images travelling vertically on wheel/touch
 * through the holding pages' proven single-velocity drift driver
 * (autoDrift 0 — scroll-driven only, the /holding-2 precedent).
 * FINITE travel (Oscar's rev — was an infinite loop): starts with
 * the first image top on the meta title's top line, nothing above;
 * ends after the last project, then the landing FOOTER reveals from
 * behind (the parallax uncover). All machinery in work-page.js.
 *
 * Content: WORK_PROJECTS in src/data/landing/featured-work.js — the
 * landing section's eight projects IN ITS ORDER with its copy
 * (Oscar's rev; images placeholder pending his drop). RIGHTS:
 * elevated third-party-IP / named-person flags live with the data.
 *
 * Tiles are REAL LINKS to /work/[slug] — routes that don't exist
 * yet, so navigation is prevented in JS (placeholders, commented
 * there). Keyboard: tiles tabbable; focusing a tile retargets the
 * travel to bring it to the anchor.
 *
 * STAGING ONLY — same rule as /landing: nothing here is promoted
 * anywhere until Oscar says so.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { WORK_PROJECTS, WORK_EXTRAS } from '../data/landing/featured-work.js';
import { LIVE_CASE_SLUGS } from '../data/landing/case-studies.js';
import { asset } from '../utils/asset.js';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/landing/work.css';
import '../styles/fonts.css';

/* ── MOBILE LIST (Figma cqJWAceQKUmyuhF1ZxYXLI frame 1:11, rebuild
   2026-08-13): the FILE'S nine-entry order wins for mobile display
   (Oscar's brief) — content still comes from the single source
   above (WORK_PROJECTS + the WORK_EXTRAS stubs the file includes),
   NO forked copy. The file's own text layers for the TBC-class
   entries are copy-paste placeholders (see the build report), so
   the data's TBC stubs render verbatim until Oscar's content drop.
   NOTE the deltas, all reported: Thunder Aviation (/07) has no slot
   in the file's mobile order; the Ashley-portrait and adidas
   Spezial stubs (elevated-rights imagery — flags live on the data)
   appear only here. */
const MOBILE_ORDER = [
  'wilderness-reserve',
  'pavilion-club',
  'pavilion-summit',
  'top-boy',
  'tbc-ashley-walters',
  'yoxman-food-festival',
  'adolescence',
  'tbc-adidas-spezial',
  'animol',
];
const workPool = [...WORK_PROJECTS, ...WORK_EXTRAS];
const MOBILE_ENTRIES = MOBILE_ORDER.map((slug) => workPool.find((p) => p.slug === slug)).filter(
  (p) => p !== undefined,
);
const moreArrow = asset('/assets/landing/services-stack/more-arrow.svg');

/* ── GRID VIEW (R35, Oscar 2026-09-03) — COMPOSITION A, nine tiles from
   the single source (the eight projects + the Ashley portrait stub,
   the pool's only true 3:4 source). A 12-column grid inside the 24px
   margins (1680 → column 118 on 24px gutters, work.css); modules:
   l6 = 6-col landscape 828×552 (3:2), l3 = 3-col landscape 402×268,
   sq3 = 3-col square 402×402, p3 = 3-col portrait 402×536 (3:4).
   The rows copy the reference's first two row compositions module
   for module and put its World Buskers module on the RIGHT of row 3
   with one small tile left and the middle open; counts 3 / 4 / 2
   never repeat, no adjacent pair shares a size, every row mixes
   three heights. The TV/film work (Adolescence, Animol, Top Boy) are
   the landscapes — their elevated rights flags (data header) stand,
   and they are prominent tiles now. Top Boy takes the template's
   small landscape (Oscar's ruling on option A). */
const GRID_ROWS = [
  [['animol', 'l6'], ['wilderness-reserve', 'sq3'], ['tbc-ashley-walters', 'p3']],
  [['top-boy', 'l3'], ['pavilion-club', 'p3'], ['yoxman-food-festival', 'sq3'], ['pavilion-summit', 'p3']],
  [['thunder-aviation', 'sq3'], ['adolescence', 'l6r']],
];
const gridRows = GRID_ROWS.map((row) =>
  row.map(([slug, mod]) => ({ p: workPool.find((x) => x.slug === slug), mod })).filter((t) => t.p !== undefined),
);

---

<SiteShell title="Featured Work — The Network Effect" bodyClass="landing-v2 work-page">
  <main class="work-stage" data-work-stage aria-label="Featured work">
    {/* Carousel — the full nine-project set (work-page.js rebuilds
        the same markup shape at init; the filter machinery is
        retired, 2026-08-26). */}
    <div class="work-stage__carousel" data-work-carousel>
      {WORK_PROJECTS.map((p, i) => (
        LIVE_CASE_SLUGS.includes(p.slug) ? (
        <a
          class="work-tile"
          href={`/work/${p.slug}`}
          data-work-link
          data-slug={p.slug}
          data-index={String(i)}
          data-tags={p.tags.join(' ')}
          aria-label={`${p.title.join(' ')} — view project`}
        >
          <img
            src={p.workImg}
            alt=""
            loading={i < 3 ? 'eager' : 'lazy'}
            decoding="async"
            width="1024"
            height="616"
          />
          {/* (The 2026-08-10 per-tile mobile meta is retired — the
              402-frame rebuild renders its own mobile list below;
              this carousel is display:none under the seam.) */}
        </a>
        ) : (
        <span
          class="work-tile is-placeholder"
          data-a4-note="unbuilt study: inert placeholder — no href, no data-work-link (no cursor), unfocusable"
          data-slug={p.slug}
          data-index={String(i)}
          data-tags={p.tags.join(' ')}
        >
          <img
            src={p.workImg}
            alt=""
            loading={i < 3 ? 'eager' : 'lazy'}
            decoding="async"
            width="1024"
            height="616"
          />
        </span>
        )
      ))}
    </div>

    {/* ── MOBILE LIST (frame 1:11) — the native vertical page:
        nine entries in the FILE's order (frontmatter note), each an
        image + title/index + description + VIEW CASE STUDY button.
        display:none above the seam (work.css); the desktop carousel
        and its whole driver never see it. Buttons follow the site's
        live-vs-placeholder link rule; images link too (the /work
        tile behaviour). Entrances: per-entry once-only reveals
        (work-page.js mobile branch). */}
    <div class="work-m" data-work-m>
      {MOBILE_ENTRIES.map((p) => {
        const live = LIVE_CASE_SLUGS.includes(p.slug);
        const lastLine = p.title.length - 1;
        return (
          <article class="work-m__entry" data-work-m-entry data-tags={p.tags.join(' ')}>
            {live ? (
              <a class="work-m__imglink" href={`/work/${p.slug}`} data-work-link data-live="true">
                <figure class="work-m__img">
                  <img src={p.workImg} alt="" loading="lazy" decoding="async" width="1024" height="616" />
                </figure>
              </a>
            ) : (
              <figure class="work-m__img">
                <img src={p.workImg} alt="" loading="lazy" decoding="async" width="1024" height="616" />
              </figure>
            )}
            <h2 class="work-m__title">
              {p.title.map((line, i) => (
                <span class="work-m__titleline">
                  {line}
                  {i === lastLine && <span class="work-m__index">{p.index}</span>}
                </span>
              ))}
            </h2>
            <p class="work-m__desc">{p.desc}</p>
            {live ? (
              <a class="work-m__btn" href={`/work/${p.slug}`} data-char-ripple-trigger>
                <span data-char-ripple>VIEW CASE STUDY</span>
                <img src={moreArrow} alt="" width="9" height="9" data-char-ripple-arrow />
              </a>
            ) : (
              <span class="work-m__btn is-placeholder" data-hover data-char-ripple-trigger>
                <span data-char-ripple>VIEW CASE STUDY</span>
                <img src={moreArrow} alt="" width="9" height="9" data-char-ripple-arrow />
              </span>
            )}
          </article>
        );
      })}
    </div>

    {/* Left column — header + the active meta (below). The FILTER
        PILLS are REMOVED from the desktop page (Oscar, 2026-08-26 —
        frame 35:1524 has none); the MOBILE chip row, which shared
        these nodes, is now built by work-page.js's mobile branch at
        init (same markup shape, same position — the desktop DOM
        carries no filter markup at all). */}
    <div class="work-stage__left">
      <h1 class="work-page__hl work-page__hl--featured" data-work-hl-featured>FEATURED</h1>
      <p class="work-page__hl work-page__hl--work" data-work-hl-work aria-hidden="true">WORK</p>
    </div>

    {/* TRAVEL-AND-DOCK metas (Oscar's rev): one unit per project,
        riding its image's vertical position in the left column and
        pinning at the dock (441 — the old meta position) while its
        project traverses; the successor pushes it up and out
        through the layer's clip line (the iOS-sticky-header
        mechanic). Layer z1 — UNDER the blur band (z2) like the
        images, so text enters through the blur; brand-black ink,
        no blends inside. Initial transforms = pos 0 (KEEP the 441/
        624 literals in step with work-page.js BASE_TOP/PITCH).
        Docking is announced via the live region below. */}
    <div class="work-page__metas" data-work-metas aria-label="Project details">
      {WORK_PROJECTS.map((p, i) => (
        <div
          class="work-meta-unit"
          data-work-meta-unit
          data-slug={p.slug}
          style={`transform: translate3d(0, ${441 + i * 624}px, 0)`}
        >
          {/* (The /0N index is retired on this page — frame 35:1524
              has no numbering. The data field stays: the landing
              carousel, the cs-more cards and the mobile list below
              still render it.) */}
          <h2 class="work-page__meta-title">{p.title.join(' ')}</h2>
          <p class="work-page__meta-desc">{p.desc}</p>
        </div>
      ))}
    </div>
    <p class="work-sr-live" data-work-meta-live aria-live="polite"></p>

  </main>

  {/* ══ THE VIEW TOGGLE (R35) — LIST / GRID, right-aligned at the 24
      margin in the FEATURED WORK header row (where VIEW ALL sits on
      the landing). Two 38px chips from the MORE INFO family, 24px line
      glyphs drawn here (originals: three bars / four squares) on the
      site's arrow stroke weight; the ACTIVE chip's glyph is the brand
      red stroke on the resting fill. One element serves both views:
      absolute in the document, so it sits in the list's fixed stage
      row and scrolls with the grid's header. In DOM order it sits
      BEFORE the grid so the keyboard path runs header → toggle →
      tiles in reading order → footer. Hidden ≤1024. */}
  <div class="work-viewtoggle" data-work-viewtoggle role="group" aria-label="Featured work view">
    <button type="button" class="work-viewtoggle__btn is-active" data-work-view="list" aria-pressed="true" aria-label="List view">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <button type="button" class="work-viewtoggle__btn" data-work-view="grid" aria-pressed="false" aria-label="Grid view">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 4h6.5v6.5H4zM13.5 4H20v6.5h-6.5zM4 13.5h6.5V20H4zM13.5 13.5H20V20h-6.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" /></svg>
    </button>
  </div>
  <p class="work-sr-live" data-work-view-live aria-live="polite"></p>

  {/* ══ GRID VIEW (R35) — a normal scrolling document, shown when the
      body carries .work-view-grid (work-view.js). Its header is the
      list header's markup and treatment (the hl classes) so the two
      views share one heading position; only one view is displayed at a
      time, so the page never exposes two h1s. Tiles: live slugs are
      real links through the wipe with the VIEW CASE STUDY cursor;
      unbuilt studies use the established .is-placeholder gating (no
      href, no cursor hit-test, unfocusable). The name beneath each
      tile is the landing carousel's 26/28 card tier; the /0N index is
      omitted here (flagged). Hidden ≤1024 — mobile keeps its list. */}
  <section class="work-grid" data-work-grid aria-label="Featured work, grid view">
    <div class="work-grid__head">
      <h1 class="work-page__hl work-page__hl--featured" data-work-grid-hl-featured>FEATURED</h1>
      <p class="work-page__hl work-page__hl--work" data-work-grid-hl-work aria-hidden="true">WORK</p>
    </div>
    <div class="work-grid__rows" data-work-grid-rows>
      {gridRows.map((row, r) => (
        <div class="work-grid__row" data-work-grid-row data-row={String(r)}>
          {row.map(({ p, mod }, t) => {
            const live = LIVE_CASE_SLUGS.includes(p.slug);
            const name = p.title.join(' ');
            const cls = `work-gtile work-gtile--${mod}`;
            return live ? (
              <a class={cls} href={`/work/${p.slug}`} data-work-link data-work-gtile data-slug={p.slug} data-tile={String(t)} aria-label={`${name} — view project`}>
                <figure class="work-gtile__media"><img src={p.workImg} alt="" loading={r === 0 ? 'eager' : 'lazy'} decoding="async" /></figure>
                <p class="work-gtile__name">{name}</p>
              </a>
            ) : (
              <span class={`${cls} is-placeholder`} data-work-gtile data-slug={p.slug} data-tile={String(t)} data-a4-note="unbuilt study: inert placeholder — no href, no data-work-link (no cursor), unfocusable">
                <figure class="work-gtile__media"><img src={p.workImg} alt="" loading={r === 0 ? 'eager' : 'lazy'} decoding="async" /></figure>
                <p class="work-gtile__name">{name}</p>
              </span>
            );
          })}
        </div>
      ))}
    </div>
  </section>


  {/* Footer — the landing footer, revealed from BEHIND the stage at
      the end of the travel (the landing parallax uncover; the stage
      slides up over this fixed layer — work-page.js phase 2). In grid
      view (R35) the wrap is static and the footer follows the flow. */}
  <div class="work-footer-wrap" data-work-footer>
    <LandingFooter theme="light" />
  </div>

  {/* Custom cursor — hover:hover + pointer:fine only (work-page.js
      gates it; touch taps the link directly). The case-study
      GALLERY-CURSOR construction (Oscar's rev — was the big dot +
      label pair): ONE fixed element carrying difference ITSELF
      (fixed always makes a stacking context, so the blend must ride
      the context-creating element), left/top follow, centring
      margins measured in JS. Outside the stage: the stage
      transforms during the footer reveal, which would re-root fixed
      descendants. aria-hidden: decoration, the tiles are the real
      affordance. */}
  <div class="work-cursor" data-work-cursor aria-hidden="true">( VIEW CASE STUDY + )</div>
</SiteShell>

<script>
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initWorkView } from '../scripts/landing/work-view.js';

  let cleanupCharRipple = initCharRipple();
  let cleanupNavEntrance = initNavEntrance();
  /* R35: the view controller boots the list driver (default) or the
     grid, and owns the switch — a full teardown and boot each way. */
  let cleanupWorkPage = initWorkView();

  document.addEventListener('astro:before-swap', () => {
    cleanupCharRipple();
    cleanupNavEntrance();
    cleanupWorkPage();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCharRipple = initCharRipple();
    cleanupNavEntrance = initNavEntrance();
    cleanupWorkPage = initWorkView();
  });
</script>
