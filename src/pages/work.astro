---
/**
 * /work — FEATURED WORK, the new build's second route (Figma
 * 27:3103, extracted 2026-08-06; 83px chrome offset subtracted; the
 * file's y107 nav ignored — the shared shell's nav position wins).
 *
 * Fixed-viewport page: left column static (FEATURED/WORK header,
 * the active project's brand-black meta — filters retired
 * 2026-08-26, frame 35:1524), right
 * carousel of 1024×640 images travelling vertically on wheel/touch
 * through the holding pages' proven single-velocity drift driver
 * (autoDrift 0 — scroll-driven only, the /holding-2 precedent).
 * FINITE travel (Oscar's rev — was an infinite loop): starts with
 * the first image top on the meta title's top line, nothing above;
 * ends after the last project, then the landing FOOTER reveals from
 * behind (the parallax uncover). All machinery in work-page.js.
 *
 * Content: WORK_PROJECTS in src/data/landing/featured-work.js — the
 * landing section's eight projects IN ITS ORDER with its copy
 * (Oscar's rev; images placeholder pending his drop). RIGHTS:
 * elevated third-party-IP / named-person flags live with the data.
 *
 * Tiles are REAL LINKS to /work/[slug] — routes that don't exist
 * yet, so navigation is prevented in JS (placeholders, commented
 * there). Keyboard: tiles tabbable; focusing a tile retargets the
 * travel to bring it to the anchor.
 *
 * STAGING ONLY — same rule as /landing: nothing here is promoted
 * anywhere until Oscar says so.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { WORK_PROJECTS, WORK_EXTRAS, WORK_GRID_HOVER } from '../data/landing/featured-work.js';
import { LIVE_CASE_SLUGS } from '../data/landing/case-studies.js';
import { asset } from '../utils/asset.js';
import { imageSrcset, gateSrcset, gateSizes, GATE_GIF } from '../utils/thumb-srcset.js';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/landing/work.css';
/* THE REBUILD (2026-09-07): /work below the seam — the grid as the
   default view and the row view's vertical list, the header and the
   toggle in flow, type from the tokens only. Imported after work.css. */
import '../styles/landing/work-narrow.css';
import '../styles/fonts.css';

const workPool = [...WORK_PROJECTS, ...WORK_EXTRAS];
/* THE REBUILD (2026-09-07): the grid renders at every width — the phone's
   full-width and half-width tiles and the tablet's quarter take the 680
   and 1200 variants; the desktop's sizes branch keeps the full file. */
/* THE FINAL GATE (2026-09-08): the phone's grid tile renders 167px and the row 342px; both
   branches resolve a 3× phone to the 680 candidate (the density cap) so the two views —
   both in the DOM, both fetched — share one file per project instead of two. */
/* THE 402 FRAME (2026-09-09): below 768 the desktop's rows are display:none
   behind the phone's own composition (below) — "1px" there selects the 8w
   GIF, so the phone fetches none of these. The tablet and the desktop pick
   exactly what they did. */
const GRID_SIZES = '(max-width: 767px) 1px, (max-width: 1359px) 50vw, 1728px';
const gridSrcset = (src) => `${GATE_GIF} 8w, ${imageSrcset(src, [680, 1200], 2000)}`;
/* ── GRID VIEW (R35, Oscar 2026-09-03) — COMPOSITION A, nine tiles from
   the single source (the eight projects + the Ashley portrait stub,
   the pool's only true 3:4 source). A 12-column grid inside the 24px
   margins (1680 → column 118 on 24px gutters, work.css); modules:
   l6 = 6-col landscape 828×552 (3:2), l3 = 3-col landscape 402×268,
   sq3 = 3-col square 402×402, p3 = 3-col portrait 402×536 (3:4).
   The rows copy the reference's first two row compositions module
   for module and put its World Buskers module on the RIGHT of row 3
   with one small tile left and the middle open; counts 3 / 4 / 2
   never repeat, no adjacent pair shares a size, every row mixes
   three heights. The TV/film work (Adolescence, Animol, Top Boy) are
   the landscapes — their elevated rights flags (data header) stand,
   and they are prominent tiles now. Top Boy takes the template's
   small landscape (Oscar's ruling on option A). */
const GRID_ROWS = [
  [['animol', 'l6'], ['wilderness-reserve', 'sq3'], ['tbc-ashley-walters', 'p3']],
  [['top-boy', 'l3'], ['pavilion-club', 'p3'], ['yoxman-food-festival', 'sq3'], ['pavilion-summit', 'p3']],
  [['thunder-aviation', 'sq3'], ['adolescence', 'l6r']],
];
const gridRows = GRID_ROWS.map((row) =>
  row.map(([slug, mod]) => ({ p: workPool.find((x) => x.slug === slug), mod })).filter((t) => t.p !== undefined),
);

/* ═══ THE 402 FRAME (V9fcTtbistM57vsObNruR6, 2026-09-09) — the PHONE's two
   views, rendered beside the desktop's (each hidden at the other's width;
   work-narrow.css). Page y = frame y − 49.

   GRID (0:12): NINE tiles in SEVEN rows, 48 between rows (a row's lowest
   name bottom → the next row's image top), names 18 tall 16 under their
   image; the first row at page y180. Modules at 402 (fluid on the 370
   measure): sq 181×181 · pt 181×260 · wide 370×254 · land 276×181. Paired
   rows on the 8 gutter; row 3's portrait is CENTRED (x110 = (402−181)/2);
   row 7's landscape is right-aligned (x110..386). The projects are the
   frame's image nodes (0:17 … 0:72), read against the rows frame where the
   same file is named: row 5's right tile is the Netflix key art the rows
   frame calls ADOLESCENCE — the grid labels it "Pavilion" (a slip, not
   reproduced). The frame's "Pavilion" / "Music & Culture" labels are the
   shared data's "Pavilion Club" / "Music and Culture" (the data wins, as
   WE BUILD's colon). Adidas is the pool's adidas Spezial stub, named by
   the frame (featured-work.js) — an inert placeholder like every unbuilt
   study. Thunder Aviation (the desktop grid's ninth) is not drawn.

   ROWS (0:124): EIGHT full-width tiles 370×254 on a 336 pitch (254 + 16 +
   18 + 48) from page y180, the same name role and link rules. The frame
   omits Pavilion Summit here (nine vs eight — FLAGGED); its second tile
   carries the Pavilion image under a repeated "Wilderness Reserve" label
   (a slip — the image names the project). Built per the frame. */
const GRID_ROWS_M = [
  [['pavilion-club', 'sq'], ['pavilion-summit', 'pt']],
  [['wilderness-reserve', 'wide']],
  [['tbc-ashley-walters', 'pt']],
  [['top-boy', 'wide']],
  [['tbc-adidas-spezial', 'pt'], ['adolescence', 'sq']],
  [['yoxman-food-festival', 'wide']],
  [['animol', 'land']],
];
const gridRowsM = GRID_ROWS_M.map((row) =>
  row.map(([slug, mod]) => ({ p: workPool.find((x) => x.slug === slug), mod })).filter((t) => t.p !== undefined),
);
const rowModM = (row) => (row.length === 2 ? 'pair' : row[0].mod === 'wide' ? 'full' : row[0].mod === 'land' ? 'right' : 'centre');
const ROWS_M = ['wilderness-reserve', 'pavilion-club', 'yoxman-food-festival', 'tbc-ashley-walters', 'adolescence', 'top-boy', 'animol', 'tbc-adidas-spezial'];
const rowsM = ROWS_M.map((slug) => workPool.find((x) => x.slug === slug)).filter((p) => p !== undefined);
/* The phone's tiles pick their file by the drawn width at 3× (the density
   cap resolves to the 680 / 1200 variants); above the seam they are
   display:none and the srcset's 8w GIF is what "1px" selects, so the
   desktop fetches nothing for them — the hero-card gate, inverted. */
/* THE GATE (2026-09-09): both views are in the DOM and Chrome fetches the
   hidden one's images too (lazy or not), so every module declares the
   FULL measure — the half and three-quarter tiles then resolve the same
   1200 candidate the rows view needs, one file per project instead of a
   680 for the grid tile and a 1200 for its row (measured: five duplicate
   fetches, ~270 kB, at 390 on 4G). The 1200 is downsampled into the 181
   tile; the 8w GIF still gates the seam. */
const M_SIZES = { sq: '(max-width: 767px) calc(100vw - 32px), 1px', pt: '(max-width: 767px) calc(100vw - 32px), 1px', wide: '(max-width: 767px) calc(100vw - 32px), 1px', land: '(max-width: 767px) calc(100vw - 32px), 1px' };
const mSrcset = (src) => `${GATE_GIF} 8w, ${imageSrcset(src, [680, 780, 1200], 2000)}`; /* 780: the featured set's 2× tile (no 1200 exists for those 960–1100w sources) */

---

<SiteShell
  title="Featured Work — The Network Effect"
  description="Selected work: festivals, members’ clubs, leadership summits and hospitality brands, built from concept through to delivery."
  canonicalPath="/work"
  bodyClass="landing-v2 work-page"
>
  <main class="work-stage" data-work-stage aria-label="Featured work" id="main" tabindex="-1">
    {/* Carousel — the full nine-project set (work-page.js rebuilds
        the same markup shape at init; the filter machinery is
        retired, 2026-08-26). */}
    <div class="work-stage__carousel" data-work-carousel>
      {WORK_PROJECTS.map((p, i) => (
        LIVE_CASE_SLUGS.includes(p.slug) ? (
        <a
          class="work-tile"
          href={`/work/${p.slug}`}
          data-work-link
          data-slug={p.slug}
          data-index={String(i)}
          data-tags={p.tags.join(' ')}
          aria-label={`${p.title.join(' ')} — view project`}
        >
          <img
            src={p.workImg}
            srcset={gateSrcset(p.workImg, 2000)}
            sizes={gateSizes(2000)}
            alt=""
            loading={i < 3 ? 'eager' : 'lazy'}
            decoding="async"
            width="1024"
            height="616"
          />
          {/* (The 2026-08-10 per-tile mobile meta is retired — the
              402-frame rebuild renders its own mobile list below;
              this carousel is display:none under the seam.) */}
        </a>
        ) : (
        <span
          class="work-tile is-placeholder"
          data-a4-note="unbuilt study: inert placeholder — no href, no data-work-link (no cursor), unfocusable"
          data-slug={p.slug}
          data-index={String(i)}
          data-tags={p.tags.join(' ')}
        >
          <img
            src={p.workImg}
            srcset={gateSrcset(p.workImg, 2000)}
            sizes={gateSizes(2000)}
            alt=""
            loading={i < 3 ? 'eager' : 'lazy'}
            decoding="async"
            width="1024"
            height="616"
          />
        </span>
        )
      ))}
    </div>

    {/* ── THE ROW VIEW'S LIST (the rebuild, 2026-09-07): below the seam the
        desktop's ROW view — the pinned horizontal carousel with its
        docking metas, a fixed-viewport driver — becomes a vertical list
        of the same nine projects in the same order, each its image (the
        link, for live studies), its name and its description: the
        carousel's own content, one source. No filter pills (the desktop
        has none) and no per-entry chip: the tile is the tap target, as
        on the landing's rail (the VIEW CASE STUDY cursor has no touch
        form). display:none above the seam. */}
    <div class="work-m" data-work-m>
      {WORK_PROJECTS.map((p) => {
        const live = LIVE_CASE_SLUGS.includes(p.slug);
        const name = p.title.join(' ');
        return (
          <article class="work-m__entry" data-work-m-entry data-slug={p.slug}>
            {live ? (
              <a class="work-m__imglink" href={`/work/${p.slug}`} data-work-link data-live="true" aria-label={`${name} — view project`}>
                <figure class="work-m__img">
                  <img src={p.workImg} srcset={imageSrcset(p.workImg, [680, 1200], 2000)} sizes="(max-width: 767px) 220px, (max-width: 1359px) 100vw, 1px" alt="" loading="lazy" decoding="async" width="1024" height="616" />
                </figure>
              </a>
            ) : (
              <figure class="work-m__img">
                <img src={p.workImg} srcset={imageSrcset(p.workImg, [680, 1200], 2000)} sizes="(max-width: 767px) 220px, (max-width: 1359px) 100vw, 1px" alt="" loading="lazy" decoding="async" width="1024" height="616" />
              </figure>
            )}
            <h2 class="work-m__title">{name}</h2>
            <p class="work-m__desc">{p.desc}</p>
          </article>
        );
      })}
    </div>
    {/* ── THE PHONE'S ROWS (0:124) — eight 370×254 tiles on the 336 pitch,
        the name 16 under each (the frame's title role), no descriptions;
        display:none from 768 up (the band keeps its two-up list above,
        itself display:none below 768). The entries carry the list's
        data-work-m-entry so work-page.js's narrow branch wires the SAME
        entrance — the name's word reveal and the image's fade-rise as
        each enters (m-entrance.js). */}
    <div class="work-r" data-work-r>
      {rowsM.map((p, i) => {
        const live = LIVE_CASE_SLUGS.includes(p.slug);
        const name = p.title.join(' ');
        const img = <img src={p.workImg} srcset={mSrcset(p.workImg)} sizes={M_SIZES.wide} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />;
        return (
          <article class="work-r__entry" data-work-m-entry data-slug={p.slug}>
            {live ? (
              <a class="work-r__imglink" href={`/work/${p.slug}`} data-work-link data-live="true" aria-label={`${name} — view project`}>
                <figure class="work-r__img work-m__img">{img}</figure>
              </a>
            ) : (
              <figure class="work-r__img work-m__img is-placeholder" data-a4-note="unbuilt study: inert placeholder — no link">{img}</figure>
            )}
            <h2 class="work-r__title work-m__title">{name}</h2>
          </article>
        );
      })}
    </div>
    {/* Left column — header + the active meta (below). The FILTER
        PILLS are REMOVED from the desktop page (Oscar, 2026-08-26 —
        frame 35:1524 has none); the MOBILE chip row, which shared
        these nodes, is now built by work-page.js's mobile branch at
        init (same markup shape, same position — the desktop DOM
        carries no filter markup at all). */}
    <div class="work-stage__left">
      <h1 class="work-page__hl work-page__hl--featured" data-work-hl-featured>FEATURED</h1>
      <p class="work-page__hl work-page__hl--work" data-work-hl-work aria-hidden="true">WORK</p>
    </div>

    {/* TRAVEL-AND-DOCK metas (Oscar's rev): one unit per project,
        riding its image's vertical position in the left column and
        pinning at the dock (441 — the old meta position) while its
        project traverses; the successor pushes it up and out
        through the layer's clip line (the iOS-sticky-header
        mechanic). Layer z1 — UNDER the blur band (z2) like the
        images, so text enters through the blur; brand-black ink,
        no blends inside. Initial transforms = pos 0 (KEEP the 441/
        624 literals in step with work-page.js BASE_TOP/PITCH).
        Docking is announced via the live region below. */}
    <div class="work-page__metas" data-work-metas aria-label="Project details">
      {WORK_PROJECTS.map((p, i) => (
        <div
          class="work-meta-unit"
          data-work-meta-unit
          data-slug={p.slug}
          style={`transform: translate3d(0, ${441 + i * 624}px, 0)`}
        >
          {/* (The /0N index is retired on this page — frame 35:1524
              has no numbering. The data field stays: the landing
              carousel, the cs-more cards and the mobile list below
              still render it.) */}
          <h2 class="work-page__meta-title">{p.title.join(' ')}</h2>
          <p class="work-page__meta-desc">{p.desc}</p>
        </div>
      ))}
    </div>
    <p class="work-sr-live" data-work-meta-live aria-live="polite"></p>

  </main>

  {/* ══ THE VIEW TOGGLE (R35) — LIST / GRID, right-aligned at the 24
      margin in the FEATURED WORK header row (where VIEW ALL sits on
      the landing). Two 38px chips from the MORE INFO family, 24px line
      glyphs drawn here (originals: three bars / four squares) on the
      site's arrow stroke weight; the ACTIVE chip's glyph is the brand
      red stroke on the resting fill. One element serves both views:
      absolute in the document, so it sits in the list's fixed stage
      row and scrolls with the grid's header. In DOM order it sits
      BEFORE the grid so the keyboard path runs header → toggle →
      tiles in reading order → footer. Hidden ≤1024. */}
  {/* R38 item 1 (Oscar, 2026-09-04; Figma 404lXHunYm2c107Kq97pv6 frame
      0:91, group 0:202): two 38px More Info-family chips 12 apart, each a
      16×12 icon LEFT of its label (icon at x16, label at x38: 16 pad + 16
      icon + 6 gap, 16 right pad; group 203 wide = 95 + 12 + 96). Labels
      per the frame: GRID and ROW. The ACTIVE view's chip is the frame's
      filled #232A89 with white ink and icon; the inactive chip rests on
      the family's #E4E4EA with accent ink (the frame draws ROW active on
      its single-column content). Icons are the frame's vector geometry
      (0:208 / 0:216) on a 16×12 box, currentColor so they ride the ink.
      Position (work-view.js placeToggle): the group's RIGHT edge on the
      K's INK in WORK and its top 32 below the title's bottom INK — both
      measured from the rendered glyphs, not the boxes. */}
  <div class="work-viewtoggle" data-work-viewtoggle role="group" aria-label="Featured work view">
    <button type="button" class="work-viewtoggle__btn is-active" data-work-view="grid" aria-pressed="true" aria-label="Grid view">
      <svg class="work-viewtoggle__icon" viewBox="0 0 16 12" width="16" height="12" aria-hidden="true"><rect x="0" y="0" width="10" height="2" /><rect x="13" y="0" width="3" height="2" /><rect x="6" y="5" width="10" height="2" /><rect x="0" y="9" width="2" height="3" /><rect x="5" y="10" width="11" height="2" /></svg>
      <span class="work-viewtoggle__label">GRID</span>
    </button>
    <button type="button" class="work-viewtoggle__btn" data-work-view="list" aria-pressed="false" aria-label="List view">
      <svg class="work-viewtoggle__icon" viewBox="0 0 16 12" width="16" height="12" aria-hidden="true"><rect x="0" y="0" width="16" height="2" /><rect x="0" y="5" width="16" height="2" /><rect x="0" y="10" width="16" height="2" /></svg>
      <span class="work-viewtoggle__label">ROW</span>
    </button>
  </div>
  <p class="work-sr-live" data-work-view-live aria-live="polite"></p>

  {/* ══ THE SHARED HEADER (R39 item 3, Oscar 2026-09-04): FEATURED WORK
      rendered ONCE for both desktop views, outside the crossfading
      roots (the stage, the grid) — a sibling like the toggle, absolute
      in the document at the header's coordinates (the hl classes), so
      a view switch never touches it: it stays static and continuous
      while only the content below crossfades. Revealed once at page
      boot (work-view.js). Hidden ≤1024: the mobile page keeps the
      stage's own header in flow, byte-identical. */}
  <div class="work-header" data-work-header>
    <h1 class="work-page__hl work-page__hl--featured" data-work-header-featured>FEATURED</h1>
    <p class="work-page__hl work-page__hl--work" data-work-header-work aria-hidden="true">WORK</p>
  </div>

  {/* ══ GRID VIEW (R35) — a normal scrolling document, shown when the
      body carries .work-view-grid (work-view.js). Its header is the
      list header's markup and treatment (the hl classes) so the two
      views share one heading position; only one view is displayed at a
      time, so the page never exposes two h1s. Tiles: live slugs are
      real links through the wipe with the VIEW CASE STUDY cursor;
      unbuilt studies use the established .is-placeholder gating (no
      href, no cursor hit-test, unfocusable). The name beneath each
      tile is the landing carousel's 26/28 card tier; the /0N index is
      omitted here (flagged). Hidden ≤1024 — mobile keeps its list. */}
  <section class="work-grid" data-work-grid aria-label="Featured work, grid view">
    {/* R39 item 3: the head is a spacer now — the title lives in the
        shared header above (outside this crossfading root). */}
    <div class="work-grid__head" aria-hidden="true"></div>
    <div class="work-grid__rows" data-work-grid-rows>
      {gridRows.map((row, r) => (
        <div class="work-grid__row" data-work-grid-row data-row={String(r)}>
          {row.map(({ p, mod }, t) => {
            const live = LIVE_CASE_SLUGS.includes(p.slug);
            const name = p.title.join(' ');
            const cls = `work-gtile work-gtile--${mod}`;
            return live ? (
              <a class={cls} href={`/work/${p.slug}`} data-work-link data-work-gtile data-slug={p.slug} data-tile={String(t)} data-hover-img={asset(WORK_GRID_HOVER[p.slug] ?? p.workImg)} aria-label={`${name} — view project`}>
                {/* R38 item 5: the base image + the cover-swap overlay (hidden
                    at rest; the hover wipes the second image in over it —
                    work-grid.js). R38 item 6 / R41: the row reveal is the
                    image's own blur — the red veil is removed. */}
                <figure class="work-gtile__media"><img data-gtile-base src={p.workImg} srcset={gridSrcset(p.workImg)} sizes={GRID_SIZES} alt="" loading={r === 0 ? 'eager' : 'lazy'} decoding="async" /><img data-gtile-over src={p.workImg} srcset={gridSrcset(p.workImg)} sizes={GRID_SIZES} alt="" hidden decoding="async" /></figure>
                <p class="work-gtile__name">{name}</p>
              </a>
            ) : (
              <span class={`${cls} is-placeholder`} data-work-gtile data-slug={p.slug} data-tile={String(t)} data-hover-img={asset(WORK_GRID_HOVER[p.slug] ?? p.workImg)} data-a4-note="unbuilt study: inert placeholder — no href, no data-work-link (no cursor), unfocusable">
                <figure class="work-gtile__media"><img data-gtile-base src={p.workImg} srcset={gridSrcset(p.workImg)} sizes={GRID_SIZES} alt="" loading={r === 0 ? 'eager' : 'lazy'} decoding="async" /><img data-gtile-over src={p.workImg} srcset={gridSrcset(p.workImg)} sizes={GRID_SIZES} alt="" hidden decoding="async" /></figure>
                <p class="work-gtile__name">{name}</p>
              </span>
            );
          })}
        </div>
      ))}
      {/* ── THE PHONE'S GRID (0:12) — display:none from 768 up; the desktop's
          rows above are display:none below it. Same tile grammar
          (data-work-gtile, the media figure, the name), so work-grid.js's
          row reveal — the image's blur resolving as a quarter of the row's
          tallest tile enters, reversible — drives these rows exactly as it
          drives the desktop's. No hover swap (touch). */}
      {gridRowsM.map((row, r) => (
        <div class={`work-grid__row work-grid__row--m work-grid__row--m-${rowModM(row)}`} data-work-grid-row data-work-grid-row-m data-row={String(r)}>
          {row.map(({ p, mod }, t) => {
            const live = LIVE_CASE_SLUGS.includes(p.slug);
            const name = p.title.join(' ');
            const cls = `work-gtile work-gtile--m work-gtile--m-${mod}`;
            const eager = r === 0;
            return live ? (
              <a class={cls} href={`/work/${p.slug}`} data-work-link data-work-gtile data-slug={p.slug} data-tile={String(t)} aria-label={`${name} — view project`}>
                <figure class="work-gtile__media"><img data-gtile-base src={p.workImg} srcset={mSrcset(p.workImg)} sizes={M_SIZES[mod]} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" /></figure>
                <p class="work-gtile__name">{name}</p>
              </a>
            ) : (
              <span class={`${cls} is-placeholder`} data-work-gtile data-slug={p.slug} data-tile={String(t)} data-a4-note="unbuilt study: inert placeholder — no href, no data-work-link (no cursor), unfocusable">
                <figure class="work-gtile__media"><img data-gtile-base src={p.workImg} srcset={mSrcset(p.workImg)} sizes={M_SIZES[mod]} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" /></figure>
                <p class="work-gtile__name">{name}</p>
              </span>
            );
          })}
        </div>
      ))}
    </div>
  </section>


  {/* Footer — the landing footer, revealed from BEHIND the stage at
      the end of the travel (the landing parallax uncover; the stage
      slides up over this fixed layer — work-page.js phase 2). In grid
      view (R35) the wrap is static and the footer follows the flow. */}
  <div class="work-footer-wrap" data-work-footer>
    <LandingFooter theme="light" />
  </div>
  {/* R38 item 7: the grid view's reveal spacer (display:none in list view). */}
  <div class="work-footer-spacer" data-work-footer-spacer aria-hidden="true"></div>

  {/* Custom cursor — hover:hover + pointer:fine only (work-page.js
      gates it; touch taps the link directly). The case-study
      GALLERY-CURSOR construction (Oscar's rev — was the big dot +
      label pair): ONE fixed element carrying difference ITSELF
      (fixed always makes a stacking context, so the blend must ride
      the context-creating element), left/top follow, centring
      margins measured in JS. Outside the stage: the stage
      transforms during the footer reveal, which would re-root fixed
      descendants. aria-hidden: decoration, the tiles are the real
      affordance. */}
  <div class="work-cursor" data-work-cursor aria-hidden="true">( VIEW CASE STUDY + )</div>
</SiteShell>

<script>
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initWorkView } from '../scripts/landing/work-view.js';

  let cleanupCharRipple = initCharRipple();
  let cleanupNavEntrance = initNavEntrance();
  /* R35: the view controller boots the list driver (default) or the
     grid, and owns the switch — a full teardown and boot each way. */
  let cleanupWorkPage = initWorkView();

  document.addEventListener('astro:before-swap', () => {
    cleanupCharRipple();
    cleanupNavEntrance();
    cleanupWorkPage();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCharRipple = initCharRipple();
    cleanupNavEntrance = initNavEntrance();
    cleanupWorkPage = initWorkView();
  });
</script>
