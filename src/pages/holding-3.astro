---
/**
 * Holding page, variant FINAL — the approved holding design, rebuilt in
 * place from the STATIC variant per Oscar's spec: on desktop >=1025 the
 * left column is the DECK-REQUEST FORM (Figma SB1V2GBQ0aBsSIdcXPr7dl
 * Group 89 — heading, blended subheading, three labelled fields,
 * Request submit + Contact link; POSTs to /api/deck-request, a Vercel
 * function sending via Resend), with the bottom-anchored two-line
 * sign-off and the 16px #C1250E accent bar flush right, photo column
 * narrowed to touch it. /holding and /holding-2 stay DORMANT (files
 * intact, unlinked — the /about + /about-2 convention).
 *
 * Mobile/tablet <=1024 is DEFERRED: the shared travel mechanic with the
 * rolling-tagline hero renders exactly as before on all three routes
 * (bootHoldingVariant — this route passes NO desktop factory). The old
 * column elements therefore stay in the shell's DOM, breakpoint-gated.
 *
 * Body classes: .holding-static (photo shift + column centering),
 * .holding-final (the new design), .holding-spin (CTA text-link styles
 * by class reuse — that block is >=1025-gated, so mobile is untouched).
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
import HoldingPage from '../components/holding/HoldingPage.astro';
import { holdingStaticPhoto } from '../data/holding/images.js';
---

<HoldingLayout
  title="The Network Effect"
  bodyClass="holding-page holding-shell holding-static holding-final holding-spin"
>
  <HoldingPage final>
    <!-- PENDING SIGN-OFF: placeholder photo (the original build's). -->
    <img
      class="holding-static__photo"
      slot="gallery"
      src={holdingStaticPhoto}
      alt=""
      decoding="async"
    />
  </HoldingPage>
</HoldingLayout>

<script>
  import { bootHoldingVariant } from '../scripts/holding/holding-shared.js';
  import { initHoldingDeckForm } from '../scripts/holding/holding-deck-form.js';

  bootHoldingVariant({ createDesktopGallery: null, devHandle: '__holdingGallery3' });
  initHoldingDeckForm();
</script>
