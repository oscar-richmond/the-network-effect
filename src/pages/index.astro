---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutScroll from '../components/about-3/AboutScroll.astro';
import SectionProgress from '../components/about-3/SectionProgress.astro';
import Menu from '../components/Menu.astro';
import SplashScreen from '../components/SplashScreen.astro';
import '../styles/home.css';
import '../styles/about-3/about-page.css';
import '../styles/fonts.css';
---

<!-- THE LANDING PAGE (root-landing move): this is the former /about-3
     page verbatim — body class, modules, and all scoping unchanged —
     now served at "/", opening with the site splash (formerly the old
     home's; the old home page is hidden at _index.astro, files intact).
     The splash sits ABOVE the page chrome on this page (scoped z rule
     in splash-screen.css) and the page script fades the white veil out
     in parallel with the image dissolve, revealing the hero intro
     already playing beneath (page-transition.js defers the cover-reveal
     signal to splash:complete when a splash is present). -->
<BaseLayout title="The Network Effect" bodyClass="about-page-3 loading" htmlClass="js">
  <SplashScreen />
  <div data-splash-gate>
    <header class="home__topbar home__topbar--about">
      <nav class="home__menu-cta" aria-label="Site">
        <button
          type="button"
          class="home__menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <span data-menu-label-menu>menu</span>
          <span class="home__menu-toggle-label--close" data-menu-label-close aria-hidden="true">
            <span class="home__menu-toggle-close-text">close</span>
            <span class="home__menu-toggle-x" data-menu-toggle-x aria-hidden="true">×</span>
          </span>
        </button>
      </nav>
      <h1 class="home__logo">THE NETWORK EFFECT</h1>
      <a class="home__topbar-email" href="mailto:hello@thenetworkeffect.com">
        hello@thenetworkeffect.com
      </a>
    </header>

    <AboutScroll />
    <SectionProgress />
    <Menu />

    <!-- Film-grain overlay — a childless, pointer-events:none SIBLING at
         the very top of the paint order (z 9000: above every stage/nav/
         loader, below only the canvas cursor at 9999 so the cursor stays
         crisp). It wraps nothing and blends nothing — see the stacking/
         blend-safety notes on .about-grain in about-page.css. -->
    <div class="about-grain" aria-hidden="true"></div>
  </div>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { initSplashScreen, completeSplash } from '../scripts/splash-screen.js';
  import { splashImage } from '../data/splash.js';

  /** Veil fade — runs in parallel with the splash image's own WebGL
   * dissolve (splash-screen.js DISSOLVE_DURATION = 1s, same clock): the
   * splash's opaque white root fades out revealing the hero intro
   * already booting beneath (page-transition.js fires the cover-reveal
   * signal at splash:complete). The old home never needed this — its
   * ground was white-on-white, so the opaque veil was invisible there. */
  const SPLASH_VEIL_FADE_S = 1;

  document.documentElement.classList.add('splash-active');

  const splash = document.querySelector('[data-splash]');
  const gate = document.querySelector('[data-splash-gate]');

  const revealLanding = () => {
    completeSplash(() => {
      document.dispatchEvent(new CustomEvent('splash:complete'));
    });
    if (splash instanceof HTMLElement) {
      gsap.to(splash, { opacity: 0, duration: SPLASH_VEIL_FADE_S, ease: 'power2.out' });
    }
  };

  if (splash) {
    gate?.setAttribute('inert', '');
    initSplashScreen(splash, {
      ...splashImage,
      onComplete: revealLanding,
      onFinish: () => {
        splash.remove();
        gate?.removeAttribute('inert');
        document.dispatchEvent(new CustomEvent('splash:finished'));
      },
    });
  } else {
    revealLanding();
    gate?.removeAttribute('inert');
    document.dispatchEvent(new CustomEvent('splash:finished'));
  }

  document.addEventListener('astro:before-swap', () => {
    document.documentElement.classList.remove('splash-active');
  });
</script>
