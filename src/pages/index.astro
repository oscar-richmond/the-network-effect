---
/**
 * ROOT — the holding page (Oscar's Option A, rebuild phase).
 *
 * While the full site is rebuilt, anyone visiting the project's
 * .vercel.app root sees the same face as the public launch domain
 * rather than a half-built site. The previous root (the in-progress
 * full-site landing) is archived verbatim at /old; new development
 * happens at /landing on STAGING only.
 *
 * This renders the SAME final holding design as /holding-3 — same
 * layout, same body classes, same boot — because both are thin
 * wrappers over HoldingPage. /holding-3 is deliberately left in place
 * and untouched (it stays the direct link, and it is the path the
 * launch-domain Edge middleware rewrites to); this route is an
 * addition, not a move.
 *
 * canonicalUrl points at the live public domain, as /holding-3 does:
 * the .vercel.app copy is a development surface, not the canonical
 * home of this content.
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
import HoldingPage from '../components/holding/HoldingPage.astro';
import { holdingStaticPhoto } from '../data/holding/images.js';
---

<HoldingLayout
  title="The Network Effect"
  bodyClass="holding-page holding-shell holding-static holding-final holding-spin"
  canonicalUrl="https://networkeffectagency.co.uk/"
>
  <HoldingPage final>
    <!-- PENDING SIGN-OFF: placeholder photo (the original build's). -->
    <img
      class="holding-static__photo"
      slot="gallery"
      src={holdingStaticPhoto}
      alt=""
      decoding="async"
    />
  </HoldingPage>
</HoldingLayout>

<script>
  import { bootHoldingVariant } from '../scripts/holding/holding-shared.js';
  import { initHoldingDeckForm, initHoldingContactCopy } from '../scripts/holding/holding-deck-form.js';

  bootHoldingVariant({ createDesktopGallery: null, devHandle: '__holdingGalleryRoot' });
  initHoldingDeckForm();
  initHoldingContactCopy();
</script>
