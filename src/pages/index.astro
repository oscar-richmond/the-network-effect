---
/**
 * "/" — THE NEW BUILD'S HOME (release restructure, Oscar 2026-08-10).
 * This file is the former landing.astro moved onto the root route;
 * /landing is now a redirect stub to here. The holding face that
 * previously occupied "/" was a thin duplicate of /holding-3, which
 * remains untouched — no archive copy needed.
 *
 * /landing — THE NEW SITE, in development.
 *
 * A fresh page: hero only, nothing beyond it. It shares the visual
 * system with the archived build (ground, grain, top nav, Lenis/GSAP
 * scroll architecture) but not its files — everything here is scoped to
 * the `landing-v2` body class and lives under src/{components,styles,
 * scripts}/landing/. Nothing on this page touches /old, /services or
 * the holding routes.
 *
 * Page chrome (nav / menu overlay / grain) lives in the shared
 * SiteShell (markup only — scripts boot per-page below, so the
 * extraction left this page's build byte-identical).
 *
 * STAGING ONLY. The root serves the holding page; this route is not
 * promoted anywhere until Oscar says so. See docs/ENVIRONMENTS.md.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingSplash from '../components/landing/LandingSplash.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingFounders from '../components/landing/LandingFounders.astro';
import LandingNetwork from '../components/landing/LandingNetwork.astro';
import LandingFeatured from '../components/landing/LandingFeatured.astro';
import LandingServicesStack from '../components/landing/LandingServicesStack.astro';
import LandingAccess from '../components/landing/LandingAccess.astro';
import LandingClosing from '../components/landing/LandingClosing.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import '../styles/home.css';
import '../styles/landing/landing.css';
/* The /services page's stylesheet rides along for the SHARED sv-rows
   hover machinery (all selectors are .landing-v2 .sv-* namespaced —
   nothing else on this page matches them; /services itself is
   untouched). Landing-specific row geometry overrides live in
   landing.css. */
import '../styles/landing/services-v2.css';
import '../styles/fonts.css';
import { asset } from '../utils/asset.js';
import { SERVICES_REEL_PILLARS } from '../data/landing/services-reel.js';
---

{/* landing-home (mobile rebuild, 2026-08-13): scopes the Figma
    402-frame mobile grammar — 16px margins etc. — to THIS page while
    the other pages keep the 24px interim mobile layout until their
    own redesigns land. No desktop rule keys on it. */}
<SiteShell title="The Network Effect" bodyClass="landing-v2 landing-home">
  {/* Entry sequence — first visit only, pre-paint decision inside. */}
  <LandingSplash />

  <LandingHero />

  {/* First content section — slides up over the held full-screen
      video; see the arrival note in landing.css. */}
  <LandingFounders />

  {/* Our Network — REORDERED here (frame 16:113, 2026-08-13): dark
      follows dark straight out of the founders band. The -100dvh
      overlap + transparent-until-pin arrival machinery is untouched
      — it now rides the founders track's exit window instead of the
      featured fade. Internal behaviour (carousels, speeds,
      industry-hover) byte-unchanged. */}
  <LandingNetwork />

  {/* Services — the ROW-LIST redesign (frame 18:1694, 2026-08-24):
      normal flow now — header (WHAT WE DO / FROM ACCESS–TO IMPACT /
      the pillars note) + three pillar row lists riding the /services
      page's own sv-rows hover machinery (shared module). The OLD
      stacked-cards markup below survives UNTOUCHED for MOBILE (the
      shipped build) and hides ≥1025; the new block is desktop-only.
      THE FADE-TO-BLACK lives on this section's tail now (its third
      home — landing-services.js, constants verbatim): services is
      the one light→dark boundary in the current order, and Featured
      Work arrives black-over-black. */}
  <section class="landing-outro" aria-label="Our services" data-landing-services>
    <div class="landing-services__stage" data-services-stage>
      <div class="landing-services__center" data-services-center>
        <h2 class="landing-services__title" data-landing-services-title>
          <span class="landing-services__line" data-landing-services-line1
            ><span class="landing-services__serrif">OUR SERVICES<span data-services-stop>.</span></span> <span data-services-from>FROM</span></span
          >
          <span class="landing-services__line" data-landing-services-line2>ACCESS. TO IMPACT.</span>
        </h2>
      </div>
      <LandingServicesStack />
    </div>

    {/* ══ THE SERVICES REEL (frames 29:859/30:1191, 2026-08-26) —
        desktop only (display:none ≤1024; mobile keeps the stack
        above, untouched). The STAGING (8ec705a) stack mechanics are
        the base — rise, fix, divider-fill progress, roll-over wipes,
        band compaction, opaque-panel occlusion — with the NEW REEL
        between each pillar's fix and the next rise: the services
        list scrolls behind a gradient blur, the active row (level
        with the WE BUILD label) drives the image via the
        case-study gallery wipe. landing-services-reel.js drives it;
        RM keeps this markup as the static expanded layout.
        NOTE (flagged): the FROM ACCESS TO IMPACT statement is NOT
        in the new frame — it retires from the landing desktop here. */}
    <div class="landing-sreel" data-sreel>
      <div class="landing-sreel__stage" data-sreel-stage>
        <p class="landing-sreel__wwd" data-sreel-wwd>WHAT WE DO</p>
        {SERVICES_REEL_PILLARS.map((p, i) => (
          <div class="landing-sreel__pillar" data-sreel-pillar data-i={String(i)}>
            <div class="landing-sreel__divider" aria-hidden="true"><span class="landing-sreel__fill" data-sreel-fill></span></div>
            <h3 class="landing-sreel__titlerow" data-sreel-titlerow>
              <span class="landing-sreel__title" data-sreel-text>{p.name}</span>
              <span class="landing-sreel__num" data-sreel-text>{p.num}</span>
            </h3>
            <p class="landing-sreel__desc" data-sreel-desc data-sreel-text>{p.desc[0]}<br />{p.desc[1]}</p>
            <p class="landing-sreel__wlabel" data-sreel-wlabel data-sreel-text>{p.label}</p>
            <div class="landing-sreel__listwin" data-sreel-listwin>
              <div class="landing-sreel__list" data-sreel-list>
                {p.services.map((svc) => (
                  <div class="landing-sreel__row">
                    <span class="landing-sreel__rowline" aria-hidden="true"></span>
                    <span class="landing-sreel__svc" data-sreel-text>{svc.t}</span>
                  </div>
                ))}
                <span class="landing-sreel__rowline landing-sreel__rowline--end" aria-hidden="true"></span>
              </div>
              {/* THE REEL FADE — gradient-masked backdrop blur, top
                  edge on the pillar title's top: rows dissolve out
                  through it, never a bare clip. */}
              <div class="landing-sreel__listfade" aria-hidden="true"></div>
            </div>
            {/* MORE INFO → /services (the established chip family). */}
            <a class="landing-sreel__btn" href="/services" data-sreel-btn data-char-ripple-trigger>
              <span data-char-ripple>MORE INFO</span>
              <svg class="landing-sreel__btn-arrow" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" data-char-ripple-arrow>
                <path d="M1.77477 12L0.917669 11.0884L0.0605699 10.2313L8.33333 2.15152L2.16746e-07 2.15151L0 0H12V12L9.84848 12L9.84848 3.66667L1.77477 12Z" fill="currentColor" />
              </svg>
            </a>
            <figure class="landing-sreel__img" data-sreel-imgwin aria-hidden="true">
              <img data-sreel-img src={asset(p.img)} alt="" loading="lazy" decoding="async" />
            </figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Work — horizontal gallery on the DARK ground (frame
      18:1694): follows services IN FLOW now — the −100dvh overlap is
      retired ≥1025 (landing.css) because the services tail carries
      the fade-to-black and this section arrives black-over-black
      (landing-services.js, constants verbatim). */}
  <LandingFeatured />

  {/* We Create Access — light-on-light after Featured Work; the
      -100dvh overlap (moved here from Our Network in the reorder)
      keeps the featured departure overlapped exactly as before. */}
  <LandingAccess />

  {/* Closing section + footer — plain document flow, no runway
      (Figma 21:2392). Both carry z260, the exit gate over the fixed
      hero stage. */}
  <LandingClosing />
  <LandingFooter />
  {/* Footer-reveal spacer: the footer overlaps the closing section's
      bottom (negative margin) and pins BEHIND it (z259 < 260) at the
      viewport bottom; this transparent, click-through spacer keeps
      the document height so the page ends exactly at full reveal. */}
  <div class="landing-footer-spacer" aria-hidden="true"></div>
</SiteShell>

<script>
  import { initLandingHeroScroll } from '../scripts/landing/landing-hero-scroll.js';
  import { initLandingFounders } from '../scripts/landing/landing-founders.js';
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initLandingServices } from '../scripts/landing/landing-services.js';
  import { initLandingServicesReel } from '../scripts/landing/landing-services-reel.js';
  import { initLandingNetwork } from '../scripts/landing/landing-network.js';
  import { initLandingFeatured } from '../scripts/landing/landing-featured.js';
  import { initLandingAccess } from '../scripts/landing/landing-access.js';
  import { initLandingClosing } from '../scripts/landing/landing-closing.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initSplash } from '../scripts/landing/splash.js';

  /* The splash boots FIRST so it owns the load before any section
     schedules its own arrival. It only exists when the pre-paint
     decision in LandingSplash.astro turned it on. */
  const splashEl = document.querySelector('[data-landing-splash]');
  let cleanupSplash = document.documentElement.getAttribute('data-ne-splash') === 'on'
    && splashEl instanceof HTMLElement
    ? initSplash(splashEl)
    : () => {};

  let cleanupLandingHero = initLandingHeroScroll();
  let cleanupLandingFounders = initLandingFounders();
  let cleanupCharRipple = initCharRipple();
  let cleanupLandingServices = initLandingServices();
  let cleanupLandingReel = initLandingServicesReel();
  let cleanupLandingNetwork = initLandingNetwork();
  let cleanupLandingFeatured = initLandingFeatured();
  let cleanupLandingAccess = initLandingAccess();
  let cleanupLandingClosing = initLandingClosing();
  let cleanupNavEntrance = initNavEntrance();

  document.addEventListener('astro:before-swap', () => {
    cleanupLandingHero();
    cleanupLandingFounders();
    cleanupCharRipple();
    cleanupLandingServices();
    cleanupLandingReel();
    cleanupLandingNetwork();
    cleanupLandingFeatured();
    cleanupLandingAccess();
    cleanupLandingClosing();
    cleanupNavEntrance();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupLandingHero = initLandingHeroScroll();
    cleanupLandingFounders = initLandingFounders();
    cleanupCharRipple = initCharRipple();
    cleanupLandingServices = initLandingServices();
    cleanupLandingReel = initLandingServicesReel();
    cleanupLandingNetwork = initLandingNetwork();
    cleanupLandingFeatured = initLandingFeatured();
    cleanupLandingAccess = initLandingAccess();
    cleanupLandingClosing = initLandingClosing();
    cleanupNavEntrance = initNavEntrance();
  });
</script>
