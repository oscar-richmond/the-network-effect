---
/**
 * Pre-launch holding page, variant B — the Selected Works pillar
 * images' grain-displacement effect (holding-warp.js: the wave-shader
 * bow + cursor grain, verbatim shaders) on the shared drift driver,
 * flat-travelling mixed-height column. Compare against /holding (the
 * curl-fold gallery); one gets picked later.
 *
 * The page body is the shared HoldingPage component — identical to
 * /holding in everything except the gallery region's children (the
 * server-rendered slide stack below, which doubles as the reduced-
 * motion / no-WebGL static frame) and the gallery module booted here.
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
import HoldingPage from '../components/holding/HoldingPage.astro';
import { warpGalleryImages } from '../data/holding/images.js';
---

<HoldingLayout title="The Network Effect" bodyClass="holding-page">
  <HoldingPage galleryImages={warpGalleryImages}>
    <!-- PENDING SIGN-OFF: placeholder gallery imagery (the shared HP
         Carousel set — same content as /holding, different treatment,
         per the A/B's design). -->
    <div class="holding-warp" slot="gallery" aria-hidden="true">
      {warpGalleryImages.map((src) => (
        <div class="holding-warp__slide" data-holding-warp-slide>
          <img src={src} alt="" decoding="async" />
        </div>
      ))}
    </div>
  </HoldingPage>
</HoldingLayout>

<script>
  import { bootHoldingPage } from '../scripts/holding/holding-shared.js';
  import { createHoldingWarp } from '../scripts/holding/holding-warp.js';

  bootHoldingPage({ createGallery: createHoldingWarp, devHandle: '__holdingWarp' });
</script>
