---
/**
 * Holding page, variant CURRENT — the Selected Works grain-displacement
 * warp column (holding-warp.js) on desktop >=1025; the production
 * candidate URL. Mobile/tablet <=1024 is the shared travel mechanic,
 * identical across /holding, /holding-2 and /holding-3 (see
 * holding-shared.js's bootHoldingVariant). The page body is the shared
 * HoldingPage shell — left-column fixes land there once for all three
 * routes.
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
import HoldingPage from '../components/holding/HoldingPage.astro';
import { warpGalleryImages } from '../data/holding/images.js';
---

<HoldingLayout title="The Network Effect" bodyClass="holding-page holding-shell">
  <HoldingPage galleryImages={warpGalleryImages}>
    <!-- PENDING SIGN-OFF: placeholder gallery imagery — the desktop
         warp stack (also its static fallback). -->
    <div class="holding-warp" slot="gallery" aria-hidden="true">
      {warpGalleryImages.map((src) => (
        <div class="holding-warp__slide" data-holding-warp-slide>
          <img src={src} alt="" decoding="async" />
        </div>
      ))}
    </div>
  </HoldingPage>
</HoldingLayout>

<script>
  import { bootHoldingVariant } from '../scripts/holding/holding-shared.js';
  import { createHoldingWarp } from '../scripts/holding/holding-warp.js';

  bootHoldingVariant({ createDesktopGallery: createHoldingWarp, devHandle: '__holdingGallery2' });
</script>
