---
/**
 * /landing — REDIRECT STUB (release restructure, Oscar 2026-08-10).
 * The landing page moved to "/" (index.astro). This keeps every old
 * bookmark/deep link working; nothing in the site links here. A
 * plain document on purpose: no BaseLayout, so no scale-shell boot,
 * no splash gate, no wipe — just an instant client-side redirect
 * with a meta fallback for no-JS.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/" />
    {/* SEO batch item 4: this stub is a 200, not a 301 (output: 'static',
        no adapter), so without these it is indexable as a duplicate of
        "/" — it carried a RELATIVE canonical and the same title. Both
        fixed; the real redirect is the vercel.json entry added in the
        same pass. */}
    <link rel="canonical" href="https://networkeffectagency.co.uk/" />
    <meta name="robots" content="noindex, follow" />
    <title>Redirecting to The Network Effect</title>
    <script>window.location.replace('/');</script>
  </head>
  <body></body>
</html>
