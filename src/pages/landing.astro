---
/**
 * /landing — THE NEW SITE, in development.
 *
 * A fresh page: hero only, nothing beyond it. It shares the visual
 * system with the archived build (ground, grain, top nav, Lenis/GSAP
 * scroll architecture) but not its files — everything here is scoped to
 * the `landing-v2` body class and lives under src/{components,styles,
 * scripts}/landing/. Nothing on this page touches /old, /services or
 * the holding routes.
 *
 * STAGING ONLY. The root serves the holding page; this route is not
 * promoted anywhere until Oscar says so. See docs/ENVIRONMENTS.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingFounders from '../components/landing/LandingFounders.astro';
import LandingNetwork from '../components/landing/LandingNetwork.astro';
import LandingServicesStack from '../components/landing/LandingServicesStack.astro';
import LandingAccess from '../components/landing/LandingAccess.astro';
import Menu from '../components/Menu.astro';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/fonts.css';
---

<BaseLayout title="The Network Effect" bodyClass="landing-v2" htmlClass="js">
  {/* Top nav — the existing chrome and menu behaviour, unchanged. */}
  <header class="home__topbar home__topbar--about">
    <nav class="home__menu-cta" aria-label="Site">
      <button
        type="button"
        class="home__menu-toggle"
        data-menu-toggle
        data-char-ripple-trigger
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span data-menu-label-menu data-char-ripple>MENU</span>
        <span class="home__menu-toggle-label--close" data-menu-label-close aria-hidden="true">
          <span class="home__menu-toggle-close-text">CLOSE</span>
          <span class="home__menu-toggle-x" data-menu-toggle-x aria-hidden="true">×</span>
        </span>
      </button>
    </nav>
    <h1 class="home__logo">THE NETWORK EFFECT</h1>
    {/* "LET'S CHAT" replaces the visible address (Oscar's rev) — the
        mailto target is UNCHANGED. The arrow is Oscar's supplied SVG
        inlined per his spec: fill="currentColor" (the asset's
        hardcoded white fill stripped, its no-op full-rect clipPath
        dropped) so text + arrow are ONE blended element that can
        never desync under the nav's per-item difference treatment. */}
    <a
      class="home__topbar-email"
      href="mailto:hello@networkeffectagency.co.uk"
      data-char-ripple-trigger
    >
      <span data-char-ripple>LET’S CHAT</span>
      <svg
        class="home__topbar-email-arrow"
        viewBox="0 0 300 300"
        aria-hidden="true"
        data-char-ripple-arrow
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M44.3693 300L22.9417 277.21L1.51425 255.783L208.333 53.788H5.41863e-06L0 0H300V300H246.212V91.6667L44.3693 300Z"
          fill="currentColor"
        />
      </svg>
    </a>
  </header>

  <LandingHero />

  {/* First content section — slides up over the held full-screen
      video; see the arrival note in landing.css. */}
  <LandingFounders />

  {/* Services — doubles as the departure runway (the grey ground the
      full-screen founders photo scrolls off against) and now carries
      the full stacked-services sequence (Figma 13:1729/13:2066):
      centred intro line → title rise + morph to the small OUR
      SERVICES → three pillar cards rise and stack at 150px offsets →
      the fade-to-black (re-anchored, constants verbatim) into Our
      Network. All beats in landing-services.js. Line 1 mixes faces;
      its left edge aligns the O of OUR onto the first S of ACCESS
      below (runtime glyph derivation, unchanged). FROM sits in its
      own span so Beat A can exit it separately (the wrap keeps
      element children whole). */}
  <section class="landing-outro" aria-label="Our services" data-landing-services>
    <div class="landing-services__stage" data-services-stage>
      <div class="landing-services__center" data-services-center>
        <h2 class="landing-services__title" data-landing-services-title>
          <span class="landing-services__line" data-landing-services-line1
            ><span class="landing-services__serrif">OUR SERVICES<span data-services-stop>.</span></span> <span data-services-from>FROM</span></span
          >
          <span class="landing-services__line" data-landing-services-line2>ACCESS. TO IMPACT.</span>
        </h2>
      </div>
      <LandingServicesStack />
    </div>
  </section>

  {/* Our Network — arrives on the black the outro just faded to. */}
  <LandingNetwork />

  {/* We Create Access — light returns on a plain document boundary;
      the section's own top fade softens the dark→light cut. */}
  <LandingAccess />

  <Menu />

  {/* Grain: last-in-body sibling, never an ancestor (blend safety). */}
  <div class="landing-grain" aria-hidden="true"></div>
</BaseLayout>

<script>
  import { initLandingHeroScroll } from '../scripts/landing/landing-hero-scroll.js';
  import { initLandingFounders } from '../scripts/landing/landing-founders.js';
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initLandingServices } from '../scripts/landing/landing-services.js';
  import { initLandingNetwork } from '../scripts/landing/landing-network.js';
  import { initLandingAccess } from '../scripts/landing/landing-access.js';

  let cleanupLandingHero = initLandingHeroScroll();
  let cleanupLandingFounders = initLandingFounders();
  let cleanupCharRipple = initCharRipple();
  let cleanupLandingServices = initLandingServices();
  let cleanupLandingNetwork = initLandingNetwork();
  let cleanupLandingAccess = initLandingAccess();

  document.addEventListener('astro:before-swap', () => {
    cleanupLandingHero();
    cleanupLandingFounders();
    cleanupCharRipple();
    cleanupLandingServices();
    cleanupLandingNetwork();
    cleanupLandingAccess();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupLandingHero = initLandingHeroScroll();
    cleanupLandingFounders = initLandingFounders();
    cleanupCharRipple = initCharRipple();
    cleanupLandingServices = initLandingServices();
    cleanupLandingNetwork = initLandingNetwork();
    cleanupLandingAccess = initLandingAccess();
  });
</script>
