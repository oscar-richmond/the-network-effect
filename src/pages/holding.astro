---
/**
 * Pre-launch holding page, variant A — the auto-rolling curl-fold
 * gallery (holding-gallery.js). Compare against /holding-2 (the stacked
 * warp column); one gets picked later. Swapping the winner onto "/" is a
 * later, separate, explicitly-triggered deploy step, not performed here.
 *
 * The entire page body is the shared HoldingPage component — fixes to
 * the tagline/buttons/sign-off/choreography land there ONCE for both
 * variants. This file only picks the gallery module.
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
import HoldingPage from '../components/holding/HoldingPage.astro';
---

<HoldingLayout title="The Network Effect" bodyClass="holding-page">
  <HoldingPage />
</HoldingLayout>

<script>
  import { bootHoldingPage } from '../scripts/holding/holding-shared.js';
  import { createHoldingGallery } from '../scripts/holding/holding-gallery.js';

  bootHoldingPage({ createGallery: createHoldingGallery, devHandle: '__holdingGallery' });
</script>
