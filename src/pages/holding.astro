---
/**
 * Holding page, variant SPINNING — the fold-turn gallery
 * (holding-gallery.js, the original turning effect) on desktop >=1025.
 * Mobile/tablet <=1024 is the shared travel mechanic, identical across
 * /holding, /holding-2 and /holding-3 (see holding-shared.js's
 * bootHoldingVariant). The page body is the shared HoldingPage shell —
 * left-column fixes land there once for all three routes. The default
 * gallery slot (the fold poster) is this variant's desktop static frame.
 */
import HoldingLayout from '../layouts/HoldingLayout.astro';
import HoldingPage from '../components/holding/HoldingPage.astro';
---

<HoldingLayout title="The Network Effect" bodyClass="holding-page holding-shell">
  <HoldingPage />
</HoldingLayout>

<script>
  import { bootHoldingVariant } from '../scripts/holding/holding-shared.js';
  import { createHoldingGallery } from '../scripts/holding/holding-gallery.js';

  bootHoldingVariant({ createDesktopGallery: createHoldingGallery, devHandle: '__holdingGallery' });
</script>
