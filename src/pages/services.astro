---
/**
 * /services — "Services Page - Option 6" (Figma q30umfI8zabtFWBtRL3FTt
 * frame 38:2420, extracted 2026-08-26; 118px chrome subtracted; hidden
 * layers + Chrome mockups ignored; nav verified current and untouched).
 *
 * DESKTOP (≥1025) — the .sv6 build below:
 *  1. HERO — FROM ACCESS. TO IMPACT. (serif+sans 100/88 pair) +
 *     the relationship-led description (built as ink — the frame
 *     draws white+difference over flat ground, the ink-equivalent;
 *     flagged).
 *  2. PILLARS ×3 — full-bleed 1728×1006 image, title/subtitle white
 *     + difference at the frame's +200/+264; then the 56/54
 *     statement + #C1250E bar; then WE BUILD/SHAPE/CREATE + the
 *     928px hover TABLE at x776 (the sv-rows machinery, reused
 *     wholesale — RED accent per Oscar; the frame's own hover mock
 *     is #232A89 blue, reported).
 *  3. GALLERIES ×2 — 6×273×320 strips with label chains, the
 *     landing featured-work vocabulary: header reveal, boxes
 *     staggered L→R, then the sticky pin + horizontal travel
 *     (travel derived live from the strip width — the frame's six
 *     boxes fit the viewport, so the derived travel is 0 until
 *     more images land in the data; reported).
 *  4. FRAGMENTED STATEMENTS ×2 — the landing closing-statement
 *     treatment wholesale: 100/88/−4 lines at authored positions +
 *     the shared centred dwell (statement-dwell.js).
 *  5. THE DARK BAND (38:2501, #161616) — from the CONNECT header
 *     image's bottom edge to the AMPLIFY header image's top
 *     (statement 2, table 2, gallery 2 and fragment 2 sit on it).
 *  6. FOOTER — the standard BLUE theme (the light variant retired
 *     from use here; see the build report).
 *
 * MOBILE (≤1024) — NOT IN SCOPE: the entire previous build renders
 * unchanged inside the .sv-legacy wrapper below (display:contents
 * under the seam — geometry-invisible; display:none above it). Its
 * driver (services-v2.js) initialises only below the seam.
 *
 * BLEND WALK: difference lives on the pillar overlay texts only
 * (bare chains: section > text wrap > text). Everything else is
 * plain ink/white. RIGHTS: see services-6.js — the Depp and
 * Lagerfeld/Pharrell gallery images carry the elevated flags.
 *
 * STAGING ONLY — nothing promoted anywhere until Oscar says so.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingNetwork from '../components/landing/LandingNetwork.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import ClosingStatement from '../components/landing/ClosingStatement.astro';
import { SERVICES_HERO, SERVICES_PILLARS, SERVICES_ACCESS } from '../data/landing/services-v2.js';
import { SV6_HERO, SV6_PILLARS, SV6_GALLERIES, SV6_FRAGMENTS, SV6_HOVER_PLACEHOLDER, SV6_HOVER_IMGS } from '../data/landing/services-6.js';
import { asset } from '../utils/asset.js';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/landing/services-v2.css';
import '../styles/landing/services-6.css';
import '../styles/fonts.css';
---

<SiteShell title="Services — The Network Effect" bodyClass="landing-v2 services-v2 services-6">
  {/* ═════════ THE OPTION-6 DESKTOP BUILD ═════════ */}
  <main class="sv6" data-services-6 aria-label="Services" id="main" tabindex="-1">
    {/* 1 — HERO (38:2596/2595). */}
    <header class="sv6-hero">
      <h1 class="sv6-hero__title" data-sv6-hero-title>
        <span class="sv6-hero__t-serif">{SV6_HERO.titleSerif}</span><span class="sv6-hero__t-sans">{SV6_HERO.titleSans}</span>
      </h1>
      <p class="sv6-hero__desc" data-sv6-hero-desc>{SV6_HERO.desc}</p>
    </header>

    {SV6_PILLARS.map((p, pi) => (
      <Fragment>
        {/* Pillar header — full-bleed image + difference texts at the
            frame's +200/+264. id keeps the landing MORE INFO deep
            links working. */}
        <section class={`sv6-pillar${p.dark ? ' sv6-on-dark' : ''}`} id={p.key} aria-label={p.title}>
          <img class="sv6-pillar__img" src={asset(p.headerImg)} alt="" loading={pi === 0 ? 'eager' : 'lazy'} decoding="async" />
          {/* Item 1 (Oscar): the block VERTICALLY CENTRES against the
              image via a flex wrapper — derived from the section's
              height by construction, no fixed offset, NO transform
              (the legacy pillar's blend-safe centring pattern: each
              text keeps its own difference). */}
          <div class="sv6-pillar__text">
            {/* R3 (Oscar, 2026-08-27): the landing WHAT WE DO title
                grammar - name at 56/54/-3.5 with the /0N at its right,
                cap-top aligned (the reel's alignment fix, reused);
                the old number-left "0N — NAME" arrangement retires.
                name/num wrapped separately so the num's absolute
                anchor survives the reveal clips (the reel's own
                structure). */}
            <h2 class="sv6-pillar__titlerow">
              <span class="sv6-pillar__name" data-sv6-line>{p.title.split(' — ')[1]}</span>
              <span class="sv6-pillar__num" data-sv6-line>/{p.title.split(' — ')[0]}</span>
            </h2>
            {/* R36 item 5: the landing reel's two authored lines (data). */}
            <p class="sv6-pillar__sub" data-sv6-line>{p.subtitleLines[0]}<br />{p.subtitleLines[1]}</p>
          </div>
        </section>

        {/* Statement + bar (the case-study intro pattern). */}
        <div class={`sv6-st${p.dark ? ' sv6-st--dark' : ''}`} data-sv6-st>
          <p class="sv6-st__text" data-sv6-statement
            ><span class="sv6-st__indent" aria-hidden="true"></span>{p.statement}</p
          >
          <div class="sv6-st__bar" data-sv6-bar aria-hidden="true" style={`height:${p.barH}px`}></div>
        </div>

        {/* Label + the 928 hover table — the sv-rows machinery
            markup contract (index-less rows; every row's hover image
            is the frame's placeholder pending Oscar's per-row drop —
            see services-6.js). R36 item 6: treatment 'indent' — no
            fill / marquee / edges spans. */}
        <section
          class={`sv-rows sv6-table${p.dark ? ' sv6-table--dark' : ''}`}
          data-sv-rows
          style={`--sv-accent:${p.accent}`}
          aria-label={`${p.title} services`}
        >
          <p class="sv-rows__label sv6-table__label">{p.label}</p>
          <ul class="sv-rows__list" data-sv-rows-list>
            {p.rows.map((row, ri) => (
              <li
                class="sv-rows__row"
                data-sv-row
                data-text={row}
                data-img={asset(SV6_HOVER_IMGS[pi][ri] ?? SV6_HOVER_PLACEHOLDER)}
              >
                <span class="sv-rows__divider" aria-hidden="true"></span>
                <span class="sv-rows__inner">
                  <span class="sv-rows__text">{row}</span>
                </span>
                {/* R36 item 6: the fill / marquee / edges spans are retired here —
                    the rows take the landing's indent + image treatment. */}
              </li>
            ))}
          </ul>
          <div class="sv-rows__endline" data-sv-rows-end aria-hidden="true">
            <span class="sv-rows__divider"></span>
          </div>
          <div class="sv-rows__img" data-sv-rows-img aria-hidden="true">
            <img data-sv-img-base src={asset(SV6_HOVER_PLACEHOLDER)} alt="" loading="lazy" decoding="async" />
            <img data-sv-img-over src={asset(SV6_HOVER_PLACEHOLDER)} alt="" loading="lazy" decoding="async" hidden />
          </div>
        </section>

        {/* After IMMERSE: gallery 1 + fragment 1. After CONNECT:
            gallery 2 + fragment 2 (on the dark band). */}
        {pi < 2 && (
          <Fragment>
            <section class={`sv6-gal${SV6_GALLERIES[pi].dark ? ' sv6-on-dark' : ''}`} data-sv6-gal aria-label={SV6_GALLERIES[pi].headerLines.join(' ')}>
              <div class="sv6-gal__stage" data-sv6-gal-stage>
                <h3 class="sv6-gal__title" data-sv6-gal-title>
                  {SV6_GALLERIES[pi].headerLines.map((line) => (
                    <span class="sv6-gal__titleline">{line}</span>
                  ))}
                </h3>
                <div class="sv6-gal__strip" data-sv6-gal-strip>
                  {SV6_GALLERIES[pi].imgs.map((src, bi) => (
                    <figure class="sv6-gal__box" data-sv6-gal-box>
                      <img src={asset(src)} alt="" loading="lazy" decoding="async" />
                      <figcaption class="sv6-gal__label">{SV6_GALLERIES[pi].labels[bi]}</figcaption>
                      {bi < SV6_GALLERIES[pi].imgs.length - 1 && (
                        <span class="sv6-gal__arrow" aria-hidden="true">
                          {/* Oscar's supplied 32x16 arrow (2026-08-27),
                              geometry verbatim, hardcoded stroke ->
                              currentColor (the footer-arrow precedent)
                              so one path serves both grounds; replaces
                              the old 16x32 asset that rendered squashed
                              into a divider-looking line. */}
                          <svg width="32" height="16" viewBox="0 0 32 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21.5 0C21.5 1.05529 22.3107 0.852986 23.3 2.17565C24.572 3.88232 26.092 5.37139 27.8347 6.50774C29.1413 7.35965 30.7253 8.17743 32 8.17743M32 8.17743C30.7253 8.17743 29.14 8.99521 27.8347 9.84712C26.092 10.9849 24.572 12.474 23.3 14.1778C22.3107 15.5019 22 14.9476 22 16M32 8.17743L0 8.17743" stroke="currentColor" stroke-width="1.5" />
                          </svg>
                        </span>
                      )}
                    </figure>
                  ))}
                </div>
              </div>
            </section>

            <section class={`sv6-frag${SV6_FRAGMENTS[pi].dark ? ' sv6-frag--dark sv6-on-dark' : ''}`} data-sv6-frag aria-label="Statement">
              <div class="sv6-frag__stage" data-sv6-frag-stage>
                {SV6_FRAGMENTS[pi].lines.map((line, li) => (
                  <Fragment>
                    <p class="sv6-frag__line" data-sv6-frag-line style={`left:${line.x}px;top:${li * 90}px`}>{line.t}</p>
                    {line.pair && (
                      <p class="sv6-frag__line" data-sv6-frag-line style={`left:${line.pair.x}px;top:${li * 90}px`}>{line.pair.t}</p>
                    )}
                  </Fragment>
                ))}
              </div>
            </section>
          </Fragment>
        )}
      </Fragment>
    ))}

    {/* R36 item 7 (Oscar, 2026-09-04): the CLOSING STATEMENT — the landing's
        shared instance (same composition, same choreography; the copy is a
        PLACEHOLDER here, flagged) — below AMPLIFY's WE CREATE list, the
        page's last flow child: the footer reveals from beneath its red tail
        (the 180 ruling). Spacing above: services-6.css. */}
    <ClosingStatement />

    {/* The dark band (38:2501) is painted by .sv6-darkband — a
        wrapper is impossible without reordering the flow, so the
        band is an absolutely-positioned ground layer sized by the
        driver from the CONNECT image's bottom to the AMPLIFY
        image's top (the frame's own edges; its 25px tuck under the
        CONNECT image is hidden by the opaque image either way). */}
    <div class="sv6-darkband" data-sv6-darkband aria-hidden="true"></div>
  </main>

  {/* ═════════ THE LEGACY BUILD — MOBILE ONLY (≤1024) ═════════
      The previous page, byte-identical for the out-of-scope mobile
      build: display:contents under the seam (geometry-invisible
      wrapper), display:none above it. services-v2.js initialises
      only below the seam. */}
  <div class="sv-legacy" data-sv-legacy>
  <div class="sv" data-services-v2>
    <section class="sv-hero" data-sv-hero aria-label="From access to impact">
      <div class="sv-hero__stage" data-sv-hero-stage>
        <div class="sv-hero__track" data-sv-hero-track aria-hidden="true">
          {SERVICES_HERO.wave.map((item) => (
            <div
              class="sv-hero__item"
              data-sv-wave-speed={String(item.speed)}
              style={`left:${item.x}px;top:calc(100% + ${item.y}px);width:${item.w}px;height:${item.h}px`}
            >
              <img src={asset(`/assets/pillar-waves/${item.file}.jpg`)} alt="" loading="eager" decoding="async" />
            </div>
          ))}
        </div>
        <canvas class="sv-hero__canvas" data-sv-hero-canvas aria-hidden="true"></canvas>
      </div>
      <div class="sv-hero__textwrap" data-sv-hero-text>
        <h1 class="sv-hero__title" data-sv-hero-title>
          <span class="sv-hero__title-serif">FROM ACCESS</span>
          <span class="sv-hero__title-sans">TO IMPACT.</span>
        </h1>
        <p class="sv-hero__subtitle" data-sv-hero-subtitle>{SERVICES_HERO.subtitle}</p>
      </div>
    </section>

    {SERVICES_PILLARS.map((p) => (
      <Fragment>
        <section class="sv-pillar" id={`m-${p.id}`} aria-label={`${p.num} — ${p.name}`}>
          <div class="sv-pillar__frame" data-sv-pillar-frame>
            <img class="sv-pillar__img" data-sv-pillar-img src={asset(p.fullImg)} alt="" loading="lazy" decoding="async" />
          </div>
          <div class="sv-pillar__text" aria-hidden="false">
            <h2 class="sv-pillar__title" data-sv-pillar-title>{p.num} — {p.name}</h2>
            <p class="sv-pillar__sub" data-sv-pillar-sub>{p.sub}</p>
          </div>
        </section>

        <div class="sv-intro" data-sv-intro data-sv-dwell>
          <div class="sv-st-stage" data-sv-dwell-stage>
            <p class="sv-intro__statement" data-sv-statement
              ><span class="sv-intro__indent" aria-hidden="true"></span>{p.statement}</p
            >
            {p.statementSub && <p class="sv-intro__sub" data-sv-statement-sub>{p.statementSub}</p>}
            <div class="sv-intro__bar" data-sv-bar aria-hidden="true"></div>
          </div>
        </div>

        <section
          class="sv-rows"
          data-sv-rows
          style={`--sv-accent:${p.accent}`}
          aria-label={`${p.name} services`}
        >
          <p class="sv-rows__label">{p.label}</p>
          <ul class="sv-rows__list" data-sv-rows-list>
            {p.rows.map((row) => (
              <li
                class="sv-rows__row"
                data-sv-row
                data-index={row.index}
                data-text={row.text}
                data-img={asset(row.img ?? p.hoverImg)}
              >
                <span class="sv-rows__divider" aria-hidden="true"></span>
                <span class="sv-rows__inner">
                  <span class="sv-rows__index">{row.index} /</span>
                  <span class="sv-rows__text">{row.text}</span>
                </span>
                <span class="sv-rows__fill" aria-hidden="true"></span>
                <span class="sv-rows__marq" data-sv-marq aria-hidden="true"></span>
                <span class="sv-rows__edges" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
          <div class="sv-rows__endline" data-sv-rows-end aria-hidden="true">
            <span class="sv-rows__divider"></span>
          </div>
          <div class="sv-rows__img" data-sv-rows-img aria-hidden="true">
            <img data-sv-img-base src={asset(p.hoverImg)} alt="" loading="lazy" decoding="async" />
            <img data-sv-img-over src={asset(p.hoverImg)} alt="" loading="lazy" decoding="async" hidden />
          </div>
        </section>

        {p.gallery && (
          <Fragment>
            <div class="sv-galhead" data-sv-galhead>
              <h3 class="sv-galhead__title" data-sv-galhead-title>
                {p.galleryTitle.map((line) => (
                  <span class="sv-galhead__line">{line}</span>
                ))}
              </h3>
              {p.galleryNote && (
                <p class="sv-galhead__note" data-sv-galhead-note
                  ><span class="sv-galhead__note-serrif">{p.galleryNote.serrif}</span><br />{p.galleryNote.bold}</p
                >
              )}
            </div>
            <div class="sv-gallery" data-sv-gallery>
              {p.gallery.map((src) => (
                <figure class="sv-gallery__tile" data-sv-tile>
                  <img src={asset(src)} alt="" loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
            <div class="sv-flow" data-sv-flow>
              {p.flow.map((block, i) => (
                <Fragment>
                  {i > 0 && (
                    <span class="sv-flow__arrow" aria-hidden="true">
                      <img src={asset('/assets/landing/services/flow-arrow.svg')} alt="" width="16" height="32" />
                    </span>
                  )}
                  <span class="sv-flow__block" data-sv-flow-block>
                    {block.map((line) => (
                      <span class="sv-flow__line">{line}</span>
                    ))}
                  </span>
                </Fragment>
              ))}
            </div>
          </Fragment>
        )}
      </Fragment>
    ))}

    <div class="sv-fade-runway" data-sv-fade-runway aria-hidden="true"></div>

    <div class="sv-access" data-sv-access>
      <div class="sv-st-dwell" data-sv-dwell>
        <div class="sv-st-stage" data-sv-dwell-stage>
          <p class="sv-access__statement" data-sv-access-statement
            ><span class="sv-intro__indent" aria-hidden="true"></span>{SERVICES_ACCESS.statement}</p
          >
          <p class="sv-access__note" data-sv-access-note>{SERVICES_ACCESS.note}</p>
        </div>
      </div>
      <div class="sv-gallery sv-gallery--dark" data-sv-gallery>
        {SERVICES_ACCESS.gallery.map((src) => (
          <figure class="sv-gallery__tile" data-sv-tile>
            <img src={asset(src)} alt="" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
      <div class="sv-toggles" data-sv-toggles>
        {SERVICES_ACCESS.toggles.map((pair) => (
          <span class="sv-toggles__pair" data-sv-toggle>
            <span>{pair[0]}</span>
            <img src={asset('/assets/landing/services/toggle-arrows-a.svg')} alt="" width="24" height="12" />
            <span>{pair[1]}</span>
          </span>
        ))}
      </div>
    </div>

    <LandingNetwork entry="prev-exit" />
  </div>

  <LandingFooter theme="light" />
  <div class="landing-footer-spacer" aria-hidden="true"></div>
  </div>

  {/* Desktop footer — the GREY/WHITE theme (Oscar's global ruling,
      2026-09-02; was the 38:2562 blue). AFTER the legacy block so the
      legacy driver's unscoped .landing-footer queries keep finding
      ITS footer first on mobile; services-6.js queries its own
      scoped wrapper. */}
  <div class="sv6-footwrap" data-sv6-footwrap>
    <LandingFooter theme="light" />
  </div>
  <div class="landing-footer-spacer sv6-footspacer" aria-hidden="true"></div>
</SiteShell>

<script>
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initLandingNetwork } from '../scripts/landing/landing-network.js';
  import { initServicesV2 } from '../scripts/landing/services-v2.js';
  import { initServices6 } from '../scripts/landing/services-6.js';
  import { isMobileViewport } from '../scripts/landing/viewport.js';

  const boot = () => {
    const fns = [initCharRipple(), initNavEntrance()];
    if (isMobileViewport()) {
      /* The legacy build (mobile only) — its own driver + network. */
      fns.push(initServicesV2(), initLandingNetwork());
    } else {
      fns.push(initServices6());
    }
    return () => fns.forEach((fn) => fn());
  };

  let cleanup = boot();
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:after-swap', () => { cleanup = boot(); });
</script>
