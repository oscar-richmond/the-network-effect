---
/**
 * /services — the NEW BUILD's services page (Figma 60:3648
 * "Services Page - Option 1 Hero", extracted 2026-08-08; 83px
 * chrome subtracted; hidden layers + the frame's invisible founder
 * debris ignored). The OLD standalone partners-wheel page moved to
 * /old/services in the same change.
 *
 * ANATOMY (all geometry from the extraction — see services-v2.css):
 *  1. HERO — fixed centred title/subtitle (white + difference) over
 *     four images that travel UP AND PAST behind the text: the /old
 *     01-IMMERSE pillar-hero mechanic ported wholesale (same images,
 *     same speeds, same track+drift maths — services-v2.js), slotted
 *     into THIS file's hero geometry. NON-CLICKABLE (no links, no
 *     hover affordances — Oscar's spec).
 *  2. PILLARS ×3 (IMMERSE/CONNECT/AMPLIFY) — each a full-viewport
 *     image starting exactly as the hero wave's last image exits,
 *     then statement (+#C1250E bar — the case-study intro pattern),
 *     hover rows (the page's one NEW mechanic), gallery + flow rows.
 *  3. GROUND FADE — #EEEEF0 → #161616 scrubbed over the 500px
 *     runway (the landing TRANSITION_GROUND_FADE_PX grammar) into
 *  4. WE CREATE ACCESS + dark gallery + toggles, then the landing's
 *     OUR NETWORK component verbatim (shared already — zero landing
 *     change), then
 *  5. FOOTER — shared component, the LIGHT colourway (second
 *     official theme: #EEEEF0 ground / #161616 ink / #A6A6A8 muted).
 *
 * BLEND WALK: difference elements are the hero + pillar overlay
 * texts. Chains kept bare (section > sticky stage > text; the
 *  transformed wave track is an earlier SIBLING, never an ancestor).
 * The scrubbed main background can't break the fixed nav's blend —
 * difference composites against whatever is beneath.
 *
 * CONTENT: all copy verbatim from the file (deck-sourced); rights
 * flags + placeholder standing in services-v2.js (data).
 * STAGING ONLY — nothing promoted anywhere until Oscar says so.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingNetwork from '../components/landing/LandingNetwork.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { SERVICES_HERO, SERVICES_PILLARS, SERVICES_ACCESS } from '../data/landing/services-v2.js';
import { asset } from '../utils/asset.js';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/landing/services-v2.css';
import '../styles/fonts.css';
---

<SiteShell title="Services — The Network Effect" bodyClass="landing-v2 services-v2">
  <main class="sv" data-services-v2>
    {/* ── 1. HERO — sticky stage; the wave track scrubs up past the
        fixed text (services-v2.js sets the runway + travel). The
        shader canvas (the access-wave treatment, Oscar's rev) sits
        over the track, pointer-events none so the item frames keep
        the hover-grain events. THE TEXT WRAP is a SIBLING sticky
        element AFTER the stage carrying difference ITSELF (the
        nav-bar shape): sticky creates a stacking context, so a
        blend INSIDE the stage could only see the stage's own
        content — never the page ground. As its own sticky blend
        root the wrap composites against ground + images both, and
        the white ink reads BLACK over the grey exactly like the
        main navigation (Oscar's rev — was white-in-stage). */}
    <section class="sv-hero" data-sv-hero aria-label="From access to impact">
      <div class="sv-hero__stage" data-sv-hero-stage>
        <div class="sv-hero__track" data-sv-hero-track aria-hidden="true">
          {SERVICES_HERO.wave.map((item) => (
            <div
              class="sv-hero__item"
              data-sv-wave-speed={String(item.speed)}
              style={`left:${item.x}px;top:calc(100% + ${item.y}px);width:${item.w}px;height:${item.h}px`}
            >
              <img src={asset(`/assets/pillar-waves/${item.file}.jpg`)} alt="" loading="eager" decoding="async" />
            </div>
          ))}
        </div>
        <canvas class="sv-hero__canvas" data-sv-hero-canvas aria-hidden="true"></canvas>
      </div>
      <div class="sv-hero__textwrap" data-sv-hero-text>
        {/* HERO SCALE (Oscar 2026-08-26): the guide's mixed-face rule —
            serif line + sans line share 100/92; contrast is typeface
            only. Authored as two block spans (the word-reveal wrap
            handles nested atoms; the data string stays the source of
            the page title elsewhere). */}
        <h1 class="sv-hero__title" data-sv-hero-title>
          <span class="sv-hero__title-serif">FROM ACCESS</span>
          <span class="sv-hero__title-sans">TO IMPACT.</span>
        </h1>
        <p class="sv-hero__subtitle" data-sv-hero-subtitle>{SERVICES_HERO.subtitle}</p>
      </div>
    </section>

    {/* ── 2. PILLARS */}
    {SERVICES_PILLARS.map((p) => (
      <Fragment>
        {/* Full-viewport image + difference overlay texts. The frame/
            img split carries the landing hero video treatment
            (Oscar's rev): 24px band -> full-bleed clip on the FRAME,
            parallax y on the oversized IMG (services-v2.js). */}
        {/* id = the deep-link target for /landing's MORE INFO
            buttons: the section top IS the full-bleed moment (the
            clip expansion ends at 'top top'), so an anchor landing
            here shows the image with its title. */}
        <section class="sv-pillar" id={p.id} aria-label={`${p.num} — ${p.name}`}>
          <div class="sv-pillar__frame" data-sv-pillar-frame>
            <img class="sv-pillar__img" data-sv-pillar-img src={asset(p.fullImg)} alt="" loading="lazy" decoding="async" />
          </div>
          {/* Title + subtitle VERTICALLY CENTRED as a cluster
              (Oscar's rev — was the file's top-200 placement): a
              flex-centring wrapper, NO transform (a transformed
              ancestor would isolate the difference texts — the
              hero's white-text lesson); each text keeps its own
              blend. */}
          <div class="sv-pillar__text" aria-hidden="false">
            <h2 class="sv-pillar__title" data-sv-pillar-title>{p.num} — {p.name}</h2>
            <p class="sv-pillar__sub" data-sv-pillar-sub>{p.sub}</p>
          </div>
        </section>

        {/* Statement + accent bar — the case-study intro pattern
            (indent spacer atom inside the reveal wrap; the bar
            draws top-to-bottom on the same trigger). */}
        <div class="sv-intro" data-sv-intro>
          <p class="sv-intro__statement" data-sv-statement
            ><span class="sv-intro__indent" aria-hidden="true"></span>{p.statement}</p
          >
          {p.statementSub && <p class="sv-intro__sub" data-sv-statement-sub>{p.statementSub}</p>}
          <div class="sv-intro__bar" data-sv-bar aria-hidden="true"></div>
        </div>

        {/* HOVER ROWS — resting 2px dividers + /0N + Serrif item;
            hover = accent fill + white SemiBold marquee + the
            280×380 image centred on the row (services-v2.js; the
            marquee tracks are built there after fonts settle).
            Rows carry their own img field — the file's per-pillar
            image is the placeholder for every row, awaiting
            Oscar's per-row content drop. */}
        <section
          class="sv-rows"
          data-sv-rows
          style={`--sv-accent:${p.accent}`}
          aria-label={`${p.name} services`}
        >
          <p class="sv-rows__label">{p.label}</p>
          {/* Dividers are DRAWABLE elements (Oscar's rev 5 — they
              draw left-to-right one by one on entry, so borders are
              out); the endline below the list is the LAST divider,
              drawn last in the stagger (it was a static border
              before — the appeared-first bug). */}
          <ul class="sv-rows__list" data-sv-rows-list>
            {p.rows.map((row) => (
              <li
                class="sv-rows__row"
                data-sv-row
                data-index={row.index}
                data-text={row.text}
                data-img={asset(row.img ?? p.hoverImg)}
                tabindex="0"
              >
                <span class="sv-rows__divider" aria-hidden="true"></span>
                <span class="sv-rows__inner">
                  <span class="sv-rows__index">{row.index} /</span>
                  <span class="sv-rows__text">{row.text}</span>
                </span>
                <span class="sv-rows__fill" aria-hidden="true"></span>
                <span class="sv-rows__marq" data-sv-marq aria-hidden="true"></span>
                <span class="sv-rows__edges" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
          <div class="sv-rows__endline" data-sv-rows-end aria-hidden="true">
            <span class="sv-rows__divider"></span>
          </div>
          {/* Two stacked imgs (Oscar's rev 4): BASE shows the current
              row's image; OVER is the swap layer — the NEW image
              wipes in on top, then base adopts it and over hides
              (services-v2.js runner). */}
          <div class="sv-rows__img" data-sv-rows-img aria-hidden="true">
            <img data-sv-img-base src={asset(p.hoverImg)} alt="" loading="lazy" decoding="async" />
            <img data-sv-img-over src={asset(p.hoverImg)} alt="" loading="lazy" decoding="async" hidden />
          </div>
        </section>

        {/* Gallery header + tiles + flow (Immerse/Connect only —
            Amplify's gallery lives in the dark region below). */}
        {p.gallery && (
          <Fragment>
            <div class="sv-galhead" data-sv-galhead>
              <h3 class="sv-galhead__title" data-sv-galhead-title>
                {p.galleryTitle.map((line) => (
                  <span class="sv-galhead__line">{line}</span>
                ))}
              </h3>
              {p.galleryNote && (
                <p class="sv-galhead__note" data-sv-galhead-note
                  ><span class="sv-galhead__note-serrif">{p.galleryNote.serrif}</span><br />{p.galleryNote.bold}</p
                >
              )}
            </div>
            <div class="sv-gallery" data-sv-gallery>
              {p.gallery.map((src) => (
                <figure class="sv-gallery__tile" data-sv-tile>
                  <img src={asset(src)} alt="" loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
            <div class="sv-flow" data-sv-flow>
              {p.flow.map((block, i) => (
                <Fragment>
                  {i > 0 && (
                    <span class="sv-flow__arrow" aria-hidden="true">
                      <img src={asset('/assets/landing/services/flow-arrow.svg')} alt="" width="16" height="32" />
                    </span>
                  )}
                  <span class="sv-flow__block" data-sv-flow-block>
                    {block.map((line) => (
                      <span class="sv-flow__line">{line}</span>
                    ))}
                  </span>
                </Fragment>
              ))}
            </div>
          </Fragment>
        )}
      </Fragment>
    ))}

    {/* ── 3. GROUND-FADE RUNWAY — 500px, the landing constant; the
        scrub completes exactly as the access statement's top
        reaches the viewport bottom (services-v2.js). */}
    <div class="sv-fade-runway" data-sv-fade-runway aria-hidden="true"></div>

    {/* ── 4. WE CREATE ACCESS (dark) + Amplify's gallery + toggles */}
    <div class="sv-access" data-sv-access>
      <p class="sv-access__statement" data-sv-access-statement
        ><span class="sv-intro__indent" aria-hidden="true"></span>{SERVICES_ACCESS.statement}</p
      >
      <p class="sv-access__note" data-sv-access-note>{SERVICES_ACCESS.note}</p>
      <div class="sv-gallery sv-gallery--dark" data-sv-gallery>
        {SERVICES_ACCESS.gallery.map((src) => (
          <figure class="sv-gallery__tile" data-sv-tile>
            <img src={asset(src)} alt="" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
      <div class="sv-toggles" data-sv-toggles>
        {SERVICES_ACCESS.toggles.map((pair) => (
          <span class="sv-toggles__pair" data-sv-toggle>
            <span>{pair[0]}</span>
            <img src={asset('/assets/landing/services/toggle-arrows-a.svg')} alt="" width="24" height="12" />
            <span>{pair[1]}</span>
          </span>
        ))}
      </div>
    </div>

    {/* ── OUR NETWORK — the landing component (shared; landing
        untouched — no prop there). entry="prev-exit" fires its
        entrance THE MOMENT the access block above is fully out of
        the viewport (Oscar's rev 6), measured, not hardcoded. */}
    <LandingNetwork entry="prev-exit" />
  </main>

  {/* ── 5. FOOTER — shared structure/behaviour, the LIGHT theme
      (the page's extracted colourway). The landing sticky-reveal
      schema applies (landing-v2, not work-page); main carries the
      z260 content gate. */}
  <LandingFooter theme="light" />
  <div class="landing-footer-spacer" aria-hidden="true"></div>
</SiteShell>

<script>
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initLandingNetwork } from '../scripts/landing/landing-network.js';
  import { initServicesV2 } from '../scripts/landing/services-v2.js';

  let cleanupCharRipple = initCharRipple();
  let cleanupNavEntrance = initNavEntrance();
  let cleanupServices = initServicesV2();
  let cleanupNetwork = initLandingNetwork();

  document.addEventListener('astro:before-swap', () => {
    cleanupCharRipple();
    cleanupNavEntrance();
    cleanupServices();
    cleanupNetwork();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCharRipple = initCharRipple();
    cleanupNavEntrance = initNavEntrance();
    cleanupServices = initServicesV2();
    cleanupNetwork = initLandingNetwork();
  });
</script>
