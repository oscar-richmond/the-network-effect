---
/**
 * /work/[slug] — CASE STUDY template (Figma 32:3306, extracted
 * 2026-08-07; the frame's 118px chrome — 35px #161616 top bar +
 * 83px browser toolbar, both mockup context — subtracted).
 * First instance: /work/yoxman-food-festival.
 *
 * EVERYTHING DATA-DRIVEN: static paths + all content from
 * src/data/landing/case-studies.js (which references featured-work
 * as the single source of truth for titles/slugs/indexes/tags).
 * The client's remaining studies land as pure data drops.
 *
 * NATIVE document scroll through Lenis (case-study.js boots it —
 * the landing's config verbatim); the sticky rail is native
 * position:sticky, proven under this Lenis by /landing's own
 * sticky stages. Chrome via the shared SiteShell; footer is the
 * shared LandingFooter (flow-neutralised, same as /work).
 *
 * ═══ ALL COPY IS PLACEHOLDER ═══ pending the client's real
 * account — flags live with the data. RIGHTS: Instagram-sourced
 * imagery, elevated confirmation class — see case-studies.js.
 *
 * STAGING ONLY — same rule as /landing: nothing here is promoted
 * anywhere until Oscar says so.
 */
import SiteShell from '../../layouts/SiteShell.astro';
import LandingFooter from '../../components/landing/LandingFooter.astro';
import CtaChip from '../../components/landing/CtaChip.astro';
import { START_PROJECT_MODAL, START_PROJECT_MAILTO } from '../../data/flags.js';
import { asset } from '../../utils/asset.js';
import { CASE_STUDIES, LIVE_CASE_SLUGS } from '../../data/landing/case-studies.js';
import { WORK_PROJECTS } from '../../data/landing/featured-work.js';
import '../../styles/home.css';
import '../../styles/landing/landing.css';
import '../../styles/landing/case-study.css';
import '../../styles/fonts.css';

export function getStaticPaths() {
  return CASE_STUDIES.map((study) => ({
    params: { slug: study.base.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const title = study.base.title.join(' ');
/* MORE WORK (Oscar's rev): every /work project except this study,
   in the landing order, with the /work page's images/descriptions. */
const moreWork = WORK_PROJECTS.filter((p) => p.slug !== study.base.slug).map((p) => ({
  ...p,
  live: LIVE_CASE_SLUGS.includes(p.slug),
}));
/* The LET'S CHAT arrow path (SiteShell's inline asset) — reused for
   the pager, rotated to point left/right (Oscar's rev). */
const ARROW_PATH = 'M44.3693 300L22.9417 277.21L1.51425 255.783L208.333 53.788H5.41863e-06L0 0H300V300H246.212V91.6667L44.3693 300Z';
---

<SiteShell title={`${title} — The Network Effect`} bodyClass="landing-v2 case-page">
  <main class="cs" data-case-study data-live-slugs={LIVE_CASE_SLUGS.join(',')} id="main" tabindex="-1">
    {/* ── A. HERO (frame 36:1827, rebuilt 2026-08-26): the title is
        plain ink at the display scale, above the 1680×980 margined
        image — the frame carries NO SUBTITLE, so the subtitle is
        MOBILE-ONLY now (the separate mobile build keeps its shipped
        composition; the field stays in the data). The old white+
        difference treatment is retired with the overlap that
        motivated it — one less blended chain. */}
    <header class="cs-hero">
      <h1 class="cs-hero__title" data-cs-hero-title>{title}</h1>
      <p class="cs-hero__subtitle" data-cs-hero-subtitle>{study.subtitle}</p>
      <figure class="cs-hero__img" data-cs-hero-img>
        <img src={study.heroImg} alt={`${title} — hero image`} decoding="async" />
      </figure>
    </header>

    {/* ── B. INTRO STATEMENT + the red accent bar (the holding-page
        motif). The leading indent is an inline spacer element — the
        footer-statement precedent (text-indent breaks the reveal
        wrap's line grouping). */}
    <section class="cs-intro" aria-label="Introduction">
      <p class="cs-intro__statement" data-cs-intro
        ><span class="cs-intro__indent" aria-hidden="true"></span>{study.intro}</p
      >
      <div class="cs-intro__bar" data-cs-bar aria-hidden="true"></div>
    </section>

    {/* ── THE FACTS SECTION (frame 36:1827, 2026-08-26) — DESKTOP
        ONLY (the mobile build keeps its shipped what-we-did/rail
        composition below the seam). A 12/14 label + the our-work
        paragraph on the 864 column, then the FOUR-ROW TABLE at the
        frame's fixed geometry (dividers 0/106/184/290/396; labels
        x840-rel, copy x1244-rel). Content per study from
        study.facts — PLACEHOLDER, derived (see case-studies.js). */}
    <section class="cs-facts" aria-label="Project summary" data-cs-facts>
      <div class="cs-facts__head">
        {/* FLAG: the frame's 121×14 label text is unextractable
            (see the build report) — "OUR WORK" carries the section
            identity, pending confirmation. */}
        <h2 class="cs-facts__label" data-cs-facts-line>OUR WORK</h2>
        <p class="cs-facts__para" data-cs-facts-line>{study.ourWork.desc}</p>
      </div>
      <div class="cs-facts__table" data-cs-facts-table>
        {study.facts.map((row, ri) => (
          <div class={`cs-facts__row cs-facts__row--${ri + 1}`} data-cs-fact-row>
            <h3 class="cs-facts__rowlabel" data-cs-fact-line>{row.label}</h3>
            <p class="cs-facts__rowcopy" data-cs-fact-line>{row.copy}</p>
          </div>
        ))}
        {[0, 106, 184, 290, 396].map((y) => (
          <div class="cs-facts__divider" style={`top:${y}px`} aria-hidden="true"></div>
        ))}
      </div>
    </section>

    {/* ── C. WHAT WE DID — MOBILE-ONLY since the 36:1827 rebuild
        (the desktop frame replaces it with the facts table above;
        display:none ≥1025 in case-study.css — the mobile build is a
        separate composition, out of the rebuild's scope). */}
    {/* data-m-carousel / data-carousel-strip / the indicator (mobile
        rebuild 2026-08-13): the columns swipe horizontally on mobile
        with the shared 100px indicator (carousel-indicator.js). */}
    <section class="cs-did" aria-label="What we did" data-cs-did data-m-carousel>
      <h2 class="cs-did__label" data-cs-did-line>WHAT WE DID</h2>
      <span class="m-carousel-ind" data-carousel-ind aria-hidden="true">
        <span class="m-carousel-ind__thumb" data-carousel-thumb></span>
      </span>
      {/* A real flex ROW (Oscar's rev): the columns used to be three
          absolutely-positioned lefts (1083/1292/1515), so any item
          wider than the gap between them overlapped its neighbour —
          "Health & Wellbeing Retreats" into "Commercial Management".
          Now they share the row with a guaranteed 24px gutter. */}
      <div class="cs-did__cols" data-carousel-strip>
      {['immerse', 'connect', 'amplify'].map((pillar, c) => (
        <div class={`cs-did__col cs-did__col--${c + 1}`}>
          <h3 class="cs-did__pillar" data-cs-did-line data-cs-col={String(c)}>{pillar.toUpperCase()}</h3>
          <ul class="cs-did__list">
            {(study.whatWeDid[pillar] ?? []).map((item) => (
              <li data-cs-did-line data-cs-col={String(c)}>{item}</li>
            ))}
          </ul>
        </div>
      ))}
      </div>
    </section>

    <div class="cs-divider" aria-hidden="true"></div>

    {/* ── D. THE IMAGE STREAM (36:1827: full-measure rows on the
        12.27 gap — the row grammar lives in the data). THE STICKY
        RAIL IS RETIRED ON DESKTOP (the frame has no rail — the
        facts section above carries its content): the two rail segs
        below are MOBILE-ONLY markup now (display:none ≥1025; the
        mobile build's flow-interleaved composition keeps rendering
        railBlocks + ourWork.desc verbatim). The desktop pin/cover
        machinery is REMOVED from case-study.js and the sticky
        geometry from case-study.css — not hidden, gone. */}
    <section class="cs-work" aria-label="Our work" data-cs-work>
      <div class="cs-rail-seg cs-rail-seg--1">
        <div class="cs-rail-sticky" data-cs-rail>
          <h2 class="cs-rail__label"><span class="cs-serrif">OUR</span> WORK</h2>
          <p class="cs-rail__desc">{study.ourWork.desc}</p>
        </div>
      </div>
      <div class="cs-rail-seg cs-rail-seg--2">
        <div class="cs-rail-sticky" data-cs-rail>
          {/* One or more labelled bullet blocks (Oscar's rev): most
              studies carry a single KEY IMPACT list; Pavilion Summit
              carries FEATURED SPEAKERS + SCOPE. Data-driven so a new
              study stays a pure data drop. */}
          {study.railBlocks.map((block, bi) => (
            <Fragment>
              <h2 class="cs-rail__label" style={bi > 0 ? 'margin-top:40px' : undefined}>
                <span class="cs-serrif">{block.serrif}</span> {block.rest}
              </h2>
              <ul class="cs-rail__bullets">
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </Fragment>
          ))}
        </div>
      </div>
      {study.ourWork.stream.map((row, r) => (
        <div
          class={`cs-row cs-row--${row.layout}${row.layout === 'pair' && !row.narrowFirst ? ' cs-row--wide-first' : ''}${r >= 3 ? ' cs-row--s2' : ''}`}
          data-cs-row
        >
          {row.imgs.map((src, i) => (
            /* `row.framing` (optional, per image): the crop anchor for
               that slot. Default is the CSS centre crop; 'top' frames
               from the top edge down, which is what portraits-in-a-
               landscape-slot need so heads aren't cut (Oscar's report
               on Pavilion Summit). */
            <figure
              class="cs-row__img"
              data-cs-lb-item
              style={row.framing?.[i] ? `--cs-img-pos:${row.framing[i]}` : undefined}
              tabindex="0"
              role="button"
              aria-label={`Open image ${study.ourWork.stream.slice(0, r).reduce((n, x) => n + x.imgs.length, 0) + i + 1} in the gallery`}
            >
              {src.endsWith('.mp4') || src.endsWith('.webm') ? (
                /* Video rows (Oscar's rev): autoplay requires muted;
                   playsinline for iOS; looped. NOTE: the current
                   build's stream is ALL stills (the file's exports) —
                   this renders the moment a video lands in the data. */
                <video src={src} autoplay muted loop playsinline></video>
              ) : (
                <img src={src} alt="" loading={r === 0 ? 'eager' : 'lazy'} decoding="async" />
              )}
            </figure>
          ))}
        </div>
      ))}
    </section>

    {/* ── E. MORE WORK — a functional horizontal pager over EVERY
        /work project bar this one (Oscar's rev), indexes/copy from
        the single source. Arrows = the LET'S CHAT arrow rotated to
        point left/right, rippling on hover when active
        (case-study.js). */}
    <div class="cs-divider" aria-hidden="true"></div>
    <section class="cs-more" aria-label="More work" data-cs-more data-m-carousel>
      {/* Mixed faces (Oscar's rev): WORK in Serrif Medium, same size
          — the OUR WORK / KEY IMPACT rail treatment. The MORE span
          (mobile rebuild) is inline and byte-neutral on desktop; on
          mobile the file stacks the words (MORE indented 37, the
          landing stacked-header grammar mirrored). */}
      <h2 class="cs-more__title" data-cs-more-title><span class="cs-more__t1">MORE</span> <span class="cs-serrif">WORK</span></h2>
      {/* Mobile-only VIEW ALL chip (file 7:121) — the /work page's
          own affordance replaces the desktop pager below the seam. */}
      <a class="cs-more__viewall" href="/work" data-char-ripple-trigger>
        <span data-char-ripple>VIEW ALL</span>
        <img src={asset('/assets/landing/services-stack/more-arrow.svg')} alt="" width="9" height="9" data-char-ripple-arrow />
      </a>
      <div class="cs-more__pager">
        <button type="button" class="cs-more__arrow" data-cs-pager="prev" aria-label="Previous projects" disabled>
          <svg class="cs-more__arrow-svg cs-more__arrow-svg--left" viewBox="0 0 300 300" aria-hidden="true" data-char-ripple-arrow xmlns="http://www.w3.org/2000/svg">
            <path d={ARROW_PATH} fill="currentColor" />
          </svg>
        </button>
        <button type="button" class="cs-more__arrow" data-cs-pager="next" aria-label="Next projects">
          <svg class="cs-more__arrow-svg cs-more__arrow-svg--right" viewBox="0 0 300 300" aria-hidden="true" data-char-ripple-arrow xmlns="http://www.w3.org/2000/svg">
            <path d={ARROW_PATH} fill="currentColor" />
          </svg>
        </button>
      </div>
      <div class="cs-more__viewport" data-cs-more-viewport data-carousel-strip>
        <div class="cs-more__track" data-cs-more-track>
          {moreWork.map((m) => (
            m.live ? (
            <a
              class="cs-more__card"
              href={`/work/${m.slug}`}
              data-cs-more-card
              data-slug={m.slug}
              data-live="true"
            >
              <figure class="cs-more__imgwin">
                <img src={m.workImg} alt="" loading="lazy" decoding="async" />
              </figure>
              <span class="cs-more__cardrow">
                <span class="cs-more__cardtitle" data-cs-card-title>{m.title.join(' ')}</span>
                <span class="cs-more__cardindex">{m.index}</span>
              </span>
              <span class="cs-more__carddesc">{m.desc}</span>
            </a>
            ) : (
            <span
              class="cs-more__card is-placeholder"
              data-cs-more-card
              data-slug={m.slug}
              data-live="false"
              data-a4-note="unbuilt study: inert placeholder — no href, unfocusable"
            >
              <figure class="cs-more__imgwin">
                <img src={m.workImg} alt="" loading="lazy" decoding="async" />
              </figure>
              <span class="cs-more__cardrow">
                <span class="cs-more__cardtitle" data-cs-card-title>{m.title.join(' ')}</span>
                <span class="cs-more__cardindex">{m.index}</span>
              </span>
              <span class="cs-more__carddesc">{m.desc}</span>
            </span>
            )
          ))}
        </div>
      </div>
      <div class="cs-more__fade" aria-hidden="true"></div>
      {/* Mobile swipe indicator — the file's 200×1 (7:118). */}
      <span class="m-carousel-ind m-carousel-ind--wide" data-carousel-ind aria-hidden="true">
        <span class="m-carousel-ind__thumb" data-carousel-thumb></span>
      </span>
    </section>
  </main>

  {/* Gallery cursor (Oscar's rev): hovering the OUR WORK stream
      images swaps the site dot for this label — a TOP-LEVEL FIXED
      element carrying difference ITSELF (the /work cursor shape:
      fixed always creates a stacking context, so it must BE the
      blend element, positioned via left/top, never transform).
      aria-hidden: decoration; case-study.js gates + drives it. */}
  <div class="cs-gallery-cursor" data-cs-gallery-cursor aria-hidden="true">( VIEW GALLERY + )</div>

  {/* ── FLOATING CTA (R37, Oscar 2026-09-04): the template's fixed
      START A PROJECT chip (CtaChip `float`), 40/40 from the right and
      bottom edges — hidden at the top, in from the first scroll, out
      once the stream's last image has fully entered (float-cta.js,
      driven from case-study.js; hidden while the lightbox is open).
      DESTINATION (R40): the site-wide START A PROJECT form modal — one
      behaviour everywhere; the href is the modal's deep link. R41: while
      the modal is off (any build) it is the live mailto, as built. */}
  <div class="cs-float" data-cs-float>
    <CtaChip variant="float" href={START_PROJECT_MODAL ? '#start-project' : START_PROJECT_MAILTO} label="START A PROJECT" data-cs-float-cta data-start-project={START_PROJECT_MODAL ? '' : undefined} />
  </div>

  {/* ── LIGHTBOX (Oscar's rev): click any stream image -> centred
      pop-up over a frosted backdrop (the page grey at 50% over a
      Figma-80 background blur), CTA-family arrows left/right,
      CTA close; arrows/Escape on the keyboard and wheel steps
      navigate the whole stream. case-study.js drives it. */}
  <div class="cs-lightbox" data-cs-lightbox role="dialog" aria-modal="true" aria-label="Project gallery" hidden>
    <div class="cs-lightbox__backdrop" data-cs-lb-close aria-hidden="true"></div>
    <figure class="cs-lightbox__stage" data-cs-lb-stage>
      <img class="cs-lightbox__media" data-cs-lb-img src="" alt="" hidden />
      <video class="cs-lightbox__media" data-cs-lb-video muted loop playsinline hidden></video>
    </figure>
    {/* data-char-ripple-arrow (audit follow-up): these are the SAME
        icon button as the MORE WORK pager above, drawn from the same
        ARROW_PATH with the same svg class — but they carried no
        hover affordance at all while their twin ripples. The attr is
        inert markup; case-study.js wires the replay for both pairs. */}
    <button type="button" class="cs-lightbox__arrow cs-lightbox__arrow--prev" data-cs-lb-prev aria-label="Previous image">
      <svg class="cs-more__arrow-svg cs-more__arrow-svg--left" viewBox="0 0 300 300" aria-hidden="true" data-char-ripple-arrow xmlns="http://www.w3.org/2000/svg">
        <path d={ARROW_PATH} fill="currentColor" />
      </svg>
    </button>
    <button type="button" class="cs-lightbox__arrow cs-lightbox__arrow--next" data-cs-lb-next aria-label="Next image">
      <svg class="cs-more__arrow-svg cs-more__arrow-svg--right" viewBox="0 0 300 300" aria-hidden="true" data-char-ripple-arrow xmlns="http://www.w3.org/2000/svg">
        <path d={ARROW_PATH} fill="currentColor" />
      </svg>
    </button>
    {/* CLOSE — the primary-CTA pill (Oscar's rev), ripple-wired. */}
    <button type="button" class="cs-lightbox__closebtn" data-cs-lb-close-btn data-char-ripple-trigger aria-label="Close gallery">
      <span data-char-ripple>CLOSE</span>
    </button>
  </div>

  {/* ── F. FOOTER — the landing parallax reveal, natively (Oscar's
      rev: the same footer reveal on every page): the footer pins
      BEHIND the z260 content above (landing.css carries the whole
      mechanism) and the spacer restores the document height so the
      page ends at full reveal — the landing pattern verbatim. */}
  <LandingFooter theme="light" />
  <div class="landing-footer-spacer" aria-hidden="true"></div>
</SiteShell>

<script>
  import { initCharRipple } from '../../scripts/char-ripple.js';
  import { initNavEntrance } from '../../scripts/landing/nav-motion.js';
  import { initCaseStudy } from '../../scripts/landing/case-study.js';

  let cleanupCharRipple = initCharRipple();
  let cleanupNavEntrance = initNavEntrance();
  let cleanupCaseStudy = initCaseStudy();

  document.addEventListener('astro:before-swap', () => {
    cleanupCharRipple();
    cleanupNavEntrance();
    cleanupCaseStudy();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCharRipple = initCharRipple();
    cleanupNavEntrance = initNavEntrance();
    cleanupCaseStudy = initCaseStudy();
  });
</script>
