---
import { ARCHIVE_ROUTES } from '../../data/flags.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutScroll from '../../components/about-3/AboutScroll.astro';
import SectionProgress from '../../components/about-3/SectionProgress.astro';
import Menu from '../../components/Menu.astro';
import '../../styles/home.css';
import '../../styles/about-3/about-page.css';
import '../../styles/fonts.css';

/* Page-weight batch item 1 (Oscar, 2026-09-04): THE ARCHIVE IS OUT OF THE
   PRODUCTION BUILD. This is the parked pre-rebuild site — viewable during
   development, not part of the launched site. It renders under
   `astro dev` and a build emits no route for it, using the same
   empty-getStaticPaths gate the dev-only splash variant uses (a plain
   page cannot opt out of a static build; a rest route with no paths
   can). The URL is unchanged.
   The HOLDING pages are NOT affected: they are real deploy targets,
   still built, and still served on the launch domain by the edge
   middleware.
   MEASURED SCOPE, reported honestly: this removes the archive's HTML and
   its JS/CSS bundles from dist. It does NOT shrink dist by the archive's
   images — everything under public/ is copied verbatim whether a route
   references it or not, so unreferenced media is a separate item (5).
   PUBLIC_ARCHIVE=1 builds it anyway. */
export function getStaticPaths() {
  return ARCHIVE_ROUTES ? [{ params: { slug: undefined } }] : [];
}
---

<!-- ARCHIVED FULL SITE (/old) — this file WAS src/pages/index.astro and
     is unchanged in content; only its route moved. The in-progress
     full-site build is parked here so it stays viewable during the
     rebuild, while the root now serves the holding page (Oscar's
     Option A). New development starts fresh at /landing, NOT on top
     of this.

     Originally the /about-3 page, moved to root by the root-landing
     work, verbatim — body class, modules, and all scoping unchanged,
     no splash component. Its own "loading" treatment stands as it
     always did: the CSS spinner/veil (about-page.css's .loading rule)
     until AboutHero.astro clears the class and runs its own
     image-stack entrance timeline. -->
<BaseLayout title="The Network Effect" bodyClass="about-page-3 loading" htmlClass="js">
  <header class="home__topbar home__topbar--about">
    <nav class="home__menu-cta" aria-label="Site">
      <button
        type="button"
        class="home__menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span data-menu-label-menu>menu</span>
        <span class="home__menu-toggle-label--close" data-menu-label-close aria-hidden="true">
          <span class="home__menu-toggle-close-text">close</span>
          <span class="home__menu-toggle-x" data-menu-toggle-x aria-hidden="true">×</span>
        </span>
      </button>
    </nav>
    <h1 class="home__logo">THE NETWORK EFFECT</h1>
    <a class="home__topbar-email" href="mailto:hello@networkeffectagency.co.uk">
      hello@networkeffectagency.co.uk
    </a>
  </header>

  <AboutScroll />
  <SectionProgress />
  <Menu />

  <!-- Film-grain overlay — a childless, pointer-events:none SIBLING at
       the very top of the paint order (z 9000: above every stage/nav/
       loader, below only the canvas cursor at 9999 so the cursor stays
       crisp). It wraps nothing and blends nothing — see the stacking/
       blend-safety notes on .about-grain in about-page.css. -->
  <div class="about-grain" aria-hidden="true"></div>
</BaseLayout>
