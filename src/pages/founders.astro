---
/**
 * /founders — the NEW BUILD's founders page (Figma 73:5519 "The
 * Founders — Slide 2", extracted 2026-08-08; 83px chrome
 * subtracted; Chrome mockup frames ignored). NO SLIDE 1 FRAME
 * EXISTS in the file — slide 1 is the same template with Robbo's
 * imagery + flagged placeholder copy (see founders-page.js).
 *
 * A TWO-SLIDE, FIXED-VIEWPORT scroll experience (the /work driver
 * lineage — founders-page.js): one virtual progress axis through
 * phases: P1 Robbo's name travels DOWN the portrait (top at the
 * image's live centre → bottom 40px above its live bottom, layout
 * `top` never transform — the name is difference-blended); P2 the
 * slide transition (text out/in staggered blur-fade, portrait
 * blur-crossfade, indicator label travels 64px + 01→02 roll,
 * boundary-snapped); P3 Ashley's travel; P4 release (content up
 * to 180px below the image, then the /work footer-reveal grammar
 * over the fixed footer wrap).
 *
 * BLEND WALK: the names are #F9F9F9 + difference; their chain
 * (stage > slide > name) carries no transform/opacity/filter —
 * the portrait layers are earlier SIBLINGS (the crossfade rides
 * them, never an ancestor). The stage is the /work fixed-viewport
 * shape.
 *
 * MOBILE (≤1024 — Figma cqJWAceQKUmyuhF1ZxYXLI frame 13:948
 * "iPhone 16 & 17 Pro - 5", 2026-08-14 rev 2; supersedes the 6:10
 * stacked build): NONE of the above exists — normal document
 * scroll, ONE founder profile shown at a time (Ashley lands first,
 * per the file). Switching happens via the thumb band riding a
 * sticky rail inside the first portrait (the images ARE the CTAs;
 * active carries the desktop indicator's 3px #232A89 stroke — see
 * the band comment in the markup for the pin grammar) or the name
 * chip beside FEATURED WORK — each swap replays the entrance
 * vocabulary. Mobile-only
 * anatomy (label/portrait/Serrif statement/second image/swap chip)
 * is desktop-hidden; see founders.css's mobile block +
 * founders-page.js's narrow branch.
 *
 * IMAGERY pending founder sign-off. STAGING ONLY.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { FOUNDERS_SLIDES, FOUNDERS_CTA } from '../data/landing/founders-page.js';
import { asset } from '../utils/asset.js';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/landing/founders.css';
import '../styles/fonts.css';
---

<SiteShell title="The Founders — The Network Effect" bodyClass="landing-v2 founders-page">
  <main class="fd-stage" data-founders-stage aria-label="The founders">
    {/* THE CONTENT WRAPPER (Oscar's rev 2): carries its OWN opaque
        ground so the difference names blend correctly at rest AND
        while the release translates it (a transformed ancestor
        isolates blends — with an opaque ground inside the group the
        difference stays correct everywhere; the white-name bug's
        fix). The release rides THIS up (white gap grows below the
        portrait); only the footer reveal rides the stage. */}
    <div class="fd-content" data-fd-content>
    {/* ── Indicator — thumbs 80×48 (16 gap) at (40,144); the label
        + divider travel beside the active thumb (founders-page.js
        scrubs the 64px); active thumb carries the 3px #232A89
        stroke. Thumbs drive the slides. */}
    <div class="fd-ind" data-fd-ind>
      <div class="fd-ind__thumbs">
        {FOUNDERS_SLIDES.map((slide, i) => (
          <button
            type="button"
            class="fd-ind__thumb"
            data-fd-thumb
            data-slide={String(i)}
            aria-current={i === 0 ? 'true' : 'false'}
            aria-label={`Go to founder ${slide.number}: ${slide.name}`}
          >
            <img src={asset(slide.img)} alt="" loading="eager" decoding="async" />
          </button>
        ))}
      </div>
      <div class="fd-ind__labelrow" data-fd-labelrow>
        <span class="fd-ind__divider" aria-hidden="true"></span>
        <span class="fd-ind__label" data-fd-label>
          <span class="fd-ind__label-line" data-fd-label-a>/ 01 Founder</span>
          <span class="fd-ind__label-line" data-fd-label-b aria-hidden="true">/ 02 Founder</span>
        </span>
      </div>
    </div>

    {/* ── Portrait (frame 6:67, 2026-08-26): 630×841 flush to the
        LEFT viewport edge at y80. The crossfade pair became a WIPE
        pair — the case-study lightbox's two-phase L→R wipe, ported
        scrub-natively (founders-page.js applyWipe): A wipes OUT to
        the bare ground over the transition's first half, B wipes IN
        over the second. Slot 0 of the five-image sync group. */}
    <div class="fd-portrait" data-fd-portrait aria-hidden="true">
      <div class="fd-wipe" data-fd-wipe data-wipe-i="0">
        <img class="fd-wipe__img fd-wipe__img--a" src={asset(FOUNDERS_SLIDES[0].img)} alt="" loading="eager" decoding="async" />
        <img class="fd-wipe__img fd-wipe__img--b" src={asset(FOUNDERS_SLIDES[1].img)} alt="" loading="eager" decoding="async" />
      </div>
    </div>

    {/* ── RIGHT IMAGE COLUMN (frame 6:102): four 240×204.4 windows
        on 8px gaps at (1464, 80). Each is a wipe slot in the same
        sync group (stagger indexes 1..4 — the portrait leads, the
        column cascades). Per-founder image ORDER comes from data
        (Ashley = reversed, flagged). */}
    <div class="fd-col" aria-hidden="true">
      {FOUNDERS_SLIDES[0].colImgs.map((src, i) => (
        <div class="fd-col__slot fd-wipe" data-fd-wipe data-wipe-i={String(i + 1)}>
          <img class="fd-wipe__img fd-wipe__img--a" src={asset(src)} alt="" loading="eager" decoding="async" />
          <img class="fd-wipe__img fd-wipe__img--b" src={asset(FOUNDERS_SLIDES[1].colImgs[i])} alt="" loading="eager" decoding="async" />
        </div>
      ))}
    </div>

    {/* ── Slides' text (bio, button, list) + the travelling name. */}
    {FOUNDERS_SLIDES.map((slide, i) => (
      <div class="fd-slide" data-fd-slide data-slide={String(i)} data-active={i === 0 ? 'true' : 'false'} data-m-active={i === 1 ? 'true' : 'false'}>
        {/* MOBILE-ONLY anatomy (Figma cqJWAceQKUmyuhF1ZxYXLI frame
            13:948, 2026-08-14 rev 2): the centred name label, the
            per-slide portrait, the Serrif statement, the second
            image and the swap chip are mobile elements —
            display:none above the seam (founders.css), no
            data-fd-el, so the desktop driver and its stagger order
            never see them. Mobile shows ONE slide at a time
            (data-m-active — desktop ignores it; SSR lands Ashley,
            the file's landing state) and sequences elements with
            flex order (label → bio → portrait → statement → image
            2 → list → CTA row); the DOM keeps the desktop's order. */}
        <h2 class="fd-slide__m-label">{slide.name}</h2>
        {/* Portrait + the NAME LABELS (Oscar's rev 4, 2026-08-14):
            the difference labels live INSIDE the portrait and ride
            sticky rails — starting 24px under the image top,
            PINNING at the viewport middle while scrolling through,
            and parking 24px above the image bottom — fully
            reversible, native position:sticky (no scroll JS).
            BAKED per slide: the founder's NAME always left,
            "Founder 0N" (the data numbering — Robbo 01, Ashley 02)
            always right. Separate rails so each blended label
            carries sticky+blend on ITSELF (an isolating wrapper
            would white them out — but note the img shares any
            ancestor group, so entrance isolation is harmless: the
            blend backdrop is the img either way). The face thumbs
            are SEPARATE — the fixed dock below the slides. */}
        <figure class="fd-slide__m-portrait">
          <img src={asset(slide.img)} alt="" aria-hidden="true" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          <div class="fd-m-rail fd-m-rail--label" aria-hidden="true">
            <span class="fd-m-switch-label fd-m-switch-label--l">{slide.name}</span>
          </div>
          <div class="fd-m-rail fd-m-rail--label" aria-hidden="true">
            <span class="fd-m-switch-label fd-m-switch-label--r">Founder {slide.number}</span>
          </div>
        </figure>
        {/* ── FRAME 6:67 DESKTOP TEXT BLOCK (2026-08-26): role line
            (710,245), STATIC name 48/50 (710,287 — the frame's
            treatment; the travelling difference name still runs,
            flagged as a duplicate pending Oscar's ruling), bio
            paragraphs (710,361), relationships label + three
            sentence-case rows (790,608..). All join the slide
            transition stagger (data-fd-el); hidden ≤1024. */}
        <p class="fd-slide__role" data-fd-el>{slide.roleLine}</p>
        <h3 class="fd-slide__staticname" data-fd-el>{slide.name}</h3>
        <div class="fd-slide__bio2" data-fd-el>
          {slide.bioParas.map((para) => (
            <p class="fd-slide__bio2-para">{para}</p>
          ))}
        </div>
        <div class="fd-slide__rel" data-fd-el>
          <p class="fd-slide__rel-label">{slide.relLabel}</p>
          {slide.relRows.map((row) => (
            <p class="fd-slide__rel-row">
              {row.map((item) => (
                <Fragment><span class="fd-slide__rel-item">{item}</span><span class="fd-slide__rel-sep" aria-hidden="true">{' / '}</span></Fragment>
              ))}
            </p>
          ))}
        </div>
        {/* Bio — bold block + Serrif block with the 24px gap
            (Oscar's rev 2; was a continuous flow). MOBILE-ONLY now
            (frame 6:67 replaced the desktop bio; ≥1025 hidden, no
            data-fd-el so the desktop stagger never sees it). */}
        <div class="fd-slide__bio">
          <p class="fd-slide__bio-text fd-slide__bio-text--bold"
            ><span class="fd-slide__bio-indent" aria-hidden="true"></span>{slide.bioBold}</p
          >
          <p class="fd-slide__bio-text fd-slide__bio-text--serrif">{slide.bioSerrif}</p>
        </div>
        {/* CTA row — desktop renders the wrapper as display:contents
            (the button's absolute anchoring is untouched); mobile
            lays FEATURED WORK + the swap chip as the file's 16px-gap
            row. The chip carries the OTHER founder's name and swaps
            the profile (founders-page.js narrow branch). */}
        <div class="fd-slide__m-ctarow">
          <a class="fd-slide__btn" data-fd-el href={FOUNDERS_CTA.href} data-char-ripple-trigger tabindex={i === 0 ? undefined : -1}>
            <span data-char-ripple>{FOUNDERS_CTA.label}</span>
            <img src={asset('/assets/landing/contact/cta-arrow.svg')} alt="" width="12" height="12" data-char-ripple-arrow />
          </a>
          <button
            type="button"
            class="fd-slide__m-swapbtn"
            data-fd-m-swap
            data-target={String((i + 1) % FOUNDERS_SLIDES.length)}
            aria-label={`View founder: ${FOUNDERS_SLIDES[(i + 1) % FOUNDERS_SLIDES.length].name}`}
          >
            <span>{FOUNDERS_SLIDES[(i + 1) % FOUNDERS_SLIDES.length].name}</span>
            <img src={asset('/assets/landing/contact/cta-arrow.svg')} alt="" width="9" height="9" />
          </button>
        </div>
        {/* MOBILE-ONLY now (≥1025 hidden — the frame's relationships
            rows replace these on desktop; the approved indexed list
            stays the mobile rendering). */}
        <p class="fd-slide__listlabel">{slide.listLabel}</p>
        <p class="fd-slide__list">
          {slide.list.map((item, j) => (
            <Fragment>
              {/* Mobile wraps the list NATURALLY (the file's wrap
                  grammar) — the desktop's authored breaks become
                  plain separators there: the --m sep is desktop-
                  hidden (base CSS), the <br>s are mobile-hidden. */}
              {/* The sep's LEADING spaces are no-break (a line may
                  END with a slash — the file's line 2 — but never
                  START with one); the FINAL char is a normal space
                  so mobile (white-space lifted) can break after it.
                  NBSP advances = space advances and desktop keeps
                  pre, so the desktop render is untouched. */}
              {j > 0 && slide.list[j - 1].breakAfter && (
                <Fragment>
                  <span class="fd-slide__list-sep fd-slide__list-sep--m" aria-hidden="true">{'\u00A0\u00A0/\u00A0 '}</span>
                  <br />
                </Fragment>
              )}
              {j > 0 && !slide.list[j - 1].breakAfter && (
                <span class="fd-slide__list-sep" aria-hidden="true">{'\u00A0\u00A0/\u00A0 '}</span>
              )}
              {/* An item's text may carry its OWN break (\n) — one
                  item, one index, split across two lines with the
                  index after the last word (Oscar's rev 5:
                  "INDUSTRY / RELATIONSHIPS /03"). The space after
                  the <br> is the words' separator once mobile hides
                  the break (line-start spaces collapse on desktop). */}
              <span class="fd-slide__list-item"
                >{item.text.split('\n').map((part, k) => (
                  <Fragment>{k > 0 && <Fragment><br />{' '}</Fragment>}{part}</Fragment>
                ))}<sup class="fd-slide__list-index">{item.index}</sup></span
              >
            </Fragment>
          ))}
        </p>
        {/* MOBILE Serrif statement — the file places the founder's
            Serrif close AFTER the portrait as its own block (13:948
            y930, now RIGHT-ALIGNED); same data field the desktop bio
            renders (the bio's Serrif line hides on mobile — one
            shown per breakpoint, never both). The leading spacer
            mirrors the bio-indent grammar (the file keeps the lead
            run). */}
        <p class="fd-slide__m-serif"
          ><span class="fd-slide__m-serif-indent" aria-hidden="true"></span>{slide.bioSerrif}</p
        >
        {/* MOBILE second image — the file's 370×370 slot under the
            statement (13:1002). Ashley's is the file's new shot;
            Robbo's is a flagged placeholder (see the data). */}
        <figure class="fd-slide__m-img2" aria-hidden="true">
          <img src={asset(slide.img2)} alt="" loading="lazy" decoding="async" />
        </figure>
      </div>
    ))}

    {/* The travelling names — OUTSIDE the slide containers (their
        z/position stacking contexts isolated the difference — the
        white-name bug): direct wrapper children, chain kept bare,
        blending against the wrapper's opaque ground + the portrait.
        founders-page.js drives `top` (layout, the blend rule) and
        groups each with its slide's transition. */}
    {FOUNDERS_SLIDES.map((slide, i) => (
      <h2 class="fd-slide__name" data-fd-name data-slide={String(i)}>{slide.name}</h2>
    ))}
    </div>

    {/* MOBILE thumb dock (rev 4): the face CTAs sit fixed 32px from
        the viewport bottom at all times — EXCEPT over the footer,
        where the dock takes the site's blurred exit (opacity 0 +
        blur 6, footer-page-js IO toggle) so it never blocks the
        footer, re-entering in place on the way back up. The dock
        wrapper owns fixed + blur (no blends inside — the labels
        live in the portraits); the inner cluster owns the entrance.
        Active stroke = JS (shared across both slides; Ashley lands). */}
    <div class="fd-m-switchdock" data-fd-m-dock>
      <nav class="fd-m-switch" data-fd-m-switch aria-label="Founder profiles">
        {[1, 0].map((idx) => (
          <button
            type="button"
            class="fd-m-switch__thumb"
            data-fd-m-thumb
            data-slide={String(idx)}
            data-founder={FOUNDERS_SLIDES[idx].id}
            aria-current={idx === 1 ? 'true' : 'false'}
            aria-label={`View founder: ${FOUNDERS_SLIDES[idx].name}`}
          >
            <img src={asset(FOUNDERS_SLIDES[idx].img)} alt="" loading="eager" decoding="async" />
          </button>
        ))}
      </nav>
    </div>

    <p class="fd-sr-live" data-fd-live aria-live="polite"></p>
  </main>

  {/* Footer — revealed from BEHIND the stage at the release's end
      (the /work fixed-wrap grammar; the sticky schema is opted out
      for this page in founders.css). */}
  <div class="fd-footer-wrap" data-fd-footer>
    <LandingFooter />
  </div>
</SiteShell>

<script>
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initFoundersPage } from '../scripts/landing/founders-page.js';

  let cleanupCharRipple = initCharRipple();
  let cleanupNavEntrance = initNavEntrance();
  let cleanupFounders = initFoundersPage();

  document.addEventListener('astro:before-swap', () => {
    cleanupCharRipple();
    cleanupNavEntrance();
    cleanupFounders();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCharRipple = initCharRipple();
    cleanupNavEntrance = initNavEntrance();
    cleanupFounders = initFoundersPage();
  });
</script>
