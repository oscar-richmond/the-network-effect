---
/**
 * /founders — the NEW BUILD's founders page (Figma 73:5519 "The
 * Founders — Slide 2", extracted 2026-08-08; 83px chrome
 * subtracted; Chrome mockup frames ignored). NO SLIDE 1 FRAME
 * EXISTS in the file — slide 1 is the same template with Robbo's
 * imagery + flagged placeholder copy (see founders-page.js).
 *
 * A TWO-SLIDE, FIXED-VIEWPORT scroll experience (the /work driver
 * lineage — founders-page.js): one virtual progress axis through
 * phases: P1 Robbo's name travels DOWN the portrait (top at the
 * image's live centre → bottom 40px above its live bottom, layout
 * `top` never transform — the name is difference-blended); P2 the
 * slide transition (text out/in staggered blur-fade, portrait
 * blur-crossfade, indicator label travels 64px + 01→02 roll,
 * boundary-snapped); P3 Ashley's travel; P4 release (content up
 * to 180px below the image, then the /work footer-reveal grammar
 * over the fixed footer wrap).
 *
 * BLEND WALK: the names are #F9F9F9 + difference; their chain
 * (stage > slide > name) carries no transform/opacity/filter —
 * the portrait layers are earlier SIBLINGS (the crossfade rides
 * them, never an ancestor). The stage is the /work fixed-viewport
 * shape.
 *
 * NARROW (the rebuild, 2026-09-07 — founders-narrow.css +
 * founders-page.js's narrow branch): the SAME DOM on normal document
 * scroll — the portrait frame sticky under the bar, the two blocks
 * scrolling beneath it with the wipe, the indicator in the frame's
 * corner, the column as a horizontal strip, the sweep as a full-bleed
 * band, the footer's sticky uncover. The old mobile-only anatomy is
 * retired.
 *
 * IMAGERY pending founder sign-off. STAGING ONLY.
 */
import SiteShell from '../layouts/SiteShell.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import { FOUNDERS_SLIDES } from '../data/landing/founders-page.js';
import { asset } from '../utils/asset.js';
import { imageSrcset } from '../utils/thumb-srcset.js';
import '../styles/home.css';
import '../styles/landing/landing.css';
import '../styles/landing/founders.css';
import '../styles/landing/founders-narrow.css';
import '../styles/fonts.css';
---

<SiteShell
  title="The Founders — The Network Effect"
  description="Rob Meakin and Robbo McCallum: fifty years between them across luxury hospitality, entertainment, music, film and live experiences."
  canonicalPath="/founders"
  bodyClass="landing-v2 founders-page"
>
  <main class="fd-stage" data-founders-stage aria-label="The founders" id="main" tabindex="-1">
    {/* A11y batch item 9: the page's own h1 (the wordmark is no longer
        one). The founders' names are the visible headings, per slide;
        this names the page. Visually hidden, zero layout. */}
    <h1 class="landing-sr">The Founders</h1>
    {/* THE CONTENT WRAPPER (Oscar's rev 2): carries its OWN opaque
        ground so the difference names blend correctly at rest AND
        while the release translates it (a transformed ancestor
        isolates blends — with an opaque ground inside the group the
        difference stays correct everywhere; the white-name bug's
        fix). The release rides THIS up (white gap grows below the
        portrait); only the footer reveal rides the stage. */}
    <div class="fd-content" data-fd-content>
    {/* ── Portrait (frame 6:67, 2026-08-26): 630×841 flush to the
        LEFT viewport edge at y80. The crossfade pair became a WIPE
        pair — the case-study lightbox's two-phase L→R wipe, ported
        scrub-natively (founders-page.js applyWipe): A wipes OUT to
        the bare ground over the transition's first half, B wipes IN
        over the second. Slot 0 of the five-image sync group. */}
    {/* R2 (2026-08-26): REVEAL-BEHIND — Ashley sits fully opaque
        beneath and Robbo's layer wipes L→R off him (the two-phase
        lightbox port cleared to bare ground mid-swap, which read as
        a WHITE FLASH on this surface — Oscar's defect report).
        Combined coverage never drops below full. */}
    <div class="fd-portrait" data-fd-portrait aria-hidden="true">
      {/* the rebuild: the 870 variant serves the narrow frame, the desktop
          keeps the full file (its sizes branch out-sizes every candidate) */}
      <img class="fd-portrait__img fd-portrait__img--under" data-fd-img-under src={asset(FOUNDERS_SLIDES[1].img)} srcset={imageSrcset(FOUNDERS_SLIDES[1].img, [870], 1728)} sizes="(max-width: 767px) 100vw, (max-width: 1359px) 40vw, 1728px" alt="" loading="eager" decoding="async" />
      <img class="fd-portrait__img fd-portrait__img--over" data-fd-img-over src={asset(FOUNDERS_SLIDES[0].img)} srcset={imageSrcset(FOUNDERS_SLIDES[0].img, [870], 1728)} sizes="(max-width: 767px) 100vw, (max-width: 1359px) 40vw, 1728px" alt="" loading="eager" decoding="async" />
    </div>

    {/* ── Indicator — repositioned (Oscar, 2026-08-26): 24 from the
        left edge, its bottom 32 above the PORTRAIT'S measured bottom
        (founders-page.js placeIndicator derives the top live). Sits
        AFTER the portrait so DOM order paints it above WITHOUT a
        z-index — the old z4 stacking context would have isolated the
        label's difference blend from the portrait beneath. Label +
        divider travel beside the active thumb (JS scrubs the 64px);
        active thumb keeps the 3px #232A89 stroke. */}
    <div class="fd-ind" data-fd-ind>
      <div class="fd-ind__thumbs">
        {FOUNDERS_SLIDES.map((slide, i) => (
          <button
            type="button"
            class="fd-ind__thumb"
            data-fd-thumb
            data-slide={String(i)}
            aria-current={i === 0 ? 'true' : 'false'}
            aria-label={`Go to founder ${slide.number}: ${slide.name}`}
          >
            <img src={asset(slide.img)} srcset={imageSrcset(slide.img, [176, 870], 1728)} sizes="(max-width: 1359px) 80px, 1728px" alt="" loading="eager" decoding="async" />
          </button>
        ))}
      </div>
      <div class="fd-ind__labelrow" data-fd-labelrow>
        <span class="fd-ind__divider" aria-hidden="true"></span>
        <span class="fd-ind__label" data-fd-label>
          <span class="fd-ind__label-line" data-fd-label-a>/ 01 Founder</span>
          <span class="fd-ind__label-line" data-fd-label-b aria-hidden="true">/ 02 Founder</span>
        </span>
      </div>
    </div>

    {/* ── RIGHT IMAGE COLUMN → SCROLL-DRIVEN ROLLING CAROUSEL (R2,
        2026-08-26): the 240-wide strip now bleeds off BOTH viewport
        edges — a full-height window rolling the SAME four images in
        their existing order, repeated ×3 for the seamless modulo
        wrap (founders-page.js: translateY = −(pos·FD_CAROUSEL_RATE)
        mod setH). Scroll-driven only — advances, stops and reverses
        with input; no autoplay. The per-founder wipe pairs retire
        with it (one shared roll). */}
    <div class="fd-col" aria-hidden="true">
      <div class="fd-col__track" data-fd-coltrack>
        {[0, 1].map(() => (
          FOUNDERS_SLIDES[0].colImgs.map((src) => (
            <div class="fd-col__slot">
              <img src={asset(src)} alt="" loading="eager" decoding="async" />
            </div>
          ))
        ))}
      </div>
    </div>

    {/* ── Slides' text (bio, button, list) + the travelling name. */}
    {FOUNDERS_SLIDES.map((slide, i) => (
      <div class="fd-slide" data-fd-slide data-slide={String(i)} data-active={i === 0 ? 'true' : 'false'}>
        {/* ── FRAME 6:67 DESKTOP TEXT BLOCK (2026-08-26): role line
            (710,245), STATIC name 48/50 (710,287 — the frame's
            treatment; the travelling difference name still runs,
            flagged as a duplicate pending Oscar's ruling), bio
            paragraphs (710,361), relationships label + three
            sentence-case rows (790,608..). All join the slide
            transition stagger (data-fd-el); hidden ≤1024. */}
        <p class="fd-slide__role" data-fd-el>{slide.roleLine}</p>
        <h3 class="fd-slide__staticname" data-fd-el>{slide.name}</h3>
        <div class="fd-slide__bio2" data-fd-el>
          {slide.bioParas.map((para) => (
            <p class="fd-slide__bio2-para">{para}</p>
          ))}
        </div>
        <div class="fd-slide__rel" data-fd-el>
          <p class="fd-slide__rel-label">{slide.relLabel}</p>
          {slide.relRows.map((row) => (
            <p class="fd-slide__rel-row">
              {row.map((item) => (
                <Fragment><span class="fd-slide__rel-item"
                  >{item.split('\n').map((part, k) => (
                    <Fragment>{k > 0 && <br />}{part}</Fragment>
                  ))}</span
                ><span class="fd-slide__rel-sep" aria-hidden="true">{' / '}</span></Fragment>
              ))}
            </p>
          ))}
        </div>
      </div>
    ))}

    {/* The travelling names are REMOVED (R2, Oscar 2026-08-26) —
        the frame's static name in the text block is the name
        treatment; the travel machinery went with them
        (founders-page.js: phases re-anchored to named constants,
        no derived name clamps remain). */}

    {/* ── THE CLOSING SWEEP (R30, Oscar 2026-09-03) — the landing
        image of the page's end state: the WHO WE ARE sofa shot (the
        SAME asset the landing section uses — one file, one standing
        founder-imagery sign-off), swept in left-to-right over
        Ashley's portrait on the PORTRAIT TRANSITION'S OWN mechanism
        (founders-page.js applySweep: the clip inset + the sin-curve
        edge blur, FD_REVEAL_BLUR_PX — the same constants the
        Robbo→Ashley wipe uses) and continuing past the portrait's
        edge to the full viewport width.

        GEOMETRY: the VIEWPORT TOP down to the portrait's bottom, at
        100vw — so the end state is the image, the nav over it, and
        the ONE deliberate white strip below, which is the portrait's
        existing bottom margin, untouched (196 at 1728, 73 in the
        1512 shell — Oscar's ruling: kept, not "fixed").
        CROP: object-position 50% 0 — TOP-anchored, so the 20% lost
        is the bottom (feet and rug); both faces and upper bodies
        sit in the kept 80%.

        DOM: last in fd-content, so paint order puts it over the
        portrait, the column and both slides with NO z-index (the
        page's standing rule — a stacking context here would isolate
        the difference-blended names beneath it). BLEND: the nav is
        in the SiteShell header, an entirely different subtree, so
        this element's clip can never become its blend ancestor. */}
    <figure class="fd-sweep" data-fd-sweep aria-hidden="true">
      <img src={asset('/assets/landing/founders/founders-photo.jpg')} alt="" loading="lazy" decoding="async" />
    </figure>
    </div>

    <p class="fd-sr-live" data-fd-live aria-live="polite"></p>
  </main>

  {/* Footer — revealed from BEHIND the stage at the release's end
      (the /work fixed-wrap grammar; the sticky schema is opted out
      for this page in founders.css). */}
  <div class="fd-footer-wrap" data-fd-footer>
    {/* R32 item 5: the bottom row enters from THIS page's reveal
        progress (the band-carried reveal exposes it before the
        one-shot) — a page-scoped flag on the shared component. */}
    <LandingFooter theme="light" rowEntrance="scrub" />
  </div>
  {/* the narrow build's uncover travel (founders-narrow.css; hidden in the
      driver's fixed viewport) */}
  <div class="landing-footer-spacer" aria-hidden="true"></div>
</SiteShell>

<script>
  import { initCharRipple } from '../scripts/char-ripple.js';
  import { initNavEntrance } from '../scripts/landing/nav-motion.js';
  import { initFoundersPage } from '../scripts/landing/founders-page.js';

  let cleanupCharRipple = initCharRipple();
  let cleanupNavEntrance = initNavEntrance();
  let cleanupFounders = initFoundersPage();

  document.addEventListener('astro:before-swap', () => {
    cleanupCharRipple();
    cleanupNavEntrance();
    cleanupFounders();
  });

  document.addEventListener('astro:after-swap', () => {
    cleanupCharRipple = initCharRipple();
    cleanupNavEntrance = initNavEntrance();
    cleanupFounders = initFoundersPage();
  });
</script>
