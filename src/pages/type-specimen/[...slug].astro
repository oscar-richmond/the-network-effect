---
/**
 * THE TYPE SPECIMEN — dev-only (mobile rebuild Part 1 C, 2026-09-08).
 *
 * Every type role of the phone build, rendered at the current viewport from
 * the tokens (src/styles/tokens/type.css) with its computed size / leading /
 * tracking printed live, beside the value the 402 frame draws — so 360, 390,
 * 402 and 430 can be read side by side. The four large roles are fluid on the
 * measure (100vw − 32) / 370; everything else is fixed.
 *
 * Gated: getStaticPaths returns no path unless the TYPE_SPECIMEN flag is on
 * (dev, or PUBLIC_TYPE_SPECIMEN=1), so a production build has no such route.
 * No layout, no nav — a bare document.
 */
import { TYPE_SPECIMEN } from '../../data/flags.js';
import '../../styles/fonts.css';
import '../../styles/tokens/index.css';
import { PHONE_DESIGN_WIDTH, PHONE_FLUID_MIN, PHONE_FLUID_MAX } from '../../config/breakpoints.js';

export function getStaticPaths() {
  return TYPE_SPECIMEN ? [{ params: { slug: undefined } }] : [];
}

/* role · the frame's sample copy · the frame's value at 402 · nodes · fluid? */
const ROLES = [
  ['nav', 'TheNetworkEffect', '24 → 18 scrolled · −0.03em', '1:420', false],
  ['display-serif', 'BUILT ON TRUST.', '48 / 45', '1:13, 1:277', true],
  ['display', 'POWERED BY ACCESS.', '48 / 45 · −0.03em', '1:14, 1:278', true],
  ['statement', 'WE CREATE ACCESS BETWEEN WORLDS THAT DON’T NORMALLY CONNECT', '48 / 45 · −0.04em', '1:326, 1:373', true],
  ['heading', 'NEARLY 20 YEARS BUILDING GLOBAL RELATIONSHIPS MEETS 30 YEARS AT THE HEART OF MUSIC, FILM AND TELEVISION.', '32 / 30 · −0.035em', '1:74, 1:33, 1:321, 1:338', true],
  ['footer-statement', 'Culture rarely moves in public first. It moves quietly. Through people. Through relationships.', '30 / 30', '1:409', false],
  ['pillar-title', 'IMMERSE /01', '28 · −0.02em (index 14)', '1:109, 1:108', false],
  ['title', 'Activate Experiences & Cultural Moments', '26 / 28', '1:113, 1:289, 1:349', false],
  ['term', 'Talent / Hospitality / TV & Film / Music / Luxury / Fashion', '24 / 27', '1:32', false],
  ['lede', 'We connect Talent, Brands & Audiences through Experiences, Strategic Partnerships & Media', '20 / 24 · −0.015em', '1:270', false],
  ['row', 'Talent-Led Experiences · Immersive Brand Worlds · Brand Launches', '16 / 19 (8 gap)', '1:126', false],
  ['body', 'Audiences trust people more than institutions.', '16 / 18', '1:350, 1:396', false],
  ['small', 'Terms & Conditions · Privacy Policy · ©2026 All rights reserved', '14 / 16', '1:413, 1:416', false],
  ['eyebrow', 'WHO WE ARE · WHAT WE DO · WE BUILD · TRUSTED BY FOUNDERS AND BRANDS', '12 / 14 · −0.015em', '1:55, 1:325, 1:123', false],
  ['label', 'THE FOUNDERS · FEATURED WORK · MORE INFO', '12', '1:67, 1:72, 1:117', false],
  ['access-label', 'Talent', '48 (30 inner)', '1:77, 1:81', false],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>Type specimen — The Network Effect</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--m-color-ground); color: var(--m-color-ink); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    body { font-family: var(--m-font-sans); padding: var(--m-space-4) var(--m-inset); }
    .top { display: flex; flex-wrap: wrap; gap: var(--m-space-1) var(--m-space-4); align-items: baseline; margin-bottom: var(--m-space-3); }
    .top h1 { margin: 0; font: var(--type-eyebrow-weight) var(--type-eyebrow-size) / var(--type-eyebrow-lh) var(--type-eyebrow-face); text-transform: var(--type-eyebrow-case); letter-spacing: var(--type-eyebrow-ls); }
    .top p { margin: 0; font: var(--type-small-weight) var(--type-small-size) / var(--type-small-lh) var(--type-small-face); color: var(--m-color-muted); }
    .vp { font-family: ui-monospace, Menlo, monospace; color: var(--m-color-ink); }
    .role { padding: var(--m-space-3) 0; border-bottom: var(--m-hairline) solid var(--m-color-divider); }
    .meta { display: flex; flex-wrap: wrap; gap: var(--m-space-1) var(--m-space-3); margin-bottom: var(--m-space-1); font: var(--type-small-weight) var(--type-small-size) / var(--type-small-lh) ui-monospace, Menlo, monospace; color: var(--m-color-muted); }
    .meta b { color: var(--m-color-blue); }
    .meta .frame { color: var(--m-color-ink); }
    .s { margin: 0; overflow-wrap: anywhere; font-family: var(--f); font-weight: var(--w); text-transform: var(--c); font-size: var(--s); line-height: var(--lh); letter-spacing: var(--ls); }
    .s.dark { background: var(--m-color-ground-dark); color: var(--m-color-ink-on-dark); padding: var(--m-space-2) var(--m-space-3); }
  </style>
</head>
<body>
  <div class="top">
    <h1>Type specimen — the phone build</h1>
    <p>Viewport <span class="vp" data-vp></span> · frame {PHONE_DESIGN_WIDTH}, fluid {PHONE_FLUID_MIN}–{PHONE_FLUID_MAX} · tokens from <code>src/styles/tokens/type.css</code></p>
  </div>
  {ROLES.map(([role, sample, frame, nodes, fluid]) => {
    const vars = `--f:var(--type-${role}-face);--w:var(--type-${role}-weight);--c:var(--type-${role}-case);--s:var(--type-${role}-size);--lh:var(--type-${role}-lh);--ls:var(--type-${role}-ls)`;
    return (
      <section class="role" style={vars} data-role={role}>
        <div class="meta"><b>{role}</b> <span>{fluid ? 'fluid' : 'fixed'}</span> <span class="frame">frame {frame}</span> <span>{nodes}</span> <span data-computed>…</span></div>
        <p class:list={['s', { dark: role === 'access-label' }]} data-sample>{sample}</p>
      </section>
    );
  })}
  <script>
    const vp = document.querySelector('[data-vp]');
    const print = () => {
      vp.textContent = `${innerWidth} × ${innerHeight}`;
      document.querySelectorAll('[data-role]').forEach((sec) => {
        const s = sec.querySelector('[data-sample]');
        const c = getComputedStyle(s);
        const ls = c.letterSpacing === 'normal' ? '0' : `${parseFloat(c.letterSpacing).toFixed(2)}px`;
        sec.querySelector('[data-computed]').textContent = `computed ${parseFloat(c.fontSize).toFixed(2)} / ${parseFloat(c.lineHeight).toFixed(2)} · ${ls}`;
      });
    };
    print();
    addEventListener('resize', print);
  </script>
</body>
</html>
