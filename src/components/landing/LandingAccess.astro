---
/**
 * WE CREATE ACCESS (/landing) — Figma n2cY4c7GnsR5MBx1PJoC97 node
 * 9:1472 (inside frame 9:1100), extracted 2026-08-04. Chrome/nav
 * mockup frames ignored.
 *
 * Two 344px image columns (left x200, right x1184) travel in
 * OPPOSITE directions on scroll — left up, right down — landing on
 * six word pairs together; the centre image of each column is sharp,
 * everything else dims behind a white veil + backdrop blur. Word
 * overlays (Serrif Regular, difference) sit at the centre band and
 * change per pair. The whole interaction lives in
 * src/scripts/landing/landing-access.js; the images additionally
 * render through the curve-media warp (src/scripts/curve-media.js,
 * the services pop-up treatment) on two per-column canvases.
 *
 * STACK ORDER / BLEND MAP (see landing-access.js header): masked
 * static wrappers > travelling columns (z1) → warp canvases (z2) →
 * travelling veil columns (z3) → difference words + headline (z4).
 * The words' ancestor chain is the bare stage — no transform, filter,
 * opacity or mask above them.
 *
 * PENDING FOUNDER SIGN-OFF: the Figma supplies only 5 distinct
 * images per column (8 unique in the layout, 14 in the file's pool);
 * six pairs need 12. All slots below are placeholder assignments
 * from the file's own pool — swap freely, the pairing/order is the
 * only structural part. Pads (top/bottom bookends) never reach the
 * centre and are repeats by design.
 */
import { asset } from '../../utils/asset.js';
import { ACCESS_PAIRS } from '../../data/landing/access-pairs.js';

const a = (n) => asset(`/assets/landing/access/access-${n}.jpg`);

/* HORIZONTAL ROWS (frame 0:91, 2026-08-25 — the vertical columns
   retire). SAME imagery, SAME pair order, no swaps: the old left
   column's pair images become the TOP row (pairs 1→6 left-to-right,
   travelling LEFT); the old right column's become the BOTTOM row —
   its shipped top→bottom order (pairs 6→1) IS the bottom row's
   left-to-right order (travelling RIGHT), so the matched pair lands
   together BY CONSTRUCTION off one clock (the mobile rows' device).
   Pads bookend for edge coverage and never land. Cell = index into
   the strip; `pair` marks landable cells (0-based pair index). */
/* TRAILING CELLS REMOVED (Oscar 2026-08-26): the sequence ends CLEAN
   on CORPORATE ↔ COMMUNITY — the top row's THREE tail pads and the
   bottom row's TWO lead pads are gone (audited counts). Consequence
   (reported): those cells also edge-filled the pair-4/5 rests, so
   the runway now visibly runs out at the travel edges approaching
   the final pair. `pad` cells are marked for the driver (the old
   first/last-index inference broke once a prime became an edge). */
const topStrip = [
  { src: a(9), pad: true }, // lead pad
  { src: a(7), pair: 0 },
  { src: a(2), pair: 1 },
  { src: a(1), pair: 2 },
  { src: a(6), pair: 3 },
  { src: a(13), pair: 4 },
  { src: a(3), pair: 5 },
];
const bottomStrip = [
  { src: a(4), pair: 5 },
  { src: a(14), pair: 4 },
  { src: a(12), pair: 3 },
  { src: a(5), pair: 2 },
  { src: a(11), pair: 1 },
  { src: a(8), pair: 0 },
  { src: a(9), pad: true }, // tail pad (pair-1 right fill)
];

---

<section class="landing-access" data-landing-access aria-label="We create access">
  <div class="landing-access__stage" data-access-stage>
    {/* Image columns — masked static wrapper (the section's top/bottom
        fade) around the travelling flex column. aria-hidden: ambient
        imagery; the words + headline carry the meaning. */}
    {/* ── THE ROWS (frame 0:91): two 640×340 strips on a 648 pitch,
        top at stage y718 travelling LEFT, bottom at y1066 travelling
        RIGHT, base positions = the frame's landed pair-1 state (the
        RM/no-JS frame). The wrappers park offscreen sideways for the
        entrance; landing-access.js drives everything from one
        progress. */}
    <div class="landing-access__rowwrap landing-access__rowwrap--top" aria-hidden="true">
      <div class="landing-access__row landing-access__row--top" data-access-row="top">
        {topStrip.map((cell) => (
          <figure class={`landing-access__cell${cell.pair === 0 ? ' is-prime' : ''}`} data-pad={cell.pad ? '' : undefined}>
            <img src={cell.src} alt="" loading="eager" decoding="async" />
          </figure>
        ))}
      </div>
    </div>
    <div class="landing-access__rowwrap landing-access__rowwrap--bottom" aria-hidden="true">
      <div class="landing-access__row landing-access__row--bottom" data-access-row="bottom">
        {bottomStrip.map((cell) => (
          <figure class={`landing-access__cell${cell.pair === 0 ? ' is-prime' : ''}`} data-pad={cell.pad ? '' : undefined}>
            <img src={cell.src} alt="" loading="eager" decoding="async" />
          </figure>
        ))}
      </div>
    </div>

    {/* Media shader — the same one-canvas wave, bow axis X. */}

    {/* Dim veils — strips mirroring the rows 1:1 above the canvas
        (backdrop-filter samples beneath; wrappers unmasked — the
        backdrop-root rule). The frame's off-centre treatment: 60%
        opacity over the ground ≡ a ground-coloured 0.4 veil + the
        drawn 10px blur — implemented on the veil so the GL planes
        stay untouched. */}
    <div class="landing-access__veilwrap landing-access__veilwrap--top" aria-hidden="true">
      <div class="landing-access__veilrow" data-access-veils="top">
        {topStrip.map((cell) => (
          <span class={`landing-access__veil${cell.pair === 0 ? ' is-prime' : ''}`}></span>
        ))}
      </div>
    </div>
    <div class="landing-access__veilwrap landing-access__veilwrap--bottom" aria-hidden="true">
      <div class="landing-access__veilrow" data-access-veils="bottom">
        {bottomStrip.map((cell) => (
          <span class={`landing-access__veil${cell.pair === 0 ? ' is-prime' : ''}`}></span>
        ))}
      </div>
    </div>

    {/* WORD LAYER — one slot per pair per row, Serrif Regular 56
        white DIFFERENCE, centred 344×61 on the landed cell (frame
        x148/y139 inside the 640×340 mask = dead centre). The slots
        move by layout `left` (landing-access.js), NEVER transform:
        their ancestor chain stays section > stage, so the blend
        composites against the canvas/imagery beneath (the shipped
        blend map, kept). Pair-1 slots are on for the RM frame. */}
    <div class="landing-access__words" aria-hidden="true">
      {ACCESS_PAIRS.map((pair, k) => (
        <>
          <span
            class={`landing-access__wordslot landing-access__wordslot--top${k === 0 ? ' is-on' : ''}`}
            data-access-wordslot
            data-row="top"
            data-pair={k}
          >{pair[0]}</span>
          <span
            class={`landing-access__wordslot landing-access__wordslot--bottom${k === 0 ? ' is-on' : ''}`}
            data-access-wordslot
            data-row="bottom"
            data-pair={k}
          >{pair[1]}</span>
        </>
      ))}
    </div>

    {/* DESKTOP headline (frame 0:91) — the FRAGMENTED composition:
        WHAT WE DO label + seven Dazzed Bold 100/88/−4% lines, each
        at its own x (hierarchy from position per the type guide —
        every line one size). Hidden ≤1024; the welded block below
        stays as the MOBILE headline. */}
    <div class="landing-access__dheadline" aria-hidden="false">
      <p class="landing-access__dlabel" data-access-dline>WHAT WE DO</p>
      <h2 class="landing-access__dlines">
        <span class="landing-access__dline landing-access__dline--1" data-access-dline>WE</span>
        <span class="landing-access__dline landing-access__dline--2" data-access-dline>CREATE</span>
        <span class="landing-access__dline landing-access__dline--3" data-access-dline>ACCESS</span>
        <span class="landing-access__dline landing-access__dline--4" data-access-dline>BETWEEN</span>
        <span class="landing-access__dline landing-access__dline--5" data-access-dline>WORLDS</span>
        <span class="landing-access__dline landing-access__dline--6" data-access-dline>THAT DON’T</span>
        <span class="landing-access__dline landing-access__dline--7" data-access-dline>NORMALLY CONNECT</span>
      </h2>
    </div>

    {/* MOBILE headline — the shipped welded mixed-face block (hidden
        ≥1025 now; the fragmented composition above replaces it on
        desktop). */}
    <h2 class="landing-access__headline" data-access-headline>
      <span class="landing-access__hl-line" data-access-line
        ><span class="landing-access__hl-dazzed">{'WE '}</span><span class="landing-access__hl-serrif">CREATE ACCESS</span></span
      >
      <span class="landing-access__hl-line" data-access-line
        ><span class="landing-access__hl-serrif">BETWEEN WORLDS</span><span class="landing-access__hl-dazzed">{' THAT'}</span></span
      >
      <span class="landing-access__hl-line" data-access-line
        ><span class="landing-access__hl-dazzed">DON'T NORMALLY</span></span
      >
      <span class="landing-access__hl-line" data-access-line
        ><span class="landing-access__hl-dazzed">CONNECT</span></span
      >
    </h2>

    {/* MOBILE COMPOSITION — THE ROWS (402-frame rebuild 2026-08-13,
        replacing the 2026-08-10 ledger): two 360×240 image rows on a
        368px pitch (file 0:299-0:328), top travelling RIGHT, bottom
        LEFT, both off ONE clock (landing-access.js mobile branch) so
        the centred pair is always a desktop pair by construction.
        The highlight slots sit at 50vw+60 (top) and 50vw−60
        (bottom) — decoded from the file's own node positions, which
        are exactly one pitch apart around those centres. Each row =
        the pair set TWICE for the seamless wrap; top copies are
        REVERSED so a rightward travel advances pair order. Images:
        the desktop columns' own pair assignments (left column → top
        row, right column → bottom row; same pool, same placeholder
        flags). The words are the desktop's difference treatment at
        the file's mobile scale, revealing through a clip slot; the
        static markup (pair 1 centred, words in) IS the reduced-
        motion and pre-JS frame. display:none above 1024; desktop
        DOM untouched. aria-hidden imagery; the words are read via
        the visible headline + the rows' aria-label. */}
    <div class="landing-access__mobile" data-access-mobile>
      <div
        class="landing-access__m-rows"
        data-access-mrows
        role="img"
        aria-label={`Worlds we connect: ${ACCESS_PAIRS.map((p) => p.join(' and ')).join(', ')}`}
      >
        <div class="landing-access__m-row landing-access__m-row--top" aria-hidden="true">
          <div class="landing-access__m-track" data-access-mtrack="top">
            {[0, 1].map(() =>
              [a(7), a(2), a(1), a(6), a(13), a(3)]
                .reverse()
                .map((src) => (
                  <figure class="landing-access__m-item">
                    <img src={src} alt="" loading="lazy" decoding="async" />
                    <span class="landing-access__m-veil"></span>
                  </figure>
                )),
            )}
          </div>
          <p class="landing-access__m-word" data-access-mword="top">
            <span class="landing-access__m-word-clip"
              ><span class="landing-access__m-word-inner" data-access-mword-inner="top"
                >{ACCESS_PAIRS[0][0]}</span
              ></span
            >
          </p>
        </div>
        <div class="landing-access__m-row landing-access__m-row--bottom" aria-hidden="true">
          <div class="landing-access__m-track" data-access-mtrack="bottom">
            {[0, 1].map(() =>
              [a(8), a(11), a(5), a(12), a(14), a(4)].map((src) => (
                <figure class="landing-access__m-item">
                  <img src={src} alt="" loading="lazy" decoding="async" />
                  <span class="landing-access__m-veil"></span>
                </figure>
              )),
            )}
          </div>
          <p class="landing-access__m-word" data-access-mword="bottom">
            <span class="landing-access__m-word-clip"
              ><span class="landing-access__m-word-inner" data-access-mword-inner="bottom"
                >{ACCESS_PAIRS[0][1]}</span
              ></span
            >
          </p>
        </div>
      </div>
    </div>

    {/* (The top GradualBlur band + top edge-tint are REMOVED — Oscar's
        2026-08-26 report: they sat full-width over the WHAT WE DO
        label and the headline's upper lines, and nothing image-like
        ever crosses this stage's TOP edge (the rows live at y718+).
        The featured section keeps its own bands — separate instance,
        untouched.) */}
  </div>
</section>
