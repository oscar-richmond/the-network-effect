---
/**
 * SERVICES STACK (/landing) — Figma n2cY4c7GnsR5MBx1PJoC97, nodes
 * 13:1729 (pre-stack, row internals + copy) and 13:2066 (post-stack,
 * THE GEOMETRY AUTHORITY — Oscar's call: rigid cards on post-stack
 * internal offsets; the frames' 32px internal drift resolved toward
 * post-stack). Chrome mockup frames ignored; 83px chrome offset
 * subtracted throughout.
 *
 * Three full-width opaque cards (1px #E0E0E7 divider + 645px #EEEEF0
 * body) that rise and stack at 124px offsets (dividers 158/282/406 —
 * symmetric 32px gaps around each covered card's secondary title,
 * whose header band eases up as the cover lands; keep in step with
 * the BAND_* / CARD_STEP_PX constants),
 * plus the small OUR SERVICES morph twin (16px Dazzed Bold, white,
 * difference, x24 — the large centred title resolves into it during
 * Beat A; landing-services.js). Cards are position-driven by
 * landing-services.js; the CSS default (--svc-parked-y inline below)
 * is the PARKED state = the reduced-motion frame.
 *
 * BLEND: each card's title + /0N are difference INSIDE the card —
 * the card's transform stacking context contains everything they
 * blend against (its own opaque bg + image), so cross-card blending
 * never occurs. No filter/opacity wrappers between card root and the
 * titles (the Beat F fade goes on the card ROOT — composed-unit
 * fade, safe).
 *
 * PENDING FOUNDER SIGN-OFF: all three images are the file's own
 * exports, placeholder until licensed finals.
 * CONTENT FLAG (Oscar-approved substitution, needs FOUNDER
 * confirmation): the file lists "Industry-leading Events" twice in
 * IMMERSE (columns 2 and 3 — a Figma slip). The column-3 occurrence
 * below is replaced with the deck's missing 12th item, "Exceptional
 * Culinary Experiences".
 * MORE INFO buttons: destinations unspecified — non-navigating
 * placeholders, flagged.
 */
import { asset } from '../../utils/asset.js';
import { SERVICES_REEL_PILLARS } from '../../data/landing/services-reel.js';

const base = import.meta.env.BASE_URL;

/* THE MOBILE PASS (2026-09-07): the phone's swipe columns derive from
   the reel's lists — the desktop's current content, one source — in
   columns of four (the file's own column depth). This supersedes the
   file-verbatim columns below: CONNECT gains the four rows the desktop
   has (Ambassador Programmes, Influencer & Creator Partnerships,
   Community & Membership Engagement, Network-led Business Development)
   and AMPLIFY loses its two boundary repeats. Column widths follow the
   longest item at the strip's 14px Serrif measure. */
const reelCols = (i) => {
  const items = SERVICES_REEL_PILLARS[i].services.map((sv) => sv.t);
  const cols = [];
  const per = items.length % 4 === 1 ? 3 : 4; /* nine rows read as 3 × 3, not 4 + 4 + 1 */
  for (let k = 0; k < items.length; k += per) cols.push(items.slice(k, k + per));
  return cols.map((col) => ({ w: Math.round(Math.max(...col.map((t) => t.length)) * 7.8 + 24), items: col }));
};

const cards = [
  {
    id: 'immerse',
    index: '/01',
    title: 'IMMERSE',
    img: {
      src: asset('/assets/landing/services-stack/immerse.jpg'),
      w: 499.02, h: 677.25, x: -75.01, y: -121.49,
    },
    /* Authored as the file's own two rendered lines (its h60 box =
       2 x lh30) so the derived rhythm counts them correctly. */
    desc: ['Activate Experiences &', 'Cultural Moments'],
    listHead: 'WE BUILD',
    listGap: 64,
    cols: [
      { w: 190, items: ['Talent-Led Experiences', 'Immersive Brand Worlds', 'Brand Launches', 'Fashion & Media Events'] },
      { w: 274, items: ['Industry-leading Events', 'Cultural Programming', 'Brand Collaborations', 'Leadership Summits & Conferences'] },
      /* Third item below = the flagged substitution (see header). */
      { w: 215, items: ['Experiential Campaigns', 'Music & Food Festivals', 'Exceptional Culinary Experiences', 'Health & Wellbeing Retreats'] },
    ],
    parkedY: 158,
  },
  {
    id: 'connect',
    index: '/02',
    title: 'CONNECT',
    img: {
      src: asset('/assets/landing/services-stack/connect.jpg'),
      w: 425, h: 522, x: -3, y: -4,
    },
    desc: ['Strategic Partnerships', '& Talent Strategy'],
    listHead: 'WE SHAPE',
    listGap: 100,
    cols: [
      { w: 301, items: ['Strategic Brand Partnerships', 'Celebrity & Talent Partnerships', 'Cultural Introductions', 'Commercial Relationship Development', 'Ambassador Programmes', 'Influencer & Creator Partnerships'] },
      { w: 270, items: ['Long-term Partnership Strategy', 'Story-led Collaborations', 'Sponsorship Strategy & Acquisition', 'Brand-to-brand Collaborations', 'Community & Membership Engagement', 'Network-led Business Development'] },
    ],
    parkedY: 282,
  },
  {
    id: 'amplify',
    index: '/03',
    title: 'AMPLIFY',
    img: {
      /* The file's slot holds a hidden stray (a covered duplicate of
         Connect's image) beneath this one — visible layer only. */
      src: asset('/assets/landing/services-stack/amplify.jpg'),
      w: 391, h: 507, x: -7, y: -13,
    },
    desc: ['Create Narratives', '& Media'],
    listHead: 'WE CREATE',
    listGap: 64,
    cols: [
      { w: 180, items: ['Podcasts', 'Documentary Formats', 'Original Content Series'] },
      { w: 146, items: ['Brand Storytelling', 'Campaign Creative', 'Creative Direction'] },
      { w: 242, items: ['Social-first Content', 'Photography & Film Production', 'Design Systems & Brand Assets'] },
    ],
    parkedY: 406,
  },
];

/* Right-column vertical rhythm (Oscar's rev, replacing the file's
   absolute offsets): the desc block stays centre-anchored at y80
   (28px/30 now), the list header sits 64px below the desc's bottom
   edge, the list 24px below the header (19px box), and MORE INFO
   80px below the list's bottom. Derived per row from line/item
   counts so the rhythm holds whatever the copy does. */
/* ── MOBILE layer (Figma 5cEi5ABu06aABOVemHVoAy frame 0:12, mobile
   rebuild 2026-08-13). Everything below renders ONLY at <=1024 (the
   desktop card internals hide there); nothing desktop keys on it.

   LIST COPY IS THE FILE'S, VERBATIM (the brief's rule), which
   diverges from the desktop data in three flagged ways:
   - IMMERSE col 3 repeated "Industry-leading Events"; RESOLVED
     2026-09-04 — the substitution wins here too, so mobile, desktop and
     /services now carry the same twelve rows;
   - AMPLIFY repeats "Brand Storytelling" and "Podcasts" at column
     boundaries — REPORTED, NOT CHANGED (2026-09-04): unlike the IMMERSE
     slip there is no approved replacement, and the repeat sits exactly
     on the swipe-page boundary, which reads as deliberate overlap. A
     content decision, Oscar's;
   - CONNECT lists 4 rows x 2 cols (desktop has 6 x 2).
   Column widths are the file's own (they drive the swipe width). */
const mobileCards = {
  immerse: {
    img: asset('/assets/landing/mobile/svc-immerse-m.jpg'),
    cols: reelCols(0),
  },
  connect: {
    img: asset('/assets/landing/mobile/svc-connect-m.jpg'),
    cols: reelCols(1),
  },
  amplify: {
    img: asset('/assets/landing/mobile/svc-amplify-m.jpg'),
    cols: reelCols(2),
  },
};

const DESC_CENTER_Y = 80;
const DESC_LINE_H = 30;
const HEAD_GAP = 64;
const HEAD_H = 19;
const LIST_GAP = 24;
const ITEM_H = 19;
const ITEM_GAP = 8;
const BTN_GAP = 80;

const rhythm = (card) => {
  const descBottom = DESC_CENTER_Y + (card.desc.length * DESC_LINE_H) / 2;
  const headTop = descBottom + HEAD_GAP;
  const listTop = headTop + HEAD_H + LIST_GAP;
  const rows = Math.max(...card.cols.map((c) => c.items.length));
  const listBottom = listTop + rows * ITEM_H + (rows - 1) * ITEM_GAP;
  return { headTop, listTop, btnTop: listBottom + BTN_GAP };
};
---

{/* The corner anchor — the Serrif title travels onto this box and
    scales to its size (single-instance morph, Oscar's rev 3); the
    element itself stays hidden in motion mode and serves as the RM
    static corner title. aria-hidden: the h2 carries the semantics. */}

{cards.map((card) => (
  <article
    class="landing-svc-card"
    data-services-card
    style={`--svc-parked-y:${card.parkedY}px;--svc-head-top:${rhythm(card).headTop}px;--svc-list-top:${rhythm(card).listTop}px`}
  >
    <div class="landing-svc-card__bg" aria-hidden="true"></div>
    {/* Divider: three layers — wrapper, the permanent grey TRACK, and
        the black FILL that drains (scaleX 1 -> 0, origin right: grey
        resolves left-to-right) as the card rises, completing exactly
        at park (landing-services.js). Starts solid black. */}
    <div class="landing-svc-card__dividerwrap" aria-hidden="true">
      <div class="landing-svc-card__divider"></div>
      <div class="landing-svc-card__divider-fill" data-services-divider-fill></div>
    </div>
    <h3 class="landing-svc-card__titlerow">
      <span class="landing-svc-card__title" data-services-card-title>{card.title}</span>
      <span class="landing-svc-card__index" data-services-card-index>{card.index}</span>
    </h3>
    <div class="landing-svc-card__img" aria-hidden="true">
      <img
        src={card.img.src}
        alt=""
        loading="lazy"
        decoding="async"
        style={`width:${card.img.w}px;height:${card.img.h}px;left:${card.img.x}px;top:${card.img.y}px`}
      />
    </div>
    <p class="landing-svc-card__desc">
      {card.desc.map((line, i) => (
        <Fragment>{i > 0 && <br />}{line}</Fragment>
      ))}
    </p>
    <p class="landing-svc-card__listhead">{card.listHead}</p>
    <div class="landing-svc-card__lists" style={`gap:${card.listGap}px`}>
      {card.cols.map((col) => (
        <ul class="landing-svc-card__col" style={`width:${col.w}px`}>
          {col.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ))}
    </div>
    {/* MOBILE list block (file 0:375/0:80/0:119): label + the shared
        carousel indicator on one row, then the file-verbatim columns
        as a native swipe strip. display:none above the seam; the
        desktop lists above hide below it. aria-hidden on the
        indicator (decoration); the list itself is real content. */}
    <div class="landing-svc-card__m-listblock" data-svc-m-carousel>
      <div class="landing-svc-card__m-listtop">
        <p class="landing-svc-card__m-listhead">{card.listHead}</p>
        <span class="m-carousel-ind" data-carousel-ind aria-hidden="true">
          <span class="m-carousel-ind__thumb" data-carousel-thumb></span>
        </span>
      </div>
      <div class="landing-svc-card__m-strip" data-carousel-strip>
        {mobileCards[card.id].cols.map((col) => (
          <ul class="landing-svc-card__m-col" style={`--m-col-w:${col.w}px`}>
            {col.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ))}
      </div>
    </div>
    {/* MOBILE card image (file crops, exported @2x sRGB) — the
        desktop 424x515 window hides on mobile. Same founder/imagery
        sign-off caveat as every visual asset. */}
    <div class="landing-svc-card__m-img" aria-hidden="true">
      <img src={mobileCards[card.id].img} alt="" loading="lazy" decoding="async" width="740" height="440" />
    </div>
    {/* Deep-links to this service's own section on /services
        (Oscar's rev): the pillar id there is this card's id, and
        the section top is the full-bleed moment, so the user lands
        on the image with its title. House char-ripple hover (the
        founders-CTA blur sweep, arrow joins after the text). */}
    {/* The reveal CLIP wraps the WHOLE button (Oscar's rev: the
        container animates with the same clip rise as the text, not
        just its label) — the clip carries the position, the button
        is static inside; landing-services.js sets the inner's
        delay and plays the clip with the card's texts. */}
    <span class="landing-svc-card__btnclip lr-clip" style={`top:${rhythm(card).btnTop}px`}>
      <span class="landing-svc-card__btninner lr-inner">
        {/* R53 (pre-launch sweep, 2026-09-04): the MOBILE pillar id, not
            the desktop one. This whole stack renders below the seam only
            (measured: the button is display:none at 1728, visible at 390),
            and `#immerse` / `#connect` / `#amplify` are the ids of the
            DESKTOP .sv6-pillar sections, which /services hides on mobile —
            so all three links landed a visitor at the top of the page with
            nothing scrolled. The mobile sections carry `m-` ids
            (services.astro renders `id={`m-${p.id}`}` on .sv-pillar). */}
        <a class="landing-svc-card__btn" href={`${base}services#${card.id}`} data-char-ripple-trigger>
          <span data-char-ripple>MORE INFO</span>
          <img
            src={asset('/assets/landing/services-stack/more-arrow.svg')}
            alt=""
            width="12"
            height="12"
            data-char-ripple-arrow
          />
        </a>
      </span>
    </span>
  </article>
))}
