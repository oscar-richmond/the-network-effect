---
/**
 * FOUNDERS SECTION (/landing) — Figma n2cY4c7GnsR5MBx1PJoC97 node
 * 1:90, extracted 2026-08-04. The file frames the section inside a
 * browser-chrome mockup (nodes 1:210-1:213) and a nav mockup (1:215)
 * — both ignored; content geometry below is the design's own group
 * (1:170) with the 83px chrome offset subtracted. Nodes 1:194/1:197
 * are hidden duplicates in the file — ignored.
 *
 * The page's first dark section: full-bleed #161616, 1728x1049 at
 * design width. It sits IN FLOW after the hero's scroll runway and
 * slides up OVER the full-screen video (which stays fixed beneath) —
 * the arrival IS the light->dark transition; see landing.css.
 *
 * HEADLINE: the Figma text node leads with a run of 20 spaces — it
 * renders as a deliberate editorial indent on the first line (clear
 * in the file's own render), so it is KEPT, implemented as an
 * explicit text-indent on line 1 rather than literal whitespace.
 * The four spans are the design's rendered line breaks at the fixed
 * 900px measure (line-reveal needs per-line elements — the hero's
 * established nowrap-span pattern).
 *
 * BUTTONS: non-navigating placeholders — Oscar hasn't specified
 * destinations (flagged in the report). Their Figma widths (181/195)
 * fall out naturally from 16px pads + 8px icon gap. The 12x12 arrow
 * is the file's vector, inlined with currentColor (hardcoded white
 * fill stripped) so each button is one composable unit.
 *
 * IMAGES: all three masks in the file are PLAIN RECTANGLES (no
 * radius), so the crops are replicated with overflow-hidden windows
 * and the source images at the file's exact dimensions and offsets.
 * The second portrait window stacks two layers in Figma; the Ashley
 * layer fully occludes the one beneath, so only it is rendered.
 *
 * PENDING SIGN-OFF: all three photographs are the file's own assets,
 * placeholder-until-approved per the standing content policy.
 */
import { asset } from '../../utils/asset.js';

const foundersPhoto = asset('/assets/landing/founders/founders-photo.jpg');
const robboPortrait = asset('/assets/landing/founders/robbo-portrait.jpg');
const ashleyPortrait = asset('/assets/landing/founders/ashley-portrait.jpg');
---

{/* The track is the section's scroll runway: section height + the
    landed HOLD (the "resistance" dwell) + the exit window. The
    section rides position:sticky inside it — pinned while items
    land, hold, exit upward and the ground fades to the hero grey —
    then releases exactly as its own bottom meets the track's. */}
<div class="landing-founders-track" data-landing-founders-track>
  <section class="landing-founders" data-landing-founders aria-label="The founders">
  {/* WHO WE ARE label (frame 16:204, 2026-08-13) — desktop only
      (display:none below the seam; the approved mobile frames carry
      no label). Enters with the drift scrub on the headline's
      amplitude (landing-founders.js driftSpec — desktop branch). */}
  <p class="landing-founders__label" data-landing-founders-label>WHO WE ARE</p>
  <h2 class="landing-founders__headline" data-landing-founders-headline>
    <span class="landing-founders__line landing-founders__line--indent"
      >NEARLY 20 YEARS BUILDING</span
    >
    <span class="landing-founders__line">GLOBAL RELATIONSHIPS MEETS 30</span>
    <span class="landing-founders__line">YEARS AT THE HEART OF MUSIC,</span>
    <span class="landing-founders__line">FILM AND TELEVISION.</span>
  </h2>

  {/* Destinations ruled (Oscar, 2026-08-27): THE FOUNDERS -> /founders,
      FEATURED WORK -> /work. The "unspecified" flag is retired. */}
  <div class="landing-founders__ctas" data-landing-founders-ctas>
    <a class="landing-founders__btn" href="/founders" data-char-ripple-trigger>
      <span data-char-ripple>THE FOUNDERS</span>
      <svg
        class="landing-founders__btn-arrow"
        viewBox="0 0 12 12"
        aria-hidden="true"
        data-char-ripple-arrow
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M1.77477 12L0.917669 11.0884L0.0605699 10.2313L8.33333 2.15152L2.16746e-07 2.15151L0 0H12V12L9.84848 12L9.84848 3.66667L1.77477 12Z"
          fill="currentColor"
        />
      </svg>
    </a>
    <a class="landing-founders__btn" href="/work" data-char-ripple-trigger>
      <span data-char-ripple>FEATURED WORK</span>
      <svg
        class="landing-founders__btn-arrow"
        viewBox="0 0 12 12"
        aria-hidden="true"
        data-char-ripple-arrow
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M1.77477 12L0.917669 11.0884L0.0605699 10.2313L8.33333 2.15152L2.16746e-07 2.15151L0 0H12V12L9.84848 12L9.84848 3.66667L1.77477 12Z"
          fill="currentColor"
        />
      </svg>
    </a>
  </div>

  {/* Exact Figma crops: window = mask rect, image = source layer at the
      file's dimensions/offsets. PENDING SIGN-OFF (placeholder photos).

      grid-space (mobile rebuild 2026-08-13): a STATIC, unstyled-on-
      desktop wrapper — the three figures keep the section as their
      absolute containing block, and the wrapper collapses to zero
      height, so the desktop render is untouched. On mobile it is the
      Figma grid (file 0:20): portraits stacked left, the photo right,
      and the positioning context for the scrubbed expansion toward
      the 402×400 keyframe (0:58); its height is the push the scrub
      applies to everything below. */}
  <div class="landing-founders__grid-space" data-fd-grid>
  <figure class="landing-founders__photo" data-landing-founders-img>
    <img src={foundersPhoto} alt="" loading="lazy" decoding="async" />
  </figure>
  {/* Portrait hover (Oscar's rev): hovering one dims the other to 20%
      and reveals the subject's name over the hovered image — Serrif
      Medium 32, white, difference-blended, 24px from the image's left
      and bottom, free to bleed past the image (the crop now lives on
      an inner wrapper so the figure itself doesn't clip). Cursor reads
      clickable but nothing navigates YET — destinations to come, at
      which point these become real links with focus semantics
      (flagged). Name spelling "Robbo McCullum" pending Oscar's
      confirmation. */}
  <figure
    class="landing-founders__portrait landing-founders__portrait--robbo"
    data-landing-founders-img
    data-char-ripple-trigger
  >
    <span class="landing-founders__portrait-crop">
      <img src={robboPortrait} alt="" loading="lazy" decoding="async" />
    </span>
    <span class="landing-founders__portrait-name" aria-hidden="true" data-char-ripple="in"
      >Robbo McCullum</span
    >
  </figure>
  <figure
    class="landing-founders__portrait landing-founders__portrait--ashley"
    data-landing-founders-img
    data-char-ripple-trigger
  >
    <span class="landing-founders__portrait-crop">
      <img src={ashleyPortrait} alt="" loading="lazy" decoding="async" />
    </span>
    <span class="landing-founders__portrait-name" aria-hidden="true" data-char-ripple="in"
      >Ashley Walters</span
    >
  </figure>
  </div>
  </section>
</div>
