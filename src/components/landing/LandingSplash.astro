---
/**
 * SPLASH / ENTRY SEQUENCE (/landing, first visit only) — MARKUP ONLY.
 *
 * Its critical CSS and the synchronous pre-paint decision live in
 * BaseLayout's <head> (Oscar's report: a white flash, and the
 * wordmark showing before it animated). This component renders in
 * the BODY, so anything declared here is reached AFTER the browser
 * can already paint the light page and the raw logo text — the
 * cover and the logo's hidden state must exist before first paint,
 * which only the head can guarantee.
 *
 * The cover and its hidden state MUST exist before first paint, so
 * both the styles and the show/hide decision are inline here rather
 * than in a bundled sheet (the flash-window discipline the wipe's
 * pre-paint hold established). scripts/landing/splash.js owns
 * everything after boot.
 *
 * Z 11000 — above the wipe's cover (10000), the canvas cursor
 * (9999), grain (9000), the topbar (600) and every modal.
 *
 * R48 (Oscar, 2026-09-04): when the hero ENTRY animation is on and its
 * black splash is off, this component also emits a tiny PRE-PAINT
 * script that promotes the splash's own decision into
 * `data-ne-entry="on"` on <html>. The landing's CSS keys the red
 * ground off that attribute, so the first painted frame is red rather
 * than the light hero — the flash window the head comment above is all
 * about. It lives HERE, not in BaseLayout, and behind the flag, so a
 * production build emits NOTHING of it: the served HTML of every page
 * stays byte-identical to the shipped site.
 */
import { HERO_ENTRY, HERO_ENTRY_SPLASH } from '../../data/flags.js';
import { MOBILE_MAX_WIDTH } from '../../scripts/landing/viewport.js';
const entryArmed = HERO_ENTRY && !HERO_ENTRY_SPLASH;
---
{entryArmed && (
  <script is:inline define:vars={{ MOBILE_MAX_WIDTH }}>
    (function () {
      try {
        var d = document.documentElement;
        /* The entry is DESKTOP DOM — hero-entry.js refuses to run below the seam — so below it
           the entry must not be armed at all, or the phone gets the red ground with nothing to
           clear it and no cover splash either (cherry-picked from the set-aside rebuild's
           Part 3 §6, 2026-09-09; the flag is DEV-only, so production was never affected). */
        if ((d.clientWidth || window.innerWidth) <= MOBILE_MAX_WIDTH) return;
        /* `?entry=0` suppresses the entry — so it must NOT arm the red
           ground either. Arming regardless left the red up with nothing
           to clear it (splash.js hands straight to the page beats, and
           only the entry's settle removes the stage): a red screen with
           the hero behind it. */
        if (new URLSearchParams(location.search).get('entry') === '0') return;
        /* `?entry=1` FORCES the entry, even on a return visit in the same
           tab. The entry rides the splash's gate, so forcing it means
           opening that gate here — BaseLayout's pre-paint script has
           already decided by now, and this body script still runs before
           any deferred module. (Without this the flag was inert: it only
           ever appeared to work because the tests passed &splash=1 too.) */
        if (new URLSearchParams(location.search).get('entry') === '1'
            && d.getAttribute('data-ne-splash') !== 'on') {
          d.setAttribute('data-ne-splash', 'on');
          d.classList.add('splash-active');
        }
        if (d.getAttribute('data-ne-splash') === 'on') {
          d.setAttribute('data-ne-entry', 'on');
        }
      } catch (e) {}
    })();
  </script>
)}



<div class="splash-v2" data-landing-splash aria-hidden="true">
  {/* The black cover + loading line. The logo is deliberately NOT
      in here — the cover translates away and the logo must stay. */}
  <div class="splash-v2__line" data-splash-line></div>
</div>
{/* The wordmark — a top-level SIBLING (see the CSS blend walk).
    aria-hidden: the REAL nav logo carries the accessible name; the
    document is aria-busy while splashing (splash.js). */}
<p class="splash-v2__logo" data-splash-logo aria-hidden="true">TheNetworkEffect</p>
