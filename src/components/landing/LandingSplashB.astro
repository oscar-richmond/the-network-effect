---
/**
 * SPLASH VARIANT B (R49, Oscar 2026-09-04) — MARKUP ONLY.
 *
 * Ported from the supplied reference component (counter + hairline
 * progress + clip-path image open). Ours differs in three ways, all
 * Oscar's: the ground is BRAND RED, the counter is Serrif Condensed,
 * and where the reference opens ONE image to full bleed we open THREE
 * across the middle and then TRAVEL them into the landing hero's real
 * resting row.
 *
 * The three that open are STAND-INS, not the hero's own cards: the card
 * wrappers' transforms belong to the scroll module's scrubbed exit and
 * are mirrored every frame by the WebGL planes, so the sequence lands
 * these on the real cards' measured rects and hands over (the same
 * construction hero-entry.js uses, for the same reason). They carry the
 * hero's OWN three images so the settle is the hero's real composition.
 *
 * Rendered only when LANDING_SPLASH_B is on (dev): a production build
 * emits none of this, and the route that uses it does not exist there.
 */
import { asset } from '../../utils/asset.js';
import { QUERIES } from '../../config/breakpoints.js';
import { imageSrcset } from '../../utils/thumb-srcset.js';

/* the hero cards' own sizes (LandingHero.astro) — the stand-ins land on
   those rects, so they need the same pixels */
const HERO_CARD_SIZES = `${QUERIES.phone} 260px, ${QUERIES.mobile} 33vw, 1728px`;

/* the hero's own three images — the settle must BE the hero, not a
   lookalike (LandingHero.astro's heroCards, same order) */
const heroCards = [
  asset('/assets/landing/hero/hero-1.jpg'),
  asset('/assets/landing/hero/hero-2.jpg'),
  asset('/assets/landing/hero/hero-3.jpg'),
];

/* R65 item 2c: the discard pool — placeholder, see the markup note. */
const SB_DISCARDS = [
  asset('/assets/landing/closing/tile-1.jpg'),
  asset('/assets/landing/network/strip-2.jpg'),
  asset('/assets/landing/closing/tile-4.jpg'),
];
---

{/* THE GATE. BaseLayout's pre-paint script arms the splash only for `/`
    and `/landing` (`if (!/^\/(?:landing\/?)?$/.test(pathname)) return`),
    so this route would never get one. Rather than widen that regex —
    which lives in BaseLayout and would change the emitted script on
    every production page — this component arms it for itself. It is
    flag-gated, so a production build emits none of this. `?splash=0`
    still suppresses, for viewing the page without the sequence. */}
<script is:inline>
  (function () {
    try {
      if (new URLSearchParams(location.search).get('splash') === '0') return;
      var d = document.documentElement;
      d.setAttribute('data-ne-splash', 'on');
      /* R78 (Oscar, 2026-09-05) — A FAILSAFE THAT DOES NOT DEPEND ON THE
         MODULE, the page cover's own construction ("FAILSAFE 1 of 3").
         Since R76 the stage is on screen from first paint, revealed by
         the attribute above rather than by splash-b.js — so if that
         module never arrives (a hung chunk fetch, blocked JS) nothing
         would ever clear the red: its 20s failsafe lives INSIDE it. The
         module marks `sb-on` on <html> the moment it arms; if that mark
         is absent after SB_BOOT_FAILSAFE_MS the sequence is not coming,
         and this hands the page back — stage hidden, gate and scroll
         lock released. Once `sb-on` is present the module owns the load
         and this does nothing. Cold on the CDN the chunk arms in ~1.5s;
         six seconds is a hung fetch, not a slow one. */
      var SB_BOOT_FAILSAFE_MS = 6000;
      setTimeout(function () {
        if (d.classList.contains('sb-on') || d.classList.contains('sb-landed')) return;
        var st = document.querySelector('[data-splash-b]');
        if (st) st.style.display = 'none';
        d.removeAttribute('data-ne-splash');
        d.classList.remove('splash-active');
        d.style.overflow = ''; document.body && (document.body.style.overflow = '');
      }, SB_BOOT_FAILSAFE_MS);
    } catch (e) {}
  })();
</script>

<div class="splash-b" data-splash-b aria-hidden="true">
  {/* THE GROUND — brand red behind the whole sequence (the reference's
      near-black). Its own layer, so nothing fights the hero's ground,
      which the scroll fade already owns. */}
  <div class="splash-b__ground" data-sb-ground></div>

  {/* THE THREE — each opens from a point via clip-path, then travels.
      Placed and sized entirely by splash-b.js from the live hero. */}
  {heroCards.map((src, i) => (
    <div class="splash-b__card" data-sb-card style={`z-index:${20 + i}`}>
      <img src={src} srcset={imageSrcset(src, [780], 960)} sizes={HERO_CARD_SIZES} alt="" decoding="async" loading="eager" />
    </div>
  ))}

  {/* R65 item 2c (Oscar, 2026-09-04) — THE THREE DISCARDS. They arrive
      FIRST, are stacked under the hero's three, and clear before the
      travel. PLACEHOLDER PENDING OSCAR'S SELECTION: chosen from the
      unflagged pool already on the site — the closing section's tiles
      and the network strip — picked to be visually distinct from the
      hero three (an interior, a landscape and a crowd against the hero's
      still life, portrait and helicopter) so the swap reads clearly.
      Below the hero cards in z, so the hero three land on top of the
      pile as they arrive. */}
  {SB_DISCARDS.map((src, i) => (
    <div class="splash-b__card splash-b__card--discard" data-sb-discard style={`z-index:${10 + i}`}>
      <img src={src} srcset={imageSrcset(src, [480, 600], 900)} sizes={`${QUERIES.phone} 200px, ${QUERIES.mobile} 33vw, 1728px`} alt="" decoding="async" loading="eager" />
    </div>
  ))}

  {/* THE COUNTER — the reference's geometry verbatim: bottom-left,
      transform-origin left bottom, scaling 0.25 → 1 as it counts.
      Serrif Condensed Medium per Oscar. Digits are fixed-width cells:
      the face's numerals are PROPORTIONAL ("1" is 134px where "0" is
      244px at 400px), so a live count would lurch on almost every tick
      against a left origin — tabular figures, which this face does
      carry, hold every digit at one advance. */}
  <div class="splash-b__counter" data-sb-counter>
    <p class="splash-b__count" data-sb-count>0</p>
  </div>

  {/* THE HAIRLINE — draws scaleX 0 → 1 across the same 3s, then wipes
      away left → right as the images appear (R54 item 7). The
      reference's second `.progress` fill that used to ride over it is
      removed with the mechanism. */}
  <div class="splash-b__bar" data-sb-bar></div>
</div>
