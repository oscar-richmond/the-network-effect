---
/**
 * FEATURED WORK (/landing) — Figma 22:3021, extracted 2026-08-06;
 * 83px chrome offset subtracted. Horizontal gallery between the
 * services stack and Our Network.
 *
 * The section overlaps the services section's trailing viewport
 * (margin-top -100dvh, the Network device): its top lands exactly
 * at the services scrub end, so the departing stack scrolling off
 * the top and this section rising from the bottom read as one
 * continuous page scroll — light on light, no dead viewport.
 * Pins at 'top top', travels horizontally through all 8 cards
 * (landing-featured.js), then the RELOCATED Beat F (constants
 * verbatim) fades to black into Our Network — which enters exactly
 * as before, one section later.
 *
 * z-index 260 — the exit gate over the fixed hero stage.
 *
 * BLEND: FEATURED/WORK are white difference over the bare ground
 * only (bands 180-270; cards start at 352 — no overlap). Their
 * ancestor chain is the bare sticky stage; the strip's transform is
 * a later sibling. The reveal animates lr-inner descendants.
 *
 * VIEW ALL: the MORE INFO family at Oscar's revved 14px/10.5-arrow
 * treatment (the file's 16px predates that rev — his call).
 * Links to /work (the Featured Work page).
 *
 * R15 (Oscar 2026-09-02, desktop): FEATURED WORK is a SECTION LABEL
 * now (the WHAT WE DO / OUR NETWORK eyebrow tier, 24 from the left,
 * ink 180 below the section above); the card titles are 28/30 on
 * this surface; the carousel UNIT (images + names) centres between
 * the nav wordmark's bottom and the viewport bottom; VIEW ALL sits
 * 80 below the unit, horizontally centred, and departs with it.
 * All written by landing-featured.js place().
 *
 * Content/rights flags live in src/data/landing/featured-work.js.
 */
import { asset } from '../../utils/asset.js';
import { QUERIES } from '../../config/breakpoints.js';
import { LIVE_CASE_SLUGS } from '../../data/landing/case-studies.js';
import { FEATURED_CARDS } from '../../data/landing/featured-work.js';
import GradualBlur from '../GradualBlur.astro';
import { imageSrcset } from '../../utils/thumb-srcset.js';

/* THE REBUILD (2026-09-07): the cards render on every width — a 680
   variant for the phone's 78vw card and the tablet's 380; the desktop's
   sizes branch is larger than any candidate, so it keeps the full file. */
/* the phone's card renders 304px (the rail) or 167px (/work's grid): 200px
   resolves a 3× phone to the 600 candidate — the density cap (THE FINAL GATE) */
const CARD_SIZES = `${QUERIES.phone} 200px, ${QUERIES.mobile} 380px, 1728px`;
const cardSrcset = (src) => imageSrcset(src, [600, 680], 2000);
---

{/* THE REBUILD (2026-09-07): below the seam this same markup is a
    touch-scrolled rail (landing-narrow.css) — the desktop's staggered
    strip, panned by the finger instead of scrubbed by the page. */}
<section class="landing-featured" data-landing-featured data-ground="dark" data-ground-fade data-ground-fade-anchor="[data-landing-services]" data-ground-fade-anchor-y="--m-fade-anchor-nav" aria-label="Featured work">
  <div class="landing-featured__stage" data-featured-stage>
    <h2 class="landing-featured__header">
      <span class="landing-featured__hl landing-featured__hl--featured" data-featured-line>FEATURED</span>
      <span class="landing-featured__hl landing-featured__hl--work" data-featured-line>WORK</span>
    </h2>

    {/* -> /work (the Featured Work page; was an inert placeholder). */}
    {/* R17 (Oscar 2026-09-02): "VIEW ALL WORK" on DESKTOP — the chip
        is content-derived (padding + label + arrow), so it widens with
        the label; landing-featured.js place() centres it from its
        LIVE measured width (no stored offset), so it re-centres by
        itself. The label is authored twice and toggled at the 1024
        seam (landing.css) so the MOBILE chip keeps "VIEW ALL" and its
        rendered DOM stays byte-identical (the wordmark's own seam
        device); the ripple wraps both, the hidden one is inert. */}
    <a class="landing-featured__viewall" href="/work" data-featured-viewall data-char-ripple-trigger>
      <span class="landing-featured__viewall-label--m" data-char-ripple>VIEW ALL</span>
      <span class="landing-featured__viewall-label--d" data-char-ripple>VIEW ALL WORK</span>
      <img src={asset('/assets/landing/services-stack/more-arrow.svg')} alt="" width="12" height="12" data-char-ripple-arrow />
    </a>

    <div class="landing-featured__strip" data-featured-strip data-carousel-strip>
      {/* A REAL LINK to the study (Oscar's rev — was an inert
          <article>). data-live gates it exactly as /work's tiles do:
          unbuilt studies stay inert placeholders, and data-work-link
          is what the shared VIEW CASE STUDY cursor hit-tests on, so
          the carousel reads like /work. */}
      {FEATURED_CARDS.map((card) => (
        LIVE_CASE_SLUGS.includes(card.slug) ? (
        <a
          class="landing-featured__card"
          href={`/work/${card.slug}`}
          data-featured-card
          data-work-link
          data-slug={card.slug}
          data-live="true"
        >
          <figure class="landing-featured__imgwin" aria-hidden="true">
            <img
              src={card.img.src}
              srcset={cardSrcset(card.img.src)}
              sizes={CARD_SIZES}
              alt=""
              loading="lazy"
              decoding="async"
              class={card.img.cover ? 'is-cover' : ''}
              style={card.img.cover ? '' : `width:${card.img.w}px;height:${card.img.h}px;left:${card.img.x}px;top:${card.img.y}px`}
            />
          </figure>
          <h3 class="landing-featured__titleblock">
            {card.title.map((line, i) => (
              <span class="landing-featured__titleline">
                {line}
                {i === card.title.length - 1 && (
                  <span class="landing-featured__index">{card.index}</span>
                )}
              </span>
            ))}
          </h3>
          {/* 16px below the SINGLE welded 38px title line (the old
              per-entry ×28 formula predates the welded single-line R2;
              titles are one rendered line at Section 34/38 now). (image 24 / title 16 —
              the closing-keywords rhythm). */}
          <p class="landing-featured__desc" style={`top:${459 + 38 + 8.5}px`}>{card.desc}</p>
        </a>
        ) : (
        <span
          class="landing-featured__card is-placeholder"
          data-featured-card
          data-slug={card.slug}
          data-live="false"
          data-a4-note="unbuilt study: inert placeholder — no href, no data-work-link, unfocusable"
        >
          <figure class="landing-featured__imgwin" aria-hidden="true">
            <img
              src={card.img.src}
              srcset={cardSrcset(card.img.src)}
              sizes={CARD_SIZES}
              alt=""
              loading="lazy"
              decoding="async"
              class={card.img.cover ? 'is-cover' : ''}
              style={card.img.cover ? '' : `width:${card.img.w}px;height:${card.img.h}px;left:${card.img.x}px;top:${card.img.y}px`}
            />
          </figure>
          <h3 class="landing-featured__titleblock">
            {card.title.map((line, i) => (
              <span class="landing-featured__titleline">
                {line}
                {i === card.title.length - 1 && (
                  <span class="landing-featured__index">{card.index}</span>
                )}
              </span>
            ))}
          </h3>
          {/* 16px below the SINGLE welded 38px title line (the old
              per-entry ×28 formula predates the welded single-line R2;
              titles are one rendered line at Section 34/38 now). (image 24 / title 16 —
              the closing-keywords rhythm). */}
          <p class="landing-featured__desc" style={`top:${459 + 38 + 8.5}px`}>{card.desc}</p>
        </span>
        )
      ))}
    </div>

    {/* (The retired mobile design's swipe indicator is gone with the
        2026-09-07 rebuild: the desktop has none — its "more" affordance
        is the blurred right edge below, which the phone keeps.) */}

    {/* Right-edge blur (Oscar's rev 2 — the FULL Access treatment):
        the same-colour gradient TINT under the GradualBlur band
        (the access edge construction: light must diffuse near the
        edge so the blur reads as blurred #EEEEF0, not just soft
        imagery). Strip z1 < tint/band z2 < VIEW ALL z3; static on
        the stage — items blur as they pass beneath; the tint drains
        WITH the band's end-of-travel dissolve (landing-featured.js),
        as the access exit drains its own. */}
    <div class="landing-featured__edge-tint" aria-hidden="true" data-featured-edge-tint></div>
    <GradualBlur
      target="parent"
      position="right"
      strength={3}
      width="12rem"
      height="100%"
      divCount={2}
      exponential={true}
      opacity={0.8}
      zIndex={2}
    />
  </div>

  {/* The shared [ VIEW CASE STUDY + ] cursor — a top-level element
      inside the section, carrying difference itself (see
      view-case-cursor.js). */}
  <div class="work-cursor" data-featured-cursor aria-hidden="true">( VIEW CASE STUDY + )</div>
</section>
