---
/**
 * OUR NETWORK (/landing) — Figma n2cY4c7GnsR5MBx1PJoC97 node 3:68,
 * extracted 2026-08-04. Chrome mockup (3:639-3:642) and nav mockup
 * (3:644) ignored; geometry below is the design's own container with
 * the 83px chrome offset subtracted.
 *
 * Arrives via the services transition (landing-services.js): the
 * outro's text fades, its ground darkens to #161616, and this
 * section (same black) enters — a black-on-black boundary, no seam.
 *
 * CAROUSELS: two autonomous marquee rows (top drifts RIGHT, bottom
 * LEFT), pure CSS keyframe animation on the tracks — compositor-only
 * transforms, no rAF, no ScrollTrigger, zero interaction with the
 * Lenis/GSAP scroll graph. Each row renders the 9-brand set TWICE;
 * one set is exactly 1728px (9 x 160 cells + 9 x 32 gaps), so a
 * translate of one set width loops seamlessly at any viewport up to
 * the design width. Speeds are the two custom properties on the
 * section (--network-marquee-*). No hover pause (Oscar's instinct:
 * ambient, not interactive — one line to add if he reverses).
 *
 * PENDING FOUNDER SIGN-OFF: the brand set names real companies — see
 * the flag in src/data/landing/network-brands.js. The five strip
 * photographs are the file's own assets, placeholder-until-approved
 * per the standing content policy.
 */
import { NETWORK_BRANDS } from '../../data/landing/network-brands.js';
import { QUERIES } from '../../config/breakpoints.js';

interface Props {
  /** Entrance anchor: 'pin' (default — the landing's bottom-aligned
   *  pin moment) or 'prev-exit' (fire as the PRECEDING sibling's
   *  bottom clears the viewport top — /services; the offset is
   *  measured live in landing-network.js). */
  entry?: 'pin' | 'prev-exit';
}

const { entry = 'pin' } = Astro.props;
import { asset } from '../../utils/asset.js';
import { imageSrcset } from '../../utils/thumb-srcset.js';

/* The resting strip lives in network-strip-sets.js now (the industry
   hover swaps these five — single source of truth for the default). */
import { NETWORK_STRIP_DEFAULT, NETWORK_STRIP_HOME } from '../../data/landing/network-strip-sets.js';

/* R23 (Oscar, 2026-09-03): the LANDING (entry 'pin') renders the
   frame 1:67 crops for its 421 strip (NETWORK_STRIP_HOME); /services
   (prev-exit) keeps the shipped default byte-for-byte. */
const strip = (entry === 'pin' ? NETWORK_STRIP_HOME : NETWORK_STRIP_DEFAULT).map((s) => ({ ...s, src: asset(s.src) }));

/** The set is rendered twice per row for the seamless wrap. */
const doubled = [...NETWORK_BRANDS, ...NETWORK_BRANDS];

/* The sector lines — now STRUCTURED for the industry hover (each
   term its own focusable element) while preserving the authored
   layout exactly: the separators carry the double-space-slash runs
   as expression strings (white-space: pre keeps them; the reveal
   uses the child-preserving exact wrap in landing-network.js). The
   authored line breaks are the arrays below.
   R23 (Oscar, 2026-09-03): the landing's DESKTOP list takes frame
   1:67's SINGLE-spaced " / " — the markup stays the authored double
   run (mobile and /services render it unchanged, DOM byte-identical);
   landing.css collapses the runs on the landing desktop by switching
   the lines to white-space: normal (the lines fit their 1680 box with
   room, so nothing can wrap). */
const sectorLines = [
  ['Talent', 'Hospitality', 'TV & Film', 'Music'],
  ['Luxury', 'Fashion', 'Food & Beverage', 'Sports'],
  ['Production', 'Founders', 'Cultural Operators'],
];
---

<section class="landing-network" data-landing-network data-ground="dark" data-network-entry={entry} aria-label="Our network">
  {/* Sticky stage (Oscar's arrival rev): the section slides into the
      viewport as PURE BLACK (text hidden in reveal clips, media
      parked below the stage) — invisible against the services fade —
      then pins, and one synchronized entrance fires: the text
      reveals IN PLACE (hero-copy mechanism) while the logo rows +
      photo strip rise from the viewport bottom on the same curve
      and duration, everything landing together (landing-network.js).
      The hold runway absorbs scroll while it plays. */}
  <div class="landing-network__stage" data-landing-network-stage>
  <h2 class="landing-network__title" data-landing-network-title>
    <span class="landing-network__line"
      ><span class="landing-network__title-serrif">OUR </span>NETWORK</span
    >
  </h2>

  <p class="landing-network__subtitle" data-landing-network-subtitle>
    <span class="landing-network__line">Trusted by founders and</span>
    <span class="landing-network__line">brands across culture AND commerce.</span>
  </p>

  <p class="landing-network__body" data-landing-network-body>
    {sectorLines.map((terms) => (
      <span class="landing-network__line">{terms.map((term, i) => (
        <Fragment>{i > 0 && <span class="landing-network__sep">{'  /  '}</span>}<button
          type="button"
          class="landing-network__term"
          data-network-term={term}
        >{term}</button></Fragment>
      ))}</span>
    ))}
  </p>

  {/* OUR NETWORK label (frame 16:733, 2026-08-13) — desktop only;
      replaces the big title above the seam (the title keeps mobile).
      Placed AFTER the body in DOM so the title/subtitle/body reveal
      stagger indexes are untouched; the label takes the next slot in
      the same line-reveal set. */}
  <p class="landing-network__label" aria-hidden="false"><span class="landing-network__line">OUR NETWORK</span></p>

  {/* Marquees — MOBILE ONLY since R9 (Oscar, 2026-09-02): desktop
      removed the logo carousels and their band backdrop (landing.css
      hides these ≥1025 — out of layout, entrance and paint; the
      markup survives for the mobile build's own 64px rows). aria-
      hidden: an infinite ambient logo drift is noise to AT; the brand
      claims read from the (pending) copy instead. */}
  <div
    class="landing-network__marquee landing-network__marquee--top"
    data-landing-network-row
    aria-hidden="true"
  >
    <div class="landing-network__track landing-network__track--right">
      {doubled.map((b) => (
        <span class="landing-network__cell">
          <img
            src={b.src}
            alt=""
            loading="lazy"
            decoding="async"
            style={`width:${b.w}px;height:${b.h}px`}
          />
        </span>
      ))}
    </div>
  </div>

  <div
    class="landing-network__marquee landing-network__marquee--bottom"
    data-landing-network-row
    aria-hidden="true"
  >
    <div class="landing-network__track landing-network__track--left">
      {doubled.map((b) => (
        <span class="landing-network__cell">
          <img
            src={b.src}
            alt=""
            loading="lazy"
            decoding="async"
            style={`width:${b.w}px;height:${b.h}px`}
          />
        </span>
      ))}
    </div>
  </div>

  {/* The file's gradient band (3:509): #161616 fading down over the
      photo strip's top, backing the logo rows — sampled from the
      file's export (98% -> 0 alpha, linear, horizontally uniform)
      and reproduced as CSS rather than the 1024px-wide png. */}
  <div class="landing-network__row-fade" aria-hidden="true"></div>

  {/* Photo strip — exact Figma crops (plain-rect masks), edge to edge.
      PENDING SIGN-OFF (placeholder photos). */}
  <div class="landing-network__strip" data-landing-network-strip aria-hidden="true">
    {strip.map((s) => (
      <span class="landing-network__strip-win" style={`width:${s.win}px`}>
        <img
          src={s.src}
          srcset={imageSrcset(s.src, [480], 640)}
          sizes={`${QUERIES.phone} 160px, ${QUERIES.mobile} 205px, 640px`}
          alt=""
          loading="lazy"
          decoding="async"
          style={`width:${s.w}px;height:${s.h}px;left:${s.x}px;top:${s.y}px`}
        />
      </span>
    ))}
  </div>

  {/* The file's edge gradient (3:620): masks the carousel/strip edges
      into the section ground. */}
  <div class="landing-network__edge-fade" aria-hidden="true"></div>
  </div>
</section>
