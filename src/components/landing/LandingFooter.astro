---
/**
 * FOOTER (/landing) — Figma 21:2392, extracted 2026-08-06; 83px
 * chrome offset subtracted; coordinates below are FOOTER-RELATIVE
 * (footer top = page 1050). #232A89 surface, 830px, document flow.
 * z-index 260 (the exit gate over the fixed hero stage).
 *
 * The nav's difference blend over this blue inverts to a yellowish
 * tone — correct compositing, deliberately not suppressed.
 *
 * LINK DESTINATIONS (per direction):
 * - home + BACK TO TOP -> smooth Lenis scroll to page top.
 * - services / clients / selected work -> NON-NAVIGATING
 *   placeholders (pages don't exist yet).
 * - "the founders" is grey per the file — AMBIGUOUS whether it's a
 *   column label or a nav item; built as a non-link grey line
 *   matching the file, flagged for later resolution.
 * - START A PROJECT -> the established mailto
 *   (hello@networkeffectagency.co.uk).
 * - Email: hello@networkeffectagency.co.uk everywhere — the
 *   CANONICAL ruling lives in data/menu.js (Oscar, FINAL,
 *   2026-08-27); the 2026-08-26 re-resolution to the old domain is
 *   reversed and both footer families now agree.
 * - LINKEDIN / INSTAGRAM: placeholder hrefs pending real profile
 *   URLs. (File's "INSTATGRAM" typo fixed.)
 *
 * PENDING FOUNDER SIGN-OFF: the masked image is the file's export.
 *
 * THEMES (Oscar's build 2026-08-08): `theme` picks the colourway —
 * 'blue' (default, this file's original #232A89 scheme) or 'light'
 * (the /services file's second official colourway: #EEEEF0 ground /
 * #161616 ink / #A6A6A8 muted — colour-only overrides in
 * landing.css; the arrows swap to exact #161616 variants rather
 * than a filter). Structure, links, and animations are identical.
 * R16 (Oscar 2026-09-02): the GREY/WHITE footer of Figma
 * L3MtStuayLmiag1JOIzDfJ node 3:67 extracts to EXACTLY this 'light'
 * colourway — ground #EEEEF0; statement #161616 with the two-tone
 * split to #A6A6A8; links #161616; column labels #A6A6A8; no
 * dividers drawn. The frame's START A PROJECT chip is drawn #EEEEF0
 * on #EEEEF0 with an #EEEEF0 label (invisible in the file — a stale
 * layer); the theme keeps its #161616 chip / #EEEEF0 label (flagged).
 * The landing uses it after the red statement band; the other pages
 * stay blue pending the global ruling.
 */
import { asset } from '../../utils/asset.js';
import { SOCIAL_LINKS } from '../../data/landing/socials.js';

/* The footer renders Linkedin before Instagram (frame order). */
const FOOTER_SOCIALS = ['linkedin', 'instagram']
  .map((k) => SOCIAL_LINKS.find((s) => s.key === k))
  .filter(Boolean);

interface Props {
  theme?: 'blue' | 'light';
  /* R32 item 5 (Oscar, 2026-09-03) — a PAGE-SCOPED flag, not a fork:
     'scrub' marks the desktop bottom row (data-footer-row-scrub) so the
     hosting page's driver enters its items from ITS reveal progress
     (footer-motion.js then leaves them out of the one-shot word wrap).
     Only /founders passes it — its band-carried reveal exposes the row
     before the one-shot fires. Every other page omits the prop and
     renders byte-identical markup. */
  rowEntrance?: 'static' | 'scrub';
}

const { theme = 'blue', rowEntrance = 'static' } = Astro.props;
const arrowNe = asset(theme === 'light' ? '/assets/landing/closing/arrow-ne-dark.svg' : '/assets/landing/closing/arrow-ne.svg');
const arrowUp = asset(theme === 'light' ? '/assets/landing/closing/arrow-up-dark.svg' : '/assets/landing/closing/arrow-up.svg');
import { START_PROJECT_MODAL, START_PROJECT_MAILTO } from '../../data/flags.js';
---

<footer
  class:list={['landing-footer', { 'landing-footer--light': theme === 'light' }]}
  data-landing-footer
  aria-label="Site footer"
>
  {/* Index columns */}
  <div class="landing-footer__cols" data-footer-legacy>
    <nav class="landing-footer__col" data-footer-col aria-label="Site index">
      <p class="landing-footer__label">SITE INDEX</p>
      <a class="landing-footer__link" href="/" data-footer-top data-char-ripple-trigger><span data-char-ripple>HOME</span></a>
      {/* Placeholders — pages don't exist yet. */}
      <span class="landing-footer__link is-placeholder" data-hover data-char-ripple-trigger><span data-char-ripple>SERVICES</span></span>
      <span class="landing-footer__link is-placeholder" data-hover data-char-ripple-trigger><span data-char-ripple>CLIENTS</span></span>
    </nav>
    <nav class="landing-footer__col landing-footer__col--2" data-footer-col aria-label="More">
      {/* RESOLVED (2026-08-08): /founders exists — the grey label is
          a LINK now, the white link treatment (the ambiguity flag in
          the header is settled). */}
      <a class="landing-footer__link" href="/founders" data-char-ripple-trigger><span data-char-ripple>THE FOUNDERS</span></a>
      <span class="landing-footer__link is-placeholder" data-hover data-char-ripple-trigger><span data-char-ripple>SELECTED WORK</span></span>
    </nav>
    <a
      class="landing-footer__start"
      data-footer-col
      href={START_PROJECT_MODAL ? '#start-project' : START_PROJECT_MAILTO}
      data-start-project={START_PROJECT_MODAL ? '' : undefined}
      data-char-ripple-trigger
    >
      <span data-char-ripple>START A PROJECT</span>
      <img src={arrowNe} alt="" width="10.5" height="10.5" data-char-ripple-arrow />
    </a>
  </div>

  {/* Masked image — topmost visible layer, exact crop. */}
  <figure class="landing-footer__img" data-footer-img data-footer-legacy aria-hidden="true">
    <img
      src={asset('/assets/landing/closing/footer-image.jpg')}
      alt=""
      loading="lazy"
      decoding="async"
      style="width:243px;height:304px;left:-2px;top:-1px"
    />
  </figure>

  {/* Big statement — line 1 carries the file's deliberate leading
      indent, reproduced as an inline spacer element (text-indent
      breaks the reveal wrap's line grouping; the spacer rides inside
      line 1's clip as an atom, and works identically un-wrapped). */}
  <div class="landing-footer__statement" data-footer-statement data-footer-legacy>
    <p class="landing-footer__st-line" data-footer-st-line
      ><span class="landing-footer__st-indent" aria-hidden="true"></span>Culture rarely moves in public first.</p
    >
    {/* Oscar's rev: "Through people." rides line 2 after "quietly.";
        "Through relationships." holds line 3, left aligned. */}
    <p class="landing-footer__st-line" data-footer-st-line
      >It moves quietly. <span class="landing-footer__st-serrif">Through people.</span></p
    >
    <p class="landing-footer__st-line" data-footer-st-line
      ><span class="landing-footer__st-serrif">Through relationships.</span></p
    >
  </div>

  {/* Bottom row — absolute lefts per the file. */}
  <div class="landing-footer__row" data-footer-row data-footer-legacy>
    {/* File copy, mailto'd as written — differs from the site's
        established address; see header. */}
    <a class="landing-footer__rowitem landing-footer__rowitem--email" href="mailto:hello@networkeffectagency.co.uk" data-char-ripple-trigger><span data-char-ripple>HELLO@NETWORKEFFECTAGENCY.CO.UK</span></a>
    <div class="landing-footer__social">
      {/* Hrefs from the shared source (data/landing/socials.js). */}
      {FOOTER_SOCIALS.map((soc) => (
        soc.href ? (
          <a class="landing-footer__rowitem" href={soc.href} target="_blank" rel="noopener" data-char-ripple-trigger><span data-char-ripple>{soc.label.toUpperCase()}</span><img src={arrowNe} alt="" width="10.5" height="10.5" data-char-ripple-arrow /></a>
        ) : (
          <span class="landing-footer__rowitem is-placeholder" data-hover data-char-ripple-trigger><span data-char-ripple>{soc.label.toUpperCase()}</span><img src={arrowNe} alt="" width="10.5" height="10.5" data-char-ripple-arrow /></span>
        )
      ))}
    </div>
    <button type="button" class="landing-footer__rowitem landing-footer__rowitem--top" data-footer-top data-char-ripple-trigger>
      <span data-char-ripple>BACK TO TOP</span>
      <img src={arrowUp} alt="" width="11.31" height="10.48" data-char-ripple-arrow />
    </button>
    <p class="landing-footer__rowitem landing-footer__rowitem--copyright">©2026 All rights reserved</p>
    <p class="landing-footer__rowitem landing-footer__rowitem--siteby">site by  <span>SELFHOOD STUDIOS</span></p>
  </div>

  {/* ══ THE NEW DESKTOP FOOTER (frame 13:381, 2026-08-26) — the
      global structure; the legacy blocks above keep the untouched
      MOBILE footer and hide ≥1025. Small text: serif 14/16
      capitalize. Reveal attrs reuse the shipped machinery
      (footer-motion.js walks data-footer-col + data-footer-st-line). */}
  <div class="landing-footer__dtop" data-footer-desktop>
    <nav class="landing-footer__dgroup landing-footer__dgroup--index" data-footer-col aria-label="Site index">
      <p class="landing-footer__dlabel">Site Index</p>
      <a class="landing-footer__dlink" href="/" data-footer-top data-char-ripple-trigger><span data-char-ripple>Home</span></a>
      <a class="landing-footer__dlink" href="/services" data-char-ripple-trigger><span data-char-ripple>Services</span></a>
      <a class="landing-footer__dlink" href="/founders" data-char-ripple-trigger><span data-char-ripple>The Founders</span></a>
      <a class="landing-footer__dlink" href="/work" data-char-ripple-trigger><span data-char-ripple>Selected Work</span></a>
    </nav>
    {/* START A PROJECT — the frame gives no destination; wired to the
        CONFIRMED address (the shipped START A PROJECT behaviour). */}
    {/* Arrow (Oscar 2026-08-26): INLINE SVG on currentColor — it can
        never desync from the label's ink again (theme variants
        inherit automatically). Sized to the label's measured ink
        span (Dazzed Bold 16 caps: ascent 12.2 + descent 0.2 ≈
        12.4px); gaps 8 (label→arrow) / 16 (arrow→chip edge). The
        site's other arrows are separate asset-file instances with
        deliberate per-theme variants — untouched. */}
    {/* R40: opens the site-wide form modal (the href is the deep link — the
        no-JS fallback opens it on load). R41: while the modal is off
        (any build) this is the live mailto it was. */}
    <a class="landing-footer__dchip" data-footer-col href={START_PROJECT_MODAL ? '#start-project' : START_PROJECT_MAILTO} data-start-project={START_PROJECT_MODAL ? '' : undefined} data-char-ripple-trigger>
      <span data-char-ripple>START A PROJECT</span>
      <svg class="landing-footer__dchip-arrow" viewBox="0 0 12 12" width="12.4" height="12.4" aria-hidden="true" data-char-ripple-arrow>
        <path d="M2 10 L10 2 M3.6 2 H10 V8.4" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </a>
    <div class="landing-footer__dgroup landing-footer__dgroup--email" data-footer-col>
      {/* The frame's "Email adress" typo corrected (reported). */}
      <p class="landing-footer__dlabel">Email address</p>
      <a class="landing-footer__dlink" href="mailto:hello@networkeffectagency.co.uk" data-char-ripple-trigger><span data-char-ripple>Hello@networkeffectagency.co.uk</span></a>
    </div>
    <div class="landing-footer__dgroup landing-footer__dgroup--social" data-footer-col>
      <p class="landing-footer__dlabel">Social media</p>
      {/* Hrefs from the ONE shared source (data/landing/socials.js —
          the /contact chips read the same file): empty = the
          standing inert placeholder (the frame's "Instatgram" typo
          stays corrected); a URL drop there goes live everywhere. */}
      {FOOTER_SOCIALS.map((soc) => (
        soc.href ? (
          <a class="landing-footer__dlink" href={soc.href} target="_blank" rel="noopener" data-char-ripple-trigger><span data-char-ripple>{soc.label}</span></a>
        ) : (
          <span class="landing-footer__dlink is-placeholder" data-hover data-char-ripple-trigger><span data-char-ripple>{soc.label}</span></span>
        )
      ))}
    </div>
  </div>

  <div class="landing-footer__dstatement" data-footer-desktop>
    <p class="landing-footer__dst-line" data-footer-st-line
      ><span class="landing-footer__dst-indent" aria-hidden="true"></span>Culture rarely moves in public first.</p
    >
    {/* EXPLICIT break (Oscar 2026-08-26): "Through people. Through"
        completes line 2 after "quietly."; "relationships." holds
        line 3 alone — authored, so 1512-in-shell can't re-break it.
        R16 (Oscar 2026-09-02): line 3 is its OWN line element now,
        so "relationships." sits flush LEFT on the statement block's
        edge. It used to be a <br> INSIDE the grey span: the reveal
        wrap makes that span one inline-block atom, so the break
        happened inside the atom and the word landed at the span's
        left (x 543 — under "Through"), not the block's. The colour
        split and the line-2 break are unchanged; the line joins the
        reveal as the third staggered line. */}
    <p class="landing-footer__dst-line" data-footer-st-line
      >It moves quietly. <span class="landing-footer__dst-grey">Through people. Through</span></p
    >
    <p class="landing-footer__dst-line" data-footer-st-line
      ><span class="landing-footer__dst-grey">relationships.</span></p
    >
  </div>

  <div class="landing-footer__drow" data-footer-desktop data-footer-row-scrub={rowEntrance === 'scrub' ? '' : undefined}>
    {/* Inert legal placeholder (frame 13:392/13:398) — no page yet. */}
    <span class="landing-footer__ritem landing-footer__ritem--terms is-placeholder" data-footer-col data-hover data-char-ripple-trigger><span data-char-ripple>Terms &amp; Conditions</span></span>
    {/* PRIVACY POLICY (Oscar 2026-08-26, resolves the earlier flag):
        the frame's copy wins. Inert placeholder — no privacy page
        exists yet. NOTE: desktop now has NO back-to-top anywhere
        (the mobile legacy footer keeps its own) — flagged in the
        build report, deliberately not re-added elsewhere. */}
    <span class="landing-footer__ritem landing-footer__ritem--privacy is-placeholder" data-footer-col data-hover data-char-ripple-trigger>
      <span data-char-ripple>Privacy Policy</span>
    </span>
    <p class="landing-footer__ritem landing-footer__ritem--copy" data-footer-col>©2026 All rights reserved</p>
    <p class="landing-footer__ritem landing-footer__ritem--siteby" data-footer-col>Site By Selfhood Studios</p>
  </div>
</footer>


<script>
  /* A11y batch item 8: focus entering the footer scrolls the page to
     its end so the footer is uncovered — see footer-focus.js. */
  import { initFooterFocus } from '../../scripts/landing/footer-focus.js';
  initFooterFocus();
</script>
