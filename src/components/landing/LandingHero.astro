---
/**
 * NEW LANDING HERO (rebuild phase) — hero only, nothing beyond it.
 *
 * Structure is the house pattern, taken from the /about-3 hero
 * (AboutHero + about-scroll.js Phase 0) rather than reinvented:
 *
 *   .landing-hero          fixed full-viewport STAGE — never scrolls,
 *                          everything visible lives here
 *   .landing-hero-spacer   the scroll RUNWAY — an empty in-flow block
 *                          whose height JS computes from the sequence's
 *                          total scroll distance. Scrolling it is what
 *                          drives every scrubbed trigger; the stage
 *                          itself stays pinned without a GSAP pin.
 *
 * The two text blocks mirror the old hero exactly: the headline starts
 * centred and slides left to rest at x=290, and the secondary paragraph
 * sits at right:290 and reveals line by line as the headline settles.
 * Same geometry, same reveal technique (line-reveal.js clip spans).
 *
 * The video replaces the old hero's three bleeding image cards. It is a
 * FIXED, full-viewport element that is CLIPPED down to its opening
 * band — see landing.css and landing-hero-scroll.js for why the
 * expansion is a clip-path animation rather than a box resize.
 *
 * PLACEHOLDER ASSET: the video src below is a stand-in from the
 * existing library. Oscar is supplying the real file — swapping it is
 * this one line (plus the poster, if he sends one).
 */
import { asset } from '../../utils/asset.js';

const heroVideo = asset('/assets/videos/louis-vuitton.mp4');
/* R8: the desktop three-image hero (see the markup note). */
const heroCards = [
  asset('/assets/landing/hero/hero-1.jpg'),
  asset('/assets/landing/hero/hero-2.jpg'),
  asset('/assets/landing/hero/hero-3.jpg'),
];
---

<div class="landing-hero" data-landing-hero aria-hidden="true">
  <div class="landing-hero__bg"></div>

  {/* HEADLINE — starts centred, slides left. Two lines, two families:
      line 1 Dazzed Bold, line 2 Serrif Medium, both 48px #161616. */}
  <div class="landing-hero__headline" data-landing-hero-headline>
    <div class="landing-hero__headline-text" data-landing-hero-headline-text>
      <p class="landing-hero__headline-line landing-hero__headline-line--dazzed">
        BUILT ON TRUST.
      </p>
      <p class="landing-hero__headline-line landing-hero__headline-line--serrif">
        POWERED BY ACCESS.
      </p>
    </div>
  </div>

  {/* SECONDARY COPY — revealed line by line once the headline has
      moved. Hidden from first paint until the scroll module has
      wrapped its lines (same flash-guard as the old hero). */}
  <div class="landing-hero__intro" data-landing-hero-intro>
    <div class="landing-hero__intro-text" data-landing-hero-intro-text>
      {/* Frame 16:113 copy (16:117) — ONE statement now; the old
          two-paragraph credentials copy moved on (the founders
          headline carries the 20/30-years line). Desktop-only either
          way: mobile skips Beat 2 and never renders the intro. */}
      <p>
        We connect Talent, Brands & Audiences through Experiences, Strategic
        Partnerships & Media
      </p>
    </div>
  </div>

  {/* THE THREE-IMAGE HERO (R8, Oscar 2026-09-02 — the /old hero's
      mechanic, ported): three cards in a bottom row that rise up and
      over the text on scroll (landing-hero-scroll.js drives them;
      hero-rotating-gallery.js takes them over in WebGL). DESKTOP
      ONLY — display:none under the seam; mobile keeps the video below.
      Assets: /old's hero-1 (still life) and hero-2 (editorial
      portrait — named-person class, confirmation-required, flagged);
      /old's hero-3 was Christian Dior product (third-party IP,
      elevated) and is substituted with the Thunder Aviation image
      (Oscar-supplied final, unflagged). loading=eager: the splash's
      readiness gates on their decode. */}
  <div class="landing-hero__cards" data-landing-hero-cards aria-hidden="true">
    {heroCards.map((src) => (
      <div class="landing-hero__card" data-landing-hero-card>
        <img src={src} alt="" decoding="async" loading="eager" data-landing-hero-card-img />
      </div>
    ))}
  </div>

  {/* VIDEO — MOBILE ONLY now (R8): desktop hides it and runs the
      three-image hero above; the mobile build keeps its band
      expansion untouched (its own ruling comes with the new mobile
      designs). Always laid out full-viewport there; what changes on
      scroll is the CLIP, not the box. See landing.css. */}
  <video
    class="landing-hero__video"
    data-landing-hero-video
    src={heroVideo}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
</div>

{/* The runway. Height is set by landing-hero-scroll.js from the
    measured sequence length — never hard-coded here. */}
<div class="landing-hero-spacer" data-landing-hero-spacer aria-hidden="true"></div>
