---
/**
 * NEW LANDING HERO (rebuild phase) — hero only, nothing beyond it.
 *
 * Structure is the house pattern, taken from the /about-3 hero
 * (AboutHero + about-scroll.js Phase 0) rather than reinvented:
 *
 *   .landing-hero          fixed full-viewport STAGE — never scrolls,
 *                          everything visible lives here
 *   .landing-hero-spacer   the scroll RUNWAY — an empty in-flow block
 *                          whose height JS computes from the sequence's
 *                          total scroll distance. Scrolling it is what
 *                          drives every scrubbed trigger; the stage
 *                          itself stays pinned without a GSAP pin.
 *
 * The two text blocks mirror the old hero exactly: the headline starts
 * centred and slides left to rest at x=290, and the secondary paragraph
 * sits at right:290 and reveals line by line as the headline settles.
 * Same geometry, same reveal technique (line-reveal.js clip spans).
 *
 * The video replaces the old hero's three bleeding image cards. It is a
 * FIXED, full-viewport element that is CLIPPED down to its opening
 * band — see landing.css and landing-hero-scroll.js for why the
 * expansion is a clip-path animation rather than a box resize.
 *
 * PLACEHOLDER ASSET: the video src below is a stand-in from the
 * existing library. Oscar is supplying the real file — swapping it is
 * this one line (plus the poster, if he sends one).
 */
import { asset } from '../../utils/asset.js';
import { HERO_ENTRY } from '../../data/flags.js';
import {
  HERO_LOGO_BRANDS,
  HERO_LOGO_SET_W,
  HERO_LOGO_ROW_DUR_S,
  HERO_LOGO_ROW_PHASE_DELAY_S,
} from '../../data/landing/hero-logos.js';
import { gateSrcset, gateSizes } from '../../utils/thumb-srcset.js';

/* R14 (Oscar, 2026-09-02): the rolling logo row — the set rendered
   TWICE for the seamless wrap (the network carousel's own grammar). */
const heroLogosDoubled = [...HERO_LOGO_BRANDS, ...HERO_LOGO_BRANDS];

const heroVideo = asset('/assets/videos/louis-vuitton.mp4');
/* R8: the desktop three-image hero (see the markup note). */
const heroCards = [
  asset('/assets/landing/hero/hero-1.jpg'),
  asset('/assets/landing/hero/hero-2.jpg'),
  asset('/assets/landing/hero/hero-3.jpg'),
];

/* R47 (Oscar, 2026-09-04) — THE ENTRY ANIMATION's extra images: the
   /about-3 hero's own flash stack, still in the repo from that build
   (stack-02 never existed — the original set is 01 / 03 / 04). Six
   images pile up, these three drop out, the three hero cards above
   stay. Rendered only when HERO_ENTRY is on (dev); a production build
   emits none of this markup. */
const heroEntryFlash = [
  asset('/assets/about-hero/stack/stack-01.png'),
  asset('/assets/about-hero/stack/stack-03.png'),
  asset('/assets/about-hero/stack/stack-04.png'),
];
---


{/* A11y batch item 2 (Oscar, 2026-09-04): THE PROPOSITION, EXPOSED.
    The stage below is aria-hidden because it is scroll machinery —
    headline that slides, lines that reveal, a marquee, cards that
    rise — and Chrome prunes its text from the accessibility tree
    entirely, so the home page had no heading and no copy for a
    screen reader. This block is the same copy, visually hidden,
    outside the stage: the page's h1, the statement, the client
    roll-call (the nine marks are alt="" images inside the marquee).
    It is also the skip link's target on this route (the hero IS the
    first content; there is no <main> on the landing page). Zero
    layout: the utility clips it to a pixel. */}
<div class="landing-sr" id="main" tabindex="-1">
  <h1>Built on trust. Powered by access.</h1>
  <p>We connect Talent, Brands &amp; Audiences through Experiences, Strategic Partnerships &amp; Media.</p>
  <p>Trusted by {HERO_LOGO_BRANDS.map((b) => b.name).join(', ')}.</p>
</div>

<div class="landing-hero" data-landing-hero aria-hidden="true">
  <div class="landing-hero__bg"></div>

  {/* HEADLINE — starts centred, slides left. Two lines, two families:
      line 1 Dazzed Bold, line 2 Serrif Medium, both 48px #161616. */}
  <div class="landing-hero__headline" data-landing-hero-headline>
    <div class="landing-hero__headline-text" data-landing-hero-headline-text>
      <p class="landing-hero__headline-line landing-hero__headline-line--dazzed">
        BUILT ON TRUST.
      </p>
      <p class="landing-hero__headline-line landing-hero__headline-line--serrif">
        POWERED BY ACCESS.
      </p>
    </div>
  </div>

  {/* SECONDARY COPY — revealed line by line once the headline has
      moved. Hidden from first paint until the scroll module has
      wrapped its lines (same flash-guard as the old hero). */}
  <div class="landing-hero__intro" data-landing-hero-intro>
    <div class="landing-hero__intro-text" data-landing-hero-intro-text>
      {/* Frame 16:113 copy (16:117) — ONE statement now; the old
          two-paragraph credentials copy moved on (the founders
          headline carries the 20/30-years line). Desktop-only either
          way: mobile skips Beat 2 and never renders the intro. */}
      {/* R17 (Oscar 2026-09-02): 36/40 with the two lines AUTHORED —
          the reveal wrap treats <br> as a hard line separator (its own
          lw-br sentinel), so the break can't re-wrap in the 1512 shell:
          line 1 "We connect Talent, Brands & Audiences through", line 2
          "Experiences, Strategic Partnerships & Media". */}
      <p>
        We connect Talent, Brands & Audiences through<br />Experiences, Strategic Partnerships & Media
      </p>
    </div>
  </div>

  {/* THE LOGO ROW (R14, Oscar 2026-09-02 — frame 0:621): ONE rolling
      carousel between the intro and the cards — the retired Our
      Network TOP row's grammar (160×100 cells, 192 pitch, set rendered
      twice, drifts RIGHT at 48s/set; the keyframe + the --marquee-set-w
      contract are the network's own, reused) on the LIGHT ground:
      cells rgba(22,22,22,.04) + 12px backdrop blur, #161616 marks, the
      band's #eeeef0 edge fade. Position written by landing-hero-scroll.js
      (intro bottom + 80; the cards rest 80 below it). DESKTOP ONLY.
      ENTRANCE: the track fade-rises with the page entrance a beat
      after the intro (splash.js adds .is-entered). EXIT: the wrapper
      blur-fades on the text-wipe vocabulary, keyed to the LEFT card
      (its first coverer) — gone before any card reaches it. The two
      live on different elements so the CSS transition never contests
      the scrubbed writes. No blends inside; not an ancestor of the
      nav. loading=eager (tiny SVGs) but EXCLUDED from the splash's
      readiness gate. ═ PENDING SIGN-OFF: real client marks on the
      first viewport (hero-logos.js). ═ */}
  <div class="landing-hero__logos" data-landing-hero-logos aria-hidden="true">
    <div
      class="landing-hero__logos-track"
      data-landing-hero-logos-track
      style={`--marquee-set-w:${HERO_LOGO_SET_W}px;--hero-logo-row-dur:${HERO_LOGO_ROW_DUR_S}s;--hero-logo-row-delay:${HERO_LOGO_ROW_PHASE_DELAY_S.toFixed(2)}s`}
    >
      {heroLogosDoubled.map((b) => (
        <span class="landing-hero__logo-cell" data-landing-hero-logo-cell>
          <img
            src={b.src}
            alt=""
            loading="eager"
            decoding="async"
            width={b.w}
            height={b.h}
            style={`width:${b.w}px;height:${b.h}px`}
          />
        </span>
      ))}
    </div>
    <div class="landing-hero__logos-band" aria-hidden="true"></div>
  </div>

  {/* THE THREE-IMAGE HERO (R8, Oscar 2026-09-02 — the /old hero's
      mechanic, ported): three cards in a bottom row that rise up and
      over the text on scroll (landing-hero-scroll.js drives them;
      hero-rotating-gallery.js takes them over in WebGL). DESKTOP
      ONLY — display:none under the seam; mobile keeps the video below.
      Assets: /old's hero-1 (still life) and hero-2 (editorial
      portrait — named-person class, confirmation-required, flagged);
      /old's hero-3 was Christian Dior product (third-party IP,
      elevated) and is substituted with the Thunder Aviation image
      (Oscar-supplied final, unflagged). loading=eager: the splash's
      readiness gates on their decode. */}
  <div class="landing-hero__cards" data-landing-hero-cards aria-hidden="true">
    {heroCards.map((src) => (
      <div class="landing-hero__card" data-landing-hero-card>
        <img src={src} srcset={gateSrcset(src, 1024)} sizes={gateSizes(1024)} alt="" decoding="async" loading="eager" data-landing-hero-card-img />
      </div>
    ))}
  </div>

  {/* R47 — THE ENTRY STAGE (dev only, desktop only, first visit): the
      red ground, the six-image pile at the centre and the two phrases
      either side of it. Its own layer inside the hero stage, above the
      cards (120) and below the logo row's chrome; removed from the DOM
      the moment the sort lands, so nothing here survives into the
      scroll sequence. The stand-in cards carry the sort and land on
      the real cards' rects — see hero-entry.js on why the real cards
      cannot carry it themselves. */}
  {HERO_ENTRY && (
    <div class="landing-hero__entry" data-he-stage aria-hidden="true">
      <div class="landing-hero__entry-bg" data-he-ground></div>
      <div class="landing-hero__entry-header" data-he-header>
        <p class="landing-hero__entry-text" data-he-text>BUILT ON TRUST.</p>
        <p class="landing-hero__entry-text" data-he-text>POWERED BY ACCESS.</p>
      </div>
      {heroEntryFlash.map((src) => (
        <div class="landing-hero__entry-flash" data-he-flash>
          <img src={src} alt="" decoding="async" loading="eager" />
        </div>
      ))}
      {heroCards.map((src, i) => (
        <div class="landing-hero__entry-card" data-he-card style={`z-index:${[10, 12, 11][i]}`}>
          <img src={src} alt="" decoding="async" loading="eager" />
        </div>
      ))}
    </div>
  )}

  {/* VIDEO — MOBILE ONLY now (R8): desktop hides it and runs the
      three-image hero above; the mobile build keeps its band
      expansion untouched (its own ruling comes with the new mobile
      designs). Always laid out full-viewport there; what changes on
      scroll is the CLIP, not the box. See landing.css. */}
  <video
    class="landing-hero__video"
    data-landing-hero-video
    src={heroVideo}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
</div>

{/* The runway. Height is set by landing-hero-scroll.js from the
    measured sequence length — never hard-coded here. */}
<div class="landing-hero-spacer" data-landing-hero-spacer aria-hidden="true"></div>
