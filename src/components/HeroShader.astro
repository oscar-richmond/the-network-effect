---
---

<section class="hero-shader" aria-hidden="true">
  <canvas id="canvas" class="hero-shader__canvas"></canvas>
</section>

<script>
  import { initHeroShader } from '../scripts/hero-shader.js';

  const canvas = document.getElementById('canvas');
  /** @type {import('shaders/js').PreviewInstance | null} */
  let preview = null;

  initHeroShader(canvas).then((instance) => {
    preview = instance;
  });

  document.addEventListener('astro:before-swap', () => {
    preview?.destroy();
  });
</script>

<style>
  .hero-shader {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    z-index: var(--z-shader);
    padding:
      var(--safe-top)
      var(--safe-right)
      var(--safe-bottom)
      var(--safe-left);
    touch-action: none;
    -webkit-touch-callout: none;
  }

  .hero-shader__canvas {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shader {
      touch-action: auto;
    }
  }
</style>
