---
import { menuLinks, menuFooterLinks as defaultFooterLinks } from '../data/menu.js';
import { asset } from '../utils/asset.js';
import { variantOr } from '../utils/thumb-srcset.js';
import { CONTACT_EMAIL } from '../data/landing/contact.js';
import '../styles/menu.css';

/**
 * rows (optional): row-grouped links for the NEW BUILD's two-row menu
 * (SiteShell passes it). WITHOUT the prop the markup below is
 * byte-identical to the pre-prop component — the old routes render
 * exactly as before (the SiteShell-extraction precedent). data-index
 * runs GLOBALLY across rows: menu.js's hover blur/image swap keys on
 * it. Absolute hrefs (mailto:) pass through un-prefixed.
 */
interface MenuLink {
  href: string;
  label: string;
  image: string;
}
interface MenuFooterLink {
  href: string;
  label: string;
  external?: boolean;
}
interface Props {
  rows?: MenuLink[][];
  /** Footer links; omitted = the /old set (privacy + terms included). */
  footerLinks?: MenuFooterLink[];
}

const { rows = null, footerLinks = null } = Astro.props;
const menuFooterLinks = footerLinks ?? defaultFooterLinks;
const flatLinks = rows ? rows.flat() : menuLinks;

const base = import.meta.env.BASE_URL;
const defaultImage = asset(`/assets/images/menu/${flatLinks[0]?.image ?? 'home.png'}`);
/* EVERY href in this file goes through here (2026-08-27): anything
   carrying a scheme — mailto:, https:, tel: — passes through
   untouched; only real routes take the base prefix. The menu-footer
   link used to build its own `${base}${href}` ternary off the
   `external` flag, and the mailto entries carry no such flag, so the
   address shipped as /mailto:hello@… and 404'd. Routing all four
   sites through the helper means a future mailto/external href
   inherits the handling automatically. */
const linkHref = (href: string) => (href.includes(':') ? href : `${base}${href}`);
import { START_PROJECT_MODAL } from '../data/flags.js';
---

<div class="site-menu" data-menu id="site-menu" aria-hidden="true">
  <div class="site-menu__backdrop" data-menu-backdrop aria-hidden="true"></div>
  <div class="site-menu__panel" data-menu-panel tabindex="-1">
    <div class="site-menu__wrapper">
      <div class="site-menu__container">
        <nav class="site-menu__body" data-menu-body aria-label="Main">
          {
            rows ? (
              rows.map((row, rowIndex) => (
                <div class="site-menu__row">
                  {row.map((link, linkIndex) => {
                    const index = rows
                      .slice(0, rowIndex)
                      .reduce((n, r) => n + r.length, 0) + linkIndex;
                    return (
                      <>
                        {linkIndex > 0 && (
                          <span class="site-menu__sep" aria-hidden="true"><span>/</span></span>
                        )}
                        <a
                          href={linkHref(link.href)}
                          class="site-menu__link"
                          data-index={String(index)}
                          data-src={asset(`/assets/images/menu/${link.image}`)}
                        >
                          {link.label}
                        </a>
                      </>
                    );
                  })}
                </div>
              ))
            ) : (
              menuLinks.map((link, index) => (
                <a
                  href={linkHref(link.href)}
                  class="site-menu__link"
                  data-index={String(index)}
                  data-src={asset(`/assets/images/menu/${link.image}`)}
                >
                  {link.label}
                </a>
              ))
            )
          }
        </nav>

        <div class="site-menu__footer">
        {/* CTAs (NEW BUILD only — `rows` is the new-build gate, so
            /old is untouched). Oscar's rev 2: they live INSIDE the
            footer band and are bottom-aligned with the links, so
            the buttons' bottom edge sits on the links' bottom edge.
            Left edge = the wrapper's own margin, same as the nav. */}
        {rows && (
          <div class="site-menu__ctas" data-menu-ctas>
            {/* Each CTA rides its own reveal CLIP — the /landing
                services stack's MORE INFO grammar exactly (the clip
                carries the box, the button is static inside and
                rises through it); menu.js plays them on open.

                Both reuse .landing-svc-card__btn — the MORE INFO
                button from the landing services stack (Oscar's rev:
                they must match those, not the big 64px contact
                CTAs). Same class, not copied values, so the style
                and spacing can never drift from the source.

                LET'S CHAT (the desktop nav's own CTA label — the mobile
                pass, 2026-09-07; was SCHEDULE A CALL) navigates to
                /contact. START A PROJECT opens the site-wide form modal
                (R40) — the menu closes as it opens; while the modal is
                off (R41, any build) it is the placeholder it was. */}
            <span class="site-menu__ctaclip lr-clip">
              <span class="lr-inner">
                <a class="landing-svc-card__btn" href={linkHref('contact')} data-char-ripple-trigger>
                  <span data-char-ripple>LET’S CHAT</span>
                  <img src={asset('/assets/landing/services-stack/more-arrow.svg')} alt="" width="12" height="12" data-char-ripple-arrow />
                </a>
              </span>
            </span>
            <span class="site-menu__ctaclip lr-clip">
              <span class="lr-inner">
                {START_PROJECT_MODAL ? (
                <a class="landing-svc-card__btn" href="#start-project" data-start-project data-char-ripple-trigger>
                  <span data-char-ripple>START A PROJECT</span>
                  <img src={asset('/assets/landing/services-stack/more-arrow.svg')} alt="" width="12" height="12" data-char-ripple-arrow />
                </a>
                ) : (
                <span class="landing-svc-card__btn is-placeholder" data-hover data-char-ripple-trigger>
                  <span data-char-ripple>START A PROJECT</span>
                  <img src={asset('/assets/landing/services-stack/more-arrow.svg')} alt="" width="12" height="12" data-char-ripple-arrow />
                </span>
                )}
              </span>
            </span>
          </div>
        )}

          {
            menuFooterLinks.map((link) => (
              <ul>
                <li>
                  <a
                    href={linkHref(link.href)}
                    class="site-menu__footer-link"
                    data-char-ripple-trigger
                    data-email-copy={link.href.startsWith('mailto:') ? CONTACT_EMAIL : undefined}
                    {...(link.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {/* Hover = the MENU button's per-char blur ripple
                        (Oscar's rev), not an underline. */}
                    <span data-char-ripple>{link.label}</span>
                  </a>
                </li>
              </ul>
            ))
          }
        </div>
      </div>

      {/* Base + overlay pair — the /services hover-rows swap
          grammar (scripts/cover-swap.js): the incoming image wipes
          in OVER the outgoing one, which never disappears first. */}
      <div class="site-menu__image" data-menu-image aria-hidden="true">
        {/* Page-weight batch item 3 (Oscar, 2026-09-04): loading="lazy".
            This is the menu overlay's resting image — it sits inside a
            panel that is closed at height 0 on every page load, so it was
            being fetched eagerly on EVERY route for a panel most visits
            never open. The overlay's own open animation gives the fetch
            more than enough time. */}
        {/* THE MOBILE PASS (2026-09-07): below the seam the image is the
            blurred ground under the links, so a 600w variant serves it
            (the source wins there; menu.js's src swaps are the desktop's
            and keep working above the seam, where no source matches). */}
        <picture>
          <source media="(max-width: 1359px)" srcset={variantOr(defaultImage, 600)} />
          <img src={defaultImage} alt="" data-menu-image-el data-menu-image-base loading="lazy" decoding="async" />
        </picture>
        <picture>
          <source media="(max-width: 1359px)" srcset={variantOr(defaultImage, 600)} />
          <img src={defaultImage} alt="" data-menu-image-over decoding="async" hidden />
        </picture>
      </div>
    </div>
  </div>
</div>

<script>
  import { initMenu } from '../scripts/menu.js';

  let booted = false;
  const bootMenu = () => {
    if (booted) return;
    booted = true;
    const cleanup = initMenu(document);

    document.addEventListener('astro:before-swap', () => {
      cleanup();
    });
  };

  /* THE MENU FIX (2026-09-07): a splash-active load boots the menu when
     the splash announces `splash:complete` — splash-B now sends it from
     its settle like the shipped splash did — and, as a belt, once its
     failsafe horizon has passed (splash-B's hard stop is 20s; the boot
     itself is idempotent), so a splash that never announces can never
     leave the burger without a handler again. */
  if (document.documentElement.classList.contains('splash-active')) {
    document.addEventListener('splash:complete', bootMenu, { once: true });
    window.setTimeout(bootMenu, 22000);
  } else {
    bootMenu();
  }
</script>
