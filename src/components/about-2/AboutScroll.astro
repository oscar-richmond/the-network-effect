<script>
  import { initAboutScroll } from '../../scripts/about-2/about-scroll.js';

  // Disable scroll restoration so the browser doesn’t restore a mid-page
  // position before the spacer has its correct JS height.
  // NOTE: window.scrollTo(0,0) is intentionally omitted — the hero animation
  // locks scroll via body.overflow:hidden for its full duration, guaranteeing
  // scrollY=0 when the about-scroll system initialises.
  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }

  /**
   * Initialise the about-scroll galleries and animations.
   *
   * If the AboutHero loading-screen component is present on this page,
   * we defer initialisation until it fires 'about-hero:settled'.  By that
   * point the hero has switched from position:fixed → position:relative and
   * added its 100vh to the document height, so ScrollTrigger can calculate
   * all pin start/end positions correctly.
   *
   * If there is no hero (e.g. direct navigation in future), boot immediately.
   */
  const boot = () => {
    const root = document.querySelector('[data-about-scroll]');
    const cleanup = initAboutScroll(root);

    document.addEventListener('astro:before-swap', () => {
      cleanup();
    }, { once: true });
  };

  const heroEl = document.querySelector('[data-about-hero]');

  if (heroEl) {
    // Hero present — wait for the entry animation to complete before booting
    // ScrollTrigger.  The spacer is already in the flow from page load, so
    // ScrollTrigger will calculate all pin positions correctly the moment boot()
    // runs (no layout change happens between now and then).
    document.addEventListener('about-hero:settled', () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          boot();
        });
      });
    }, { once: true });
  } else {
    // No hero — boot immediately (original behaviour)
    boot();
  }
</script>

