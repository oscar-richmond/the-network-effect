import AboutParaTrio from './AboutParaTrio.astro';

const image2 = (file) => asset(`/assets/about-scroll/img2/${file}`);
const heroIntro = asset('/assets/about-scroll/hero-intro.jpg');
const ashleyTeam = asset('/assets/about-scroll/ashley-team.png');
const robboTeam = asset('/assets/about-scroll/robbo-team.png');
