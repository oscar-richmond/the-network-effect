---
import AboutHero from './AboutHero.astro';
import FoundersSection from './FoundersSection.astro';
import { asset } from '../../utils/asset.js';
import 'lenis/dist/lenis.css';

const bgFadeSrc = asset('/assets/about-hero/about-3/bg-fade.jpg');

// Landing gallery — real imagery from the TNE CIMGS pool (see
// public/assets/landing-gallery/). CONTENT STATUS: every image below
// is a social/press/Flickr-sourced STAND-IN pending licensed final
// content; captions are filename-derived placeholders pending
// founder-approved copy.
//
// COMPOSITION ARRAY — a designed, hand-set editorial layout (staggered,
// rhythmic, breathing), NOT randomness. Portrait-dominant to match the
// pool's aspect skew, with three B&W landscape moments as rhythm
// breaks; visually-heavy images are never adjacent. Per item: size
// class (see the size-class rules in about-page.css), xGap (extra
// horizontal air before the item, on top of the track's base gap) and
// yOff (vertical offset from the stage's centre line — negative rises
// above centre). This is data: content edits slot in by editing values.
const galleryItems = [
  { file: 'cult-culture-flatlay', size: 'portrait-m', xGap: 0, yOff: 40 },
  { file: 'red-car-blur', size: 'portrait-s', xGap: 48, yOff: -110 },
  { file: 'depp-bar', size: 'landscape', xGap: 72, yOff: 70 },
  { file: 'jacquemus-bag', size: 'portrait-l', xGap: 64, yOff: -70 },
  { file: 'retro-phone-cocktail', size: 'portrait-s', xGap: 88, yOff: 120 },
  { file: 'nike-dinner', size: 'portrait-m', xGap: 48, yOff: -140 },
  { file: 'kitchen-smoke', size: 'landscape', xGap: 96, yOff: 60 },
  { file: 'door-313', size: 'portrait-s', xGap: 56, yOff: -100 },
  { file: 'bottega-jacket', size: 'portrait-l', xGap: 72, yOff: 90 },
  { file: 'vinyl-candlelight', size: 'portrait-m', xGap: 48, yOff: -50 },
  { file: 'bw-stairs', size: 'portrait-s', xGap: 64, yOff: 130 },
  { file: 'lagerfeld-pharrell', size: 'landscape', xGap: 88, yOff: -60 },
].map((item, i) => ({
  ...item,
  src: asset(`/assets/landing-gallery/${item.file}.jpg`),
  label: `${item.file.replace(/-/g, ' ').toUpperCase()} /${String(i + 1).padStart(2, '0')}`,
}));
---

<AboutHero />

<!-- Scroll-scrubbed full-viewport backdrop — fades in (opacity only) as
     the hero images exit; sits above the #F9F9F9 base but below the
     tagline/intro (z 100), images/WebGL canvas (z 110) and nav (z 270).
     An eager <img> (not a CSS background) so it starts loading at page
     init and is decoded long before the fade window ~3000px down the
     scroll runway. Driven by about-scroll.js via [data-about-hero-bg-fade].

     THIS IS A STATIC STAND-IN FOR THE LIVE FOUNDERS BACKGROUND IT HANDS
     OFF TO — it must be baked from the SAME source as slide 1's video
     (founders.js's media.src) using the SAME treatment as the live
     `.founders__overlay`/`.founders__media` filter, or the handoff reads
     as two mismatched scenes (diagnosed once already: this file was
     previously baked from the pre-rearchitecture Robbo PHOTO background,
     stale the moment slide 1 became a video of an unrelated scene).
     Confirmed via live scroll-speed testing (fast fling + simulated slow
     scroll, video sampled at t≈0s and t≈3.76s at the takeover moment):
     125px of blur fully masks the frozen-frame → playing-video transition
     — no visible "pop" at any point in the loop — so a single representative
     frame is sufficient; no need to special-case scroll speed.

     REGENERATE THIS FILE whenever founders.js's Robbo `media.src` changes
     (e.g. the licensed clip replacing the stock preview) — same crop
     target (1024×749), same blur radius (86.5px Gaussian ≈ the live
     overlay's 125px CSS blur, per the original asset-spec measurement),
     same darken (20% blend with #161616), JPEG quality 80:

       ffmpeg -y -ss 0 -i public/assets/about-hero/about-3/founders-bg-robbo.mp4 \
         -frames:v 1 /tmp/bg-fade-frame.jpg

       python3 -c "
       from PIL import Image, ImageFilter
       src = Image.open('/tmp/bg-fade-frame.jpg').convert('RGB')
       sw, sh = src.size
       target_aspect = 1024 / 749
       crop_w = int(sh * target_aspect)
       left = (sw - crop_w) // 2
       cropped = src.crop((left, 0, left + crop_w, sh)).resize((1024, 749), Image.LANCZOS)
       blurred = cropped.filter(ImageFilter.GaussianBlur(radius=86.5))
       treated = Image.blend(blurred, Image.new('RGB', blurred.size, (22, 22, 22)), 0.2)
       treated.save('public/assets/about-hero/about-3/bg-fade.jpg', quality=80)
       "

     Then re-verify the handoff live (this file's history has the full
     checklist) before committing. -->
<img
  class="about-hero__bg-fade"
  data-about-hero-bg-fade
  src={bgFadeSrc}
  alt=""
  loading="eager"
  decoding="async"
  aria-hidden="true"
/>

<div class="about-hero-spacer" data-about-hero-spacer aria-hidden="true"></div>

<!-- Founders two-slide carousel — begins where the bg-fade above completes
     (its first trigger fires as the section's top crosses the viewport
     bottom, 60px after BG_FADE_END). z-index 150 lifts it above the fixed
     bg-fade (50) and hero layers (100/110), below the nav (270). -->
<FoundersSection />

<!-- Fixed settled stage — in-flow scroll runway (landing-scroll.js sets
     its height) whose visible content is a position: fixed, full-
     viewport #F9F9F9 panel. The stage is visibility:hidden by CSS
     default (about-page.css, no-preference media query only — see its
     comment) and revealed ONLY by landing-scroll.js's entry-gate
     ScrollTrigger at the exact scroll position the founders exhale
     resolves (founders-scroll.js's applyExitState hides the founders
     stage + hero bg-fade at that same position) — a pixel-identical
     #F9F9F9-to-#F9F9F9 swap, no wrong-state frame in either direction.
     FUTURE SECTIONS: any new fixed, opaque, full-viewport stage after
     this one MUST follow the same contract — CSS-default
     visibility:hidden, revealed only by a ScrollTrigger onEnter/
     onLeaveBack pair anchored to ITS OWN section's document position.
     Skipping the entry gate (opaque-by-default, exit-only visibility)
     is exactly the bug a previous attempt shipped here: it painted
     over the hero's fixed z:110 images/canvas from initial page load
     because nothing hid it before scroll earned it. -->
<section class="about-landing" data-about-landing aria-label="Next section">
  <div class="about-landing__stage" data-about-landing-stage>
    <!-- Horizontal gallery — the landing's scrubbed phase after the text
         hold (landing-scroll.js). A SIBLING of the blend row under the
         stage's isolation root: transforms/will-change live strictly
         inside this subtree, never on a blend ancestor, and it carries
         NO z-index. PAINT ORDER: this comes BEFORE the row in source and
         the row is position:relative (no z-index — no stacking context),
         so the difference-blend text paints ABOVE the passing images and
         visibly inverts against them — the intended reading. Under
         reduced motion the no-preference styles never apply and this
         renders as a static, natively-scrollable in-flow strip
         (about-page.css) — note it then sits above the text in flow
         order per the same source position. -->
    <div class="about-landing__gallery" data-about-landing-gallery aria-hidden="true">
      <div class="about-landing__gallery-track" data-about-landing-gallery-track>
        {galleryItems.map((item) => (
          <figure
            class={`about-landing__gallery-item about-landing__gallery-item--${item.size}`}
            style={`margin-left:${item.xGap}px; --gallery-y:${item.yOff}px`}
          >
            <figcaption class="about-landing__gallery-caption">
              <span class="about-landing__gallery-caption-dot" aria-hidden="true"></span>
              {item.label}
            </figcaption>
            <div class="about-landing__gallery-frame">
              <img
                src={item.src}
                alt=""
                loading="lazy"
                decoding="async"
                data-about-landing-gallery-img
              />
            </div>
          </figure>
        ))}
      </div>
    </div>
    <div class="about-landing__row">
      <p class="about-landing__text about-landing__text--body" data-about-landing-col>
        We are a relationship-led consultancy connecting Talent, Brands and Audiences through Experiences, Strategic Partnerships and Media.
      </p>
      <p class="about-landing__text about-landing__text--headline" data-about-landing-col>
        FROM ACCESS TO IMPACT<sup class="founders__tag-index">/00</sup>
      </p>
      <p class="about-landing__text about-landing__text--serif about-landing__text--center" data-about-landing-col>
        The network effect
      </p>
      <p class="about-landing__text about-landing__text--serif about-landing__text--right" data-about-landing-col>
        Delivered through three disciplines.
      </p>
    </div>
  </div>
</section>

<script>
  import { initAbout3Scroll } from '../../scripts/about-3/about-scroll.js';
  import { initLandingScroll } from '../../scripts/about-3/landing-scroll.js';

  let cleanupAbout3Scroll = initAbout3Scroll();
  let cleanupLandingScroll = initLandingScroll();

  document.addEventListener('astro:before-swap', () => {
    cleanupAbout3Scroll?.();
    cleanupAbout3Scroll = undefined;
    cleanupLandingScroll?.();
    cleanupLandingScroll = undefined;
  }, { once: true });
</script>
