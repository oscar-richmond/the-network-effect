---
import AboutHero from './AboutHero.astro';
import FoundersSection from './FoundersSection.astro';
import RotatingSection from './RotatingSection.astro';
import DetailView from './DetailView.astro';
import { asset } from '../../utils/asset.js';
import 'lenis/dist/lenis.css';

const bgFadeSrc = asset('/assets/about-hero/about-3/bg-fade.jpg');

// Landing gallery — real imagery from the TNE CIMGS pool (see
// public/assets/landing-gallery/). CONTENT STATUS: every image below
// is a social/press/Flickr-sourced STAND-IN pending licensed final
// content; captions are filename-derived placeholders pending
// founder-approved copy.
//
// COMPOSITION ARRAY — a designed, hand-set editorial layout (staggered,
// rhythmic, breathing), NOT randomness. Portrait-dominant to match the
// pool's aspect skew, with three B&W landscape moments as rhythm
// breaks; visually-heavy images are never adjacent. Per item: size
// class (see the size-class rules in about-page.css), xGap (extra
// horizontal air before the item, on top of the track's base gap) and
// yOff (vertical offset from the stage's centre line — negative rises
// above centre). This is data: content edits slot in by editing values.
const galleryItems = [
  { file: 'cult-culture-flatlay', size: 'portrait-m', xGap: 0, yOff: 40 },
  { file: 'red-car-blur', size: 'portrait-s', xGap: 48, yOff: -110 },
  { file: 'depp-bar', size: 'landscape', xGap: 72, yOff: 70 },
  { file: 'jacquemus-bag', size: 'portrait-l', xGap: 64, yOff: -70 },
  { file: 'retro-phone-cocktail', size: 'portrait-s', xGap: 88, yOff: 120 },
  { file: 'nike-dinner', size: 'portrait-m', xGap: 48, yOff: -140 },
  { file: 'kitchen-smoke', size: 'landscape', xGap: 96, yOff: 60 },
  { file: 'door-313', size: 'portrait-s', xGap: 56, yOff: -100 },
  { file: 'bottega-jacket', size: 'portrait-l', xGap: 72, yOff: 90 },
  { file: 'vinyl-candlelight', size: 'portrait-m', xGap: 48, yOff: -50 },
  { file: 'bw-stairs', size: 'portrait-s', xGap: 64, yOff: 130 },
  { file: 'lagerfeld-pharrell', size: 'landscape', xGap: 88, yOff: -60 },
].map((item, i) => ({
  ...item,
  src: asset(`/assets/landing-gallery/${item.file}.jpg`),
  label: `${item.file.replace(/-/g, ' ').toUpperCase()} /${String(i + 1).padStart(2, '0')}`,
}));

// Pillar image waves — one 6-image wave per pillar row, rising straight
// up from below the stage. Same content pool and STAND-IN status as the
// gallery above. Per item: size class (square/rectangle vocabulary —
// see the wave size classes in about-page.css), x (left edge, % of
// stage width), y (px below the stage bottom — arrival order) and
// speed (per-item scroll-speed multiplier: landing-scroll.js scrubs
// the container as the base motion and drifts each item by its own
// multiplier on top, so the images rise at slightly different rates
// instead of as one rigid sheet).
//
// NO-OVERLAP INVARIANTS (per explicit request — no two images may ever
// overlap at ANY scroll position, while keeping the ORIGINAL zigzag x
// layout and a LARGER drift spread with the strongest speed contrast
// between vertical neighbours). Under differential speeds a faster
// lower image closes on a slower upper one by up to
// Δspeed × waveTravel (~1100px at the largest contrasts), so the
// vertical offsets — not lanes — absorb it. Solved pair-by-pair and
// verified live with dense sweeps at 1280×800 and 1728×1084:
//  1. For every pair whose horizontal ranges intersect anywhere in the
//     ≥1280px design band (left% fixed, px widths widest at 1280),
//     either the LOWER item is no faster than the upper (the parked
//     gap can only open), or the parked gap exceeds the worst-case
//     closing Δspeed × waveTravel + margin computed at the design
//     ceiling (~1200px viewport height). Pairs with disjoint x ranges
//     need no vertical guard — those diagonal neighbours are exactly
//     where the biggest 0.30–0.40 speed contrasts live.
//  2. The big closing contrasts forced the compositions ~400–600px
//     taller than the rigid-sheet originals; WAVE_SCROLL_PX grew
//     3000 → 3600 (landing-scroll.js) to keep the felt pace.
//  3. LAST-ITEM CONTRACT — each wave's last item (max y) is the swap
//     trigger landing-scroll.js keys the row swap to: keep it last,
//     speed 1.0, and every slower item's (stage-adjusted) row-pass
//     metric (rowGap + y)/speed strictly below the last item's, so
//     nothing crosses the docked row after the swap has fired.
// EDITING RULE: changing any x, size, y or speed re-opens the pair
// maths — re-run the dense overlap sweep before shipping.
const pillarWaves = [
  // WAVE 0 (01 — IMMERSE) — REPLACED per explicit request with the four
  // Oscar-supplied images laid out per Figma node 17-1065 (frame "TNE V3
  // - Landing Page", the IMMERSE moment): x = the Figma left edge as % of
  // 1728; y = the Figma stage-relative top (px below the content area's
  // top), so with near-uniform speeds the sheet carries the Figma
  // arrangement through the viewport. These items use `w` (vw width, the
  // Figma slot as % of 1728) + `ar` (the image file's NATIVE ratio —
  // explicit request) instead of a fixed `size` class — see
  // .about-landing__wave-item--figma in about-page.css. INVARIANTS
  // re-checked for this composition: the only x-overlapping pairs are
  // chef/dinner (~1.2%) and jacket/bubble — in both the LOWER item
  // (dinner 1.0, jacket 1.0) is no faster than the upper (chef 1.12,
  // bubble 1.18), so gaps only open; no item is slower than the last, so
  // the row-pass metric holds trivially. LAST-ITEM CONTRACT: dinner has
  // max y, sits last, speed 1.0. CONTENT STATUS: same stand-in standing
  // as the rest of the pool (Figma-sourced, pending licensed finals).
  // x TUNE (Oscar): the three left-side images sit 100px (5.79% of the
  // 1728 frame) LEFT of their Figma slots; the bubble stays put. The
  // shift is uniform across the three, so the pair-overlap picture is
  // unchanged (chef/dinner overlap rides along; jacket/bubble overlap
  // widens slightly — same lower-no-faster rule covers it).
  [
    { file: 'bubble-gum-glass', w: 10.59, ar: '366 / 402', x: 82.12, y: 64, speed: 1.18 },
    { file: 'chef-window', w: 15.05, ar: '520 / 644', x: 8.39, y: 91, speed: 1.12 },
    { file: 'red-hooded-jacket', w: 36.46, ar: '1260 / 1144', x: 48.61, y: 323, speed: 1.0 },
    { file: 'red-room-dinner', w: 16.55, ar: '572 / 577', x: 22.22, y: 546, speed: 1.0 },
  ],
  // WAVE 1 (02 — CONNECT) — REPLACED per explicit request with the four
  // Oscar-supplied images laid out per the same Figma frame's CONNECT
  // moment (the mirrored composition: big slot left, small slots on the
  // edges). Same `w`/`ar` native-ratio mechanism as wave 0 above. The
  // skater slot extends 17px past the frame's LEFT edge in the Figma;
  // the item sits flush at x 0 showing the FULL image at its own ratio
  // (Oscar's fix round: the first cut cropped past the frame-clipped
  // Figma export's right edge, which PIL filled with a black band —
  // the file is now the complete original). INVARIANTS: the only
  // x-overlapping pair is
  // surfboard/pharrell — the lower (pharrell 1.0) is no faster than the
  // upper (surfboard 1.12), so the gap only opens; nobody is slower
  // than the last item. LAST-ITEM CONTRACT: pharrell has max y, sits
  // last, speed 1.0. CONTENT STATUS: stand-ins pending licensed finals
  // (person- and brand-identifiable subjects Oscar supplied himself).
  [
    { file: 'skater-wine-field', w: 10.59, ar: '366 / 402', x: 0, y: 71, speed: 1.18 },
    { file: 'burberry-surfboard', w: 15.05, ar: '520 / 644', x: 73.26, y: 91, speed: 1.12 },
    { file: 'osaka-clay-court', w: 36.46, ar: '1260 / 1144', x: 17.94, y: 323, speed: 1.0 },
    { file: 'lagerfeld-pharrell-bw', w: 16.55, ar: '572 / 576', x: 60.59, y: 546, speed: 1.0 },
  ],
  // WAVE 2 (03 — AMPLIFY) — REPLACED per explicit request: WAVE 0's
  // layout verbatim (same x/y/w/speeds, post-100px-left tune) with the
  // four Oscar-supplied round-3 images, per his slot mapping: furthest
  // left = veiled portrait; 2nd left = the B&W stage shot (Desktop
  // 2.3.jpg — the chat attachment for this slot was a mis-pasted
  // duplicate of the CONNECT skater; the named file matches his written
  // description and the slot's exact dimensions); largest = yellow
  // inflatable suit; right = tennis-ball car. Identical geometry to
  // wave 0, so its invariants and LAST-ITEM CONTRACT carry over
  // unchanged (stage-bw: max y, last, speed 1.0 — also the final
  // coverer for the 03 row wipe). CONTENT STATUS: stand-ins pending
  // licensed finals.
  [
    { file: 'tennis-ball-car', w: 10.59, ar: '366 / 402', x: 82.12, y: 64, speed: 1.18 },
    { file: 'veiled-portrait', w: 15.05, ar: '520 / 644', x: 8.39, y: 91, speed: 1.12 },
    { file: 'yellow-inflatable-suit', w: 36.46, ar: '1260 / 1144', x: 48.61, y: 323, speed: 1.0 },
    { file: 'stage-performance-bw', w: 16.55, ar: '572 / 577', x: 22.22, y: 546, speed: 1.0 },
  ],
].map((wave) =>
  wave.map((item) => ({ ...item, src: asset(`/assets/pillar-waves/${item.file}.jpg`) })),
);

// Stage-global overlay index base per wave — CUMULATIVE, because wave
// lengths differ now (4/6/6 since the IMMERSE relayout): the hover
// module maps its i-th served image (all waves, DOM order) to overlay
// index i, so each wave's overlays start where the previous wave's
// images ended (the old `waveIndex * wave.length` assumed uniform
// lengths and would desync every wave after the first).
const waveOffsets = pillarWaves.map((_, i) =>
  pillarWaves.slice(0, i).reduce((sum, w) => sum + w.length, 0),
);

// Pillar rows — one per discipline, each replacing the previous via the
// wave-keyed wipe/rise chain (landing-scroll.js). COPY STATUS: rows 02
// and 03 are PLACEHOLDER drafts pending founder approval; row 01 is the
// approved IMMERSE copy.
const pillarRows = [
  {
    body: 'Designing immersive experiences, strategic partnerships and cultural moments that bring brands, talent and communities together.',
    headline: '01 — IMMERSE',
    center: 'Activate Experiences & Cultural Moments',
    right: 'We create the environments where culture happens',
  },
  {
    body: 'Connecting talent with brands through meaningful long-term commercial and cultural relationships.',
    headline: '02 — CONNECT',
    center: 'Talent Strategy & Partnerships',
    right: 'We act as strategic partners for talent and brands.',
  },
  {
    body: 'Creating stories, platforms and content that deepen relationships and amplify culture.',
    headline: '03 — AMPLIFY',
    center: 'Narrative & Media Studio',
    right: 'Amplify stories across media & content',
  },
];
---

<AboutHero />

<!-- Scroll-scrubbed full-viewport backdrop — fades in (opacity only) as
     the hero images exit; sits above the #F9F9F9 base but below the
     tagline/intro (z 100), images/WebGL canvas (z 110) and nav (z 270).
     An eager <img> (not a CSS background) so it starts loading at page
     init and is decoded long before the fade window ~3000px down the
     scroll runway. Driven by about-scroll.js via [data-about-hero-bg-fade].

     THIS IS A STATIC STAND-IN FOR THE LIVE FOUNDERS BACKGROUND IT HANDS
     OFF TO — it must be baked from the SAME source as slide 1's video
     (founders.js's media.src) using the SAME treatment as the live
     `.founders__overlay`/`.founders__media` filter, or the handoff reads
     as two mismatched scenes (diagnosed once already: this file was
     previously baked from the pre-rearchitecture Robbo PHOTO background,
     stale the moment slide 1 became a video of an unrelated scene).
     Confirmed via live scroll-speed testing (fast fling + simulated slow
     scroll, video sampled at t≈0s and t≈3.76s at the takeover moment):
     125px of blur fully masks the frozen-frame → playing-video transition
     — no visible "pop" at any point in the loop — so a single representative
     frame is sufficient; no need to special-case scroll speed.

     REGENERATE THIS FILE whenever founders.js's Robbo `media.src` changes
     (e.g. the licensed clip replacing the stock preview) — same crop
     target (1024×749), same blur radius (86.5px Gaussian ≈ the live
     overlay's 125px CSS blur, per the original asset-spec measurement),
     same darken (20% blend with #161616), JPEG quality 80:

       ffmpeg -y -ss 0 -i public/assets/about-hero/about-3/founders-bg-robbo.mp4 \
         -frames:v 1 /tmp/bg-fade-frame.jpg

       python3 -c "
       from PIL import Image, ImageFilter
       src = Image.open('/tmp/bg-fade-frame.jpg').convert('RGB')
       sw, sh = src.size
       target_aspect = 1024 / 749
       crop_w = int(sh * target_aspect)
       left = (sw - crop_w) // 2
       cropped = src.crop((left, 0, left + crop_w, sh)).resize((1024, 749), Image.LANCZOS)
       blurred = cropped.filter(ImageFilter.GaussianBlur(radius=86.5))
       treated = Image.blend(blurred, Image.new('RGB', blurred.size, (22, 22, 22)), 0.2)
       treated.save('public/assets/about-hero/about-3/bg-fade.jpg', quality=80)
       "

     Then re-verify the handoff live (this file's history has the full
     checklist) before committing. -->
<img
  class="about-hero__bg-fade"
  data-about-hero-bg-fade
  src={bgFadeSrc}
  alt=""
  loading="eager"
  decoding="async"
  aria-hidden="true"
/>

<div class="about-hero-spacer" data-about-hero-spacer aria-hidden="true"></div>

<!-- Founders two-slide carousel — begins where the bg-fade above completes
     (its first trigger fires as the section's top crosses the viewport
     bottom, 60px after BG_FADE_END). z-index 150 lifts it above the fixed
     bg-fade (50) and hero layers (100/110), below the nav (270). -->
<FoundersSection />

<!-- Fixed settled stage — in-flow scroll runway (landing-scroll.js sets
     its height) whose visible content is a position: fixed, full-
     viewport #F9F9F9 panel. The stage is visibility:hidden by CSS
     default (about-page.css, no-preference media query only — see its
     comment) and revealed ONLY by landing-scroll.js's entry-gate
     ScrollTrigger at the exact scroll position the founders exhale
     resolves (founders-scroll.js's applyExitState hides the founders
     stage + hero bg-fade at that same position) — a pixel-identical
     #F9F9F9-to-#F9F9F9 swap, no wrong-state frame in either direction.
     FUTURE SECTIONS: any new fixed, opaque, full-viewport stage after
     this one MUST follow the same contract — CSS-default
     visibility:hidden, revealed only by a ScrollTrigger onEnter/
     onLeaveBack pair anchored to ITS OWN section's document position.
     Skipping the entry gate (opaque-by-default, exit-only visibility)
     is exactly the bug a previous attempt shipped here: it painted
     over the hero's fixed z:110 images/canvas from initial page load
     because nothing hid it before scroll earned it. -->
<section class="about-landing" data-about-landing aria-label="Next section">
  <div class="about-landing__stage" data-about-landing-stage>
    <!-- Horizontal gallery — the landing's scrubbed phase after the text
         hold (landing-scroll.js). A SIBLING of the blend row under the
         stage's isolation root: transforms/will-change live strictly
         inside this subtree, never on a blend ancestor, and it carries
         NO z-index. PAINT ORDER: this comes BEFORE the row in source and
         the row is position:relative (no z-index — no stacking context),
         so the difference-blend text paints ABOVE the passing images and
         visibly inverts against them — the intended reading. Under
         reduced motion the no-preference styles never apply and this
         renders as a static, natively-scrollable in-flow strip
         (about-page.css) — note it then sits above the text in flow
         order per the same source position. -->
    <div class="about-landing__gallery" data-about-landing-gallery aria-hidden="true">
      <div class="about-landing__gallery-track" data-about-landing-gallery-track>
        {galleryItems.map((item) => (
          <figure
            class={`about-landing__gallery-item about-landing__gallery-item--${item.size}`}
            style={`margin-left:${item.xGap}px; --gallery-y:${item.yOff}px`}
          >
            <figcaption class="about-landing__gallery-caption">
              <span class="about-landing__gallery-caption-dot" aria-hidden="true"></span>
              {item.label}
            </figcaption>
            <!-- data-hover: the canvas cursor's grow affordance — these
                 frames are CLICKABLE (detail-view.js) and the native
                 cursor is hidden site-wide under the custom cursor. -->
            <div class="about-landing__gallery-frame" data-hover>
              <img
                src={item.src}
                alt=""
                loading="lazy"
                decoding="async"
                data-about-landing-gallery-img
              />
            </div>
          </figure>
        ))}
      </div>

      <!-- NOTE (explicit requests, repeatedly confirmed): the horizontal
           gallery's images carry NO shader/hover treatment of any kind —
           no planes, no overlay CTA, no detail-view click. The original
           hover treatment was removed by explicit request; a velocity-
           only plane treatment briefly added at the update round was
           REVERSED by explicit request immediately after. wave-shader.js
           serves ONLY the pillar wave images below. -->
    </div>

    <!-- Pillar image waves — one per pillar row, parked fully below the
         stage (items are absolute at top:100% + their composed y offset)
         until landing-scroll.js scrubs each wave's TRACK straight up.
         STRUCTURE mirrors the gallery exactly, for the same reason: the
         WRAPPER stays untransformed (it hosts the rect-synced hover
         overlays, which write viewport-space left/top and would be
         double-offset inside a transformed ancestor — and a transform
         here would also isolate their difference blend), while the
         inner TRACK carries the container scrub and the items their
         per-speed drifts. PAINT ORDER: positioned siblings with no
         z-index paint in source order — these sit AFTER the gallery
         (above it; it has lifted out by the time a wave runs) and
         BEFORE the hover-canvas slot + text rows, so the shared WebGL
         canvas paints above the wave imagery and the rows' difference
         text paints above both, inverting exactly like the gallery
         phase. BLEND SAFETY: transforms stay on the track/items, and
         nothing here may gain will-change (Chromium excludes promoted
         siblings from the blend backdrop). Frames reuse the gallery's
         .about-landing__gallery-frame class: it is the hover module's
         plane/hit-test unit (pointer-events: auto opt-in under the
         pointer-events:none subtree) — see wave-shader.js.
         Overlay indices are STAGE-GLOBAL in DOM order across the three
         waves (0..17) — the module maps its i-th image (queried across
         the whole stage; the horizontal gallery's images are NO LONGER
         served, by explicit request) to overlay index i. The overlays
         sit OUTSIDE the transformed track (rect-synced siblings; see
         wave-shader.js) because the track's per-frame transforms
         would blend-isolate and cover them. display: none under reduced
         motion (about-page.css base state) — purely decorative,
         aria-hidden. -->
    {pillarWaves.map((wave, waveIndex) => (
      <div class="about-landing__wave" data-about-landing-wave={waveIndex} aria-hidden="true">
        <div class="about-landing__wave-track" data-about-landing-wave-track>
          {wave.map((item) => (
            <figure
              class={`about-landing__wave-item about-landing__wave-item--${item.size ?? 'figma'}`}
              style={`left:${item.x}%; margin-top:${item.y}px;${
                item.w ? ` --wave-w:${item.w}; --wave-ar:${item.ar};` : ''
              }`}
              data-wave-speed={item.speed}
            >
              <div class="about-landing__gallery-frame" data-hover>
                <img src={item.src} alt="" loading="lazy" decoding="async" data-about-landing-wave-img />
              </div>
            </figure>
          ))}
        </div>
        {wave.map((_, j) => (
          <div
            class="about-landing__gallery-overlay"
            data-about-landing-gallery-overlay={waveOffsets[waveIndex] + j}
            aria-hidden="true"
          >
            <p class="about-landing__gallery-overlay-text">View our services</p>
          </div>
        ))}
      </div>
    ))}

    <!-- Shared hover-canvas slot — wave-shader.js appends
         its single WebGL canvas here (one renderer for all 30 images:
         gallery + waves) instead of inside the gallery. Positioned at
         THIS source position so the canvas paints above every image
         track yet below the difference-text rows; the overlays' own
         z-index:1 lifts them above the canvas from anywhere in the
         stage's isolation context. Empty and inert (pointer-events:
         none) when the module never runs. -->
    <div
      class="about-landing__hover-canvas-slot"
      data-about-landing-hover-canvas-slot
      aria-hidden="true"
    ></div>

    <div class="about-landing__row" data-about-landing-row-intro>
      <p class="about-landing__text about-landing__text--body" data-about-landing-col>
        We are a relationship-led consultancy connecting Talent, Brands and Audiences through Experiences, Strategic Partnerships and Media.
      </p>
      <p class="about-landing__text about-landing__text--headline" data-about-landing-col>
        FROM ACCESS TO IMPACT<sup class="founders__tag-index">/00</sup>
      </p>
      <p class="about-landing__text about-landing__text--serif about-landing__text--center" data-about-landing-col>
        The network effect
      </p>
      <p class="about-landing__text about-landing__text--serif about-landing__text--right" data-about-landing-col>
        Delivered through three disciplines.
      </p>
    </div>

    <!-- Pillar rows ("01 — IMMERSE" / "02 — CONNECT" / "03 — AMPLIFY") —
         each scrolls up from below the viewport to REPLACE the previous
         text at the centred slot. Row 0 rides the gallery's lift-out
         (the intro row stays at rest and exits via the hero-vocabulary
         bottom-up wipe as row 0 scrolls over it); rows 1 and 2 each
         start rising the moment their predecessor's wave's LAST image
         reaches it, wiping the predecessor under their own leading
         edge as they arrive — the same swap behaviour as row 0 over
         the intro (landing-scroll.js derives the whole chain).
         Motion is scrubbed on `top`, a layout property — NEVER
         transform, which on these blend-leaf parents would isolate the
         columns' difference blend; the name-clip idiom, applied to
         rows. Columns mirror the intro row's per-position styles
         exactly, but deliberately do NOT carry data-about-landing-col:
         that attr is the wrap/reveal system's roster (and the flash-
         guard's selector) — these rows enter positionally, no line
         reveal, and must be plainly visible when they arrive.
         landing-scroll.js DOES line-wrap them at build (lr-visible,
         transitions off) purely to obtain per-line units for the exit
         wipes. The CSS default top: 100% (below the stage) is the
         initial-hidden state; build() re-derives px positions per
         rebuild. -->
    {pillarRows.map((row, rowIndex) => (
      <div class="about-landing__row about-landing__row--pillar" data-about-landing-pillar-row={rowIndex}>
        <p class="about-landing__text about-landing__text--body">
          {row.body}
        </p>
        <p class="about-landing__text about-landing__text--headline">
          {row.headline}
        </p>
        <p class="about-landing__text about-landing__text--serif about-landing__text--center">
          {row.center}
        </p>
        <p class="about-landing__text about-landing__text--serif about-landing__text--right">
          {row.right}
        </p>
      </div>
    ))}

    <!-- Bottom-centre label — SCOPED to this stage only (ported from the
         unmerged footer-services-label branch, rebased onto the pillar-
         cycle era): a direct child of the stage, not fixed page chrome,
         so it inherits the stage's own visibility lifecycle — present
         from the landing reveal ("FROM ACCESS TO IMPACT") through the
         full pillar chain ("03 — AMPLIFY") and gone at exit-end, via
         the already-verified entry-gate/exit/fling/resize machinery,
         with no new triggers. It belongs to NO row, so no wipe ever
         touches it — it holds fixed at the stage bottom while rows and
         waves cycle above. `data-about-landing-col` + the shared
         `about-landing__text` class pull it into the same wrap/reveal
         system as the intro columns (the hero-tagline line-reveal
         vocabulary — "same entry as WE ARE A.."); landing-scroll.js
         additionally rides a blur+opacity dissolve on its clip during
         that same reveal beat (see the footer-label block in build()).
         Ordered last so it paints above the gallery/waves on any frame
         their bounds graze it. -->
    <p
      class="about-landing__text about-footer-label"
      data-about-landing-col
      aria-hidden="true"
    >
      03 — our services
    </p>
  </div>
</section>

<RotatingSection />

<!-- The partners wheel RELOCATED to /services (services-page split):
     rotating is now this page's last section — its own CSS tail
     (100vh + 500px, kept as end-of-page breathing room) already covers
     the last-section headroom contract, so no pad handoff was needed. -->

<DetailView />

<script>
  import { initAbout3Scroll } from '../../scripts/about-3/about-scroll.js';
  import { initLandingScroll } from '../../scripts/about-3/landing-scroll.js';
  import { initRotatingScroll } from '../../scripts/about-3/rotating-scroll.js';
  import { initDetailView } from '../../scripts/about-3/detail-view.js';

  let cleanupAbout3Scroll = initAbout3Scroll();
  let cleanupLandingScroll = initLandingScroll();
  let cleanupRotatingScroll = initRotatingScroll();
