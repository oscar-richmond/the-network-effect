---
import GradualBlur from '../GradualBlur.astro';
import { asset } from '../../utils/asset.js';
import '../../styles/about-3/rotating.css';

// Rotating gallery images — Oscar's real five (supplied at the image-
// spec round), each rendered at its OWN supplied ratio (all five are
// 1500x970 as delivered) at 700px width. Every entry carries its
// file's ratio EXPLICITLY (the pillar-wave relayout convention): the
// item box gets an inline aspect-ratio, so the section's layout —
// and therefore every downstream trigger anchor and the melt lead —
// never depends on image bytes arriving (intrinsic height-auto sizing
// collapsed to 0 for lazy images and would have reflowed the page
// underfoot as they loaded; caught at verification). Image swaps stay
// data-only: file + ratio per entry. They pair with the marquee names
// in order: Wilderness Reserve bedroom / talent portrait / club
// restaurant / chef at work / the Thunder Aviation helicopter.
// CONTENT STATUS: PENDING FOUNDER SIGN-OFF like all named-engagement
// material (one image is an identifiable public figure —
// Oscar-supplied directly).
const ROTATING_IMAGES = [
  { file: 'wilderness-bedroom', ar: '1500 / 970' },
  { file: 'talent-portrait', ar: '1500 / 970' },
  { file: 'club-restaurant', ar: '1500 / 970' },
  { file: 'chef-kitchen-bw', ar: '1500 / 970' },
  { file: 'thunder-helicopter', ar: '1500 / 970' },
].map((item) => ({ ...item, src: asset(`/assets/rotating/${item.file}.jpg`) }));

// Marquee copy + per-name notes — REAL project/client copy, PENDING
// FOUNDER SIGN-OFF (amendment 1 + the notes round; same standing as
// the partners client list: Yoxman and the Pavilion events are named
// engagements, and the notes carry factual claims — Michelin star,
// "one of the UK's leading" — do not launch without confirmation).
// ONE array so the marquee term order and the note order can never
// drift: rotating-scroll.js maps the i-th marquee term span to the
// i-th note paragraph by construction. Terms render as term/separator
// spans with the "three spaces around each /" spacing expressed as
// flex gap 0.75em (36px at the fixed 48px) — see rotating.css. Notes
// render as the fixed bottom-left paragraphs (Oscar's spec: Serrif 12,
// difference, 40px/40px), shown while their name crosses the middle
// third of the viewport (rotating-scroll.js).
const SELECTED_WORK = [
  {
    term: 'Wilderness Reserve',
    note: 'Developed one of the UK’s leading luxury destinations, spanning hospitality, events, guest experiences and talent partnerships.',
  },
  {
    term: 'Pavilion Club',
    note: 'Created and scaled a private membership programme across four clubs, connecting founders, CEOs and high-profile talent through cultural and business led experiences.',
  },
  {
    term: 'Pavilion Summit',
    note: 'A 24-hour immersive leadership experience, delivered from ideation to execution, bringing CEOs, founders and cultural voices together.',
  },
  {
    term: 'Yoxman Food Festival',
    note: 'Created and launched a Michelin-starred culinary festival, uniting world-class chefs, premium partnerships, guest journey, creative direction and luxury hospitality experience.',
  },
  {
    term: 'Thunder Aviation',
    note: 'Developed luxury aviation positioning and partnership strategy across private travel, premium hospitality and high-net-worth experiences.',
  },
];
const MARQUEE_TERMS = SELECTED_WORK.map((work) => work.term);
---

<section class="about-rotating" data-about-rotating aria-label="Gallery">
  <!-- Rotating on-scroll gallery (Codrops demo 4 mechanism — see
       rotating.css + rotating-scroll.js headers). IN-FLOW section: this
       is ordinary scrolling content between two fixed-stage sections —
       landing's exit-end fires exactly as this section's top crosses
       the viewport bottom (a dark-to-dark swap: landing's exit ground
       fade has already completed by then — landing-scroll.js), and
       partners' entry/melt anchors ride
       this section's bottom edge by plain document flow. The melt-lead
       publisher moved HERE from landing-scroll.js (rotating-scroll.js
       derives it from the last item's centre). THIS COMMENT LIVES
       INSIDE THE SECTION deliberately — the anonymous-box strut lesson
       (a body-level comment between siblings once produced a real
       ~12px layout gap; see PartnersSection.astro). -->

  <!-- Name marquee — the reference's .mark: fixed at 50vh with
       difference blend, JS-gated to this section's window so it can
       never paint over other sections (visibility CSS-default hidden).
       The inner strip scrubs x: 100vw -> -100% across the section's
       full scroll range. Wrapper/inner split mirrors the reference
       (blend on the wrapper, transform on the inner). -->
  <div class="about-rotating__mark" data-about-rotating-mark aria-hidden="true">
    <div class="about-rotating__mark-inner" data-about-rotating-mark-inner>
      {
        MARQUEE_TERMS.map((term, i) => (
          <>
            {i > 0 && <span>/</span>}
            <span>{term}</span>
          </>
        ))
      }
    </div>
  </div>

  <!-- The column — wrapper/item split is the reference's own structure
       (perspective on the WRAP, 3D rotation on the ITEM), but the wraps
       are SERVER-RENDERED here instead of the reference's runtime
       insertBefore surgery (house style: static markup, JS only
       animates). rotating-scroll.js sine-offsets each wrap and scrubs
       each item's rotation as it crosses the viewport. -->
  <div class="about-rotating__gallery" data-about-rotating-gallery>
    {
      ROTATING_IMAGES.map((item) => (
        <div class="about-rotating__item-wrap" data-about-rotating-wrap>
          <div
            class="about-rotating__item"
            data-about-rotating-item
            style={`aspect-ratio: ${item.ar};`}
          >
            <img src={item.src} alt="" loading="lazy" decoding="async" data-about-rotating-img />
          </div>
        </div>
      ))
    }
  </div>

  <!-- Viewport edge blurs — the PARTNERS section's exact treatment
       (same doubled config: strength 3 -> 12/48px exponential layers,
       12rem coverage, opacity 0.8), on both edges. The partners bands
       live inside its fixed stage; this section is IN-FLOW, so these
       are viewport-FIXED (the style prop overrides the component's
       parent-absolute positioning) and JS-gated to the section window
       (inline visibility hidden here; rotating-scroll.js's
       setWindowVisible toggles them with the marquee/label/canvas —
       they can never paint over other sections, and they close at the
       content-clear point with everything else). STACKING: z 3 —
       above the fold canvas (1) and marquee (2), below the footer
       label (4, kept crisp like partners keeps its nav above) and the
       grain (9000). -->
  <GradualBlur
    target="parent"
    position="top"
    strength={3}
    height="12rem"
    divCount={2}
    exponential={true}
    opacity={0.8}
    zIndex={3}
    className="about-rotating__edge"
    style={{ position: 'fixed', visibility: 'hidden' }}
  />
  <GradualBlur
    target="parent"
    position="bottom"
    strength={3}
    height="12rem"
    divCount={2}
    exponential={true}
    opacity={0.8}
    zIndex={3}
    className="about-rotating__edge"
    style={{ position: 'fixed', visibility: 'hidden' }}
  />

  <!-- Footer label — the landing's "our services — three pillars"
       treatment, one section along (explicit request): same slot (40px
       off the viewport bottom, centred), same type (Dazzed 400 12px),
       same difference blend, same roll-up + dissolve entry and
       reverse-on-scroll-back exit (rotating-scroll.js drives it; the
       landing's rides its reveal timeline). Fixed + JS-gated because
       this section is in-flow (no fixed stage to inherit from). -->
  <p class="about-rotating__footer-label" data-about-rotating-label aria-hidden="true">
    04 — selected work
  </p>

  <!-- Per-name notes (Oscar's spec) — five fixed bottom-left paragraphs,
       one per marquee term, index-paired with SELECTED_WORK by
       construction. Each <p> is ITSELF the fixed + difference-blend
       element (the footer-label pattern: blend on the fixed leaf, never
       a child of a fixed wrapper — a fixed ancestor's forced stacking
       context would isolate a child's blend from the page backdrop).
       All five stack in the same 40px/40px slot; rotating-scroll.js
       crossfades opacity so only the note whose name is crossing the
       middle third of the viewport reads, and gates visibility to the
       section window with the marquee/label/edges (CSS-default hidden —
       they can never paint over other sections). aria-hidden like the
       marquee they annotate (decorative scroll choreography; the same
       copy should reach assistive tech through whatever static
       treatment ships for reduced motion — flagged with the RM note in
       rotating.css). -->
  {
    SELECTED_WORK.map((work, i) => (
      <p class="about-rotating__note" data-about-rotating-note={i} aria-hidden="true">
        {work.note}
      </p>
    ))
  }
</section>
