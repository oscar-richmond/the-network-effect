---
import GradualBlur from '../GradualBlur.astro';
import { asset } from '../../utils/asset.js';
import { PARTNERS, GENERIC_DESCRIPTION } from '../../data/partners.js';
import '../../styles/about-3/partners.css';

// Names visible on the arc at rest (progress 0): rel-index 0..CULL window
// — server-rendered `is-culled` on the rest so the initial paint is
// correct before (and without) JS. partners-scroll.js re-derives per
// scrub tick from Stage 2 onward. Mirrors PARTNERS_CULL_WINDOW in
// partners-scroll.js.
const CULL_WINDOW = 10;

// Background video — the SAME clip as the founders slides (Oscar's
// request; currently the AdobeStock_2068472100 HD preview living at the
// founders path): one shared file, so the browser fetches it once for
// all three uses. This superseded the section's own AdobeStock_1891763427
// (partners-bg.mp4, removed). STILL A PREVIEW: the licensed-swap
// obligation stands. LICENSED-SWAP CHECKLIST when the final render
// lands: it swaps at the FOUNDERS path (see founders.js's media
// comment — including the bg-fade.jpg re-bake documented there), and
// this section inherits it automatically; if partners ever needs its
// OWN clip again, restore a partners-local file + these two paths.
const videoSrc = asset('/assets/about-hero/about-3/founders-bg-robbo.mp4');
const videoPoster = asset('/assets/about-hero/about-3/founders-bg-robbo-video-poster.jpg');
---

<section class="about-partners" data-about-partners aria-label="Partners">
  <!-- "Partners / They trust us" — own fixed stage, own entry/exit gates,
       own runway (partners-scroll.js), the FUTURE SECTIONS contract from
       AboutScroll.astro's landing-stage comment: CSS-default
       visibility:hidden, revealed only by this section's own
       top-vs-viewport-bottom ScrollTrigger. Zero source gap after
       `.about-landing`, whose height drops its last-section pad in
       lockstep (landing-scroll.js) — the same pixel-exact handoff as
       founders->landing, one section further down. THIS COMMENT LIVES
       INSIDE THE SECTION deliberately: a body-level comment between a
       zero-height sibling and this section produced a real ~12px
       anonymous-box strut in the previous attempt (measured, documented
       in its history) — do not move it out.

       STAGE 2 (approved staged split): the Stage-1 shell plus the live
       wheel — partners-scroll.js scrubs the UL's --progress, derives
       active/cull classes per write, and settle-snaps the display to
       the nearest name. The knockout treatment for the active name is
       Stage 3. -->
  <div class="about-partners__stage" data-about-partners-stage>
    <!-- Two-layer background — founders' EXACT architecture (see
         founders.css's --founders-blur-px comment): blur lives as
         filter: blur() ON the media element (backdrop-filter over a
         <video> is a no-op in Chromium's hardware-overlay fast path,
         confirmed live there), media overscanned so the heavy radius
         samples real content at the edges, plus a plain darken overlay
         above. Same muted/playsinline/loop/preload discipline;
         partners-scroll.js gates play/pause to stage visibility. -->
    <div class="about-partners__media-group" aria-hidden="true">
      <video
        class="about-partners__media"
        data-about-partners-video
        muted
        playsinline
        loop
        preload="none"
        poster={videoPoster}
        aria-hidden="true"
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    </div>
    <div class="about-partners__overlay" aria-hidden="true"></div>

    <!-- The arc — all 45 names, placed ENTIRELY by CSS from two custom
         properties (the fromanother.love mechanism, extracted verbatim
         in the Phase 1 recon): each name carries a static --index; the
         UL carries --progress (0 at rest; Stage 2 scrubs it) and
         --total; partners.css derives rel-index -> theta (11°/step) ->
         arc x/y -> transform. A real semantic list, reading order =
         wheel order. -->
    <ul class="about-partners__arc" data-about-partners-arc style={`--total: ${PARTNERS.length};`}>
      {
        PARTNERS.map((partner, i) => (
          <li
            class:list={[
              'about-partners__name',
              { 'is-active': i === 0, 'is-culled': i > CULL_WINDOW },
            ]}
            data-about-partners-name
            style={`--index: ${i};`}
          >
            {partner.name}
          </li>
        ))
      }
    </ul>

    <!-- Vertical soft divider between the arc and the satellites —
         Figma 8:464 (backdrop-blur 2px strip). Flagged: backdrop-filter
         behaviour over the (filter-blurred) video is a live-verify item;
         the effect is subtle by design. -->
    <div class="about-partners__divider" aria-hidden="true"></div>

    <!-- Per-brand satellites — logo / description / image for the ACTIVE
         brand (Figma 8:459 / 8:463 / 8:426 slots). One entry per brand,
         server-rendered, visibility by `.is-active` (toggled per wheel
         write from Stage 2 on; the swap dissolve is a CSS transition —
         partners.css). EMPTY-STATE (approved): no logo/image = slot
         simply absent for that brand (dissolves to empty on swap); no
         per-brand description = the shared generic line. Logo renders
         white via CSS filter regardless of supplied mark colour. -->
    <div class="about-partners__satellites" aria-hidden="true">
      {
        PARTNERS.map((partner, i) => (
          <div
            class:list={['about-partners__sat', { 'is-active': i === 0 }]}
            data-about-partners-sat={i}
          >
            {/* EAGER, deliberately (Stage-1 amendment, fix 4a): native
                loading="lazy" NEVER fires inside a hidden fixed stage —
                the exact landing-gallery-preload finding, reproduced
                here live (the Wilderness logo sat at naturalWidth 0
                until forced). The whole satellite asset pool is a
                handful of small files; eager + async decode is cheaper
                than wiring a preload trigger for it. */}
            {partner.logo && (
              <div
                class="about-partners__sat-logo"
                style={`--logo-w: ${partner.logoWidthPct ?? 100};`}
              >
                <img src={asset(partner.logo)} alt="" loading="eager" decoding="async" />
              </div>
            )}
            <p class="about-partners__sat-desc">{partner.description ?? GENERIC_DESCRIPTION}</p>
            {partner.image && (
              <div class="about-partners__sat-image">
                <img src={asset(partner.image)} alt="" loading="eager" decoding="async" />
              </div>
            )}
          </div>
        ))
      }
    </div>

    <!-- Viewport edge blurs — the /about page's GradualBlur treatment
         (same config: strength 1.5, two exponential mask-gradient
         backdrop-filter layers, opacity 0.8), on BOTH edges, scoped to
         THIS SECTION ONLY by construction: they live inside the gate-
         hidden fixed stage, so they exist exactly while the section
         does. STACKING (explicit request): the arc names and the
         logo/description satellites sit BELOW the bands (DOM order,
         auto z vs the bands' z 3); the bottom-right image (the GL slot,
         z 4 in partners.css) and the global nav (fixed, z 270, above
         the whole stage carrier at 145) sit ABOVE them. The no-WebGL
         DOM image fallback stays below the band (its per-sat stacking
         context can't be lifted past a stage-level sibling) — accepted
         degradation on the fallback path only. Static variant: no JS
         init needed (CSS shows non-animated instances). -->
    {/* 2x the /about baseline on both axes (Oscar's tune): strength
        1.5 -> 3 (layers resolve 6/24px -> 12/48px) and coverage
        6rem -> 12rem per edge. */}
    <GradualBlur
      target="parent"
      position="top"
      strength={3}
      height="12rem"
      divCount={2}
      exponential={true}
      opacity={0.8}
      zIndex={3}
    />
    <GradualBlur
      target="parent"
      position="bottom"
      strength={3}
      height="12rem"
      divCount={2}
      exponential={true}
      opacity={0.8}
      zIndex={3}
    />

    <!-- WebGL mount for the satellite image slot (Stage-2 amendment 5):
         partners-image-dissolve.js draws the per-brand photo here with
         the founders noise-dissolve. Same geometry as the per-brand
         .about-partners__sat-image slots, which stay in the DOM as the
         no-WebGL fallback (CSS blur-dissolve) — they're hidden only via
         the has-gl-image class partners-scroll.js adds on successful GL
         boot. -->
    <div class="about-partners__image-gl" data-about-partners-image-gl aria-hidden="true"></div>

    <!-- The #F9F9F9 -> dark entry transition has NO element here any
         more (Stage-1 amendment, fix 1): it's a crossfade of this whole
         STAGE over the still-running landing beneath it, scrubbed by
         partners-scroll.js from a landing-derived anchor (the final
         wave's last image crossing the viewport's vertical centre). The
         old opaque #F9F9F9 veil would have blanked exactly the image
         the melt is anchored to. -->
  </div>
</section>
