---
/**
 * Founders section — /about-3 only. Two-slide, scroll-driven carousel:
 * full-bleed RAW media (video for slide 1, image for slide 2) with a
 * LIVE blur+darken overlay above it, sharp portrait, bio + tag list,
 * large difference-blend name, and a top-right thumbnail index.
 *
 * Data-driven from `founders.js` — a third founder is a new array entry.
 *
 * Two-layer background architecture (supersedes the old pre-treated
 * WebGL background plane): each slide's `.founders__media-group` holds
 * its RAW media (untreated — slide 1's video, or slide 2's raw image).
 * The blur lives on the media itself (`filter: blur()` in founders.css —
 * backdrop-filter on a separate overlay has no visible effect over a
 * <video> in Chromium once it's composited via its hardware-overlay fast
 * path, confirmed live); ONE shared `.founders__overlay` sits above BOTH
 * media groups and applies only the rgba(22,22,22,0.2) darken. The
 * overlay is not per-slide — it's persistent and never animates once
 * revealed (see founders-scroll.js's entrance tween).
 *
 * Blend-safety contract (do not restructure casually): the crossfade in
 * `founders-scroll.js` animates opacity on each slide's individual
 * children (media-group / portrait / meta / name), NEVER on the
 * `.founders__slide` wrapper. An opacity-animated ancestor would create
 * a stacking context that isolates the name's mix-blend-mode: difference
 * from the backgrounds it must composite against.
 */
import { asset } from '../../utils/asset.js';
import { founders } from '../../data/about-3/founders.js';
import '../../styles/about-3/founders.css';
---

<section class="founders" data-founders-section aria-label="The founders">
  <div class="founders__stage" data-founders-stage>
    {founders.map((slide, i) => (
      <article
        class="founders__slide"
        data-founder-slide
        data-founder-id={slide.id}
        data-founder-index={i}
      >
        <div class="founders__media-group" data-founder-media-group>
          {slide.media.type === 'video' ? (
            <>
              <video
                class="founders__media"
                data-founder-media
                data-founder-media-type="video"
                muted
                playsinline
                loop
                preload="none"
                poster={asset(slide.media.poster)}
                aria-hidden="true"
              >
                <source src={asset(slide.media.src)} type="video/mp4" />
              </video>
              <img
                class="founders__media founders__media-fallback"
                data-founder-media-fallback
                src={asset(slide.media.poster)}
                alt=""
                loading="eager"
                decoding="async"
                aria-hidden="true"
              />
            </>
          ) : (
            <img
              class="founders__media"
              data-founder-media
              data-founder-media-type="image"
              src={asset(slide.media.src)}
              alt=""
              loading="eager"
              decoding="async"
              aria-hidden="true"
            />
          )}
        </div>
        <div class="founders__portrait" data-founder-portrait>
          <img src={asset(slide.photo)} alt={slide.alt} loading="eager" decoding="async" />
        </div>
        <div class="founders__meta" data-founder-meta>
          <div class="founders__bio" data-founder-bio>
            {slide.bio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <p class="founders__tags-heading" data-founder-tags-heading>{slide.tagsHeading}</p>
          <p class="founders__tags" data-founder-tags>
            {slide.tags.map((tag, j) => (
              <>
                {/* Real spaces around the slash — they're the tag line's only
                    break opportunities (each tag span is nowrap). */}
                {j > 0 && <span class="founders__tag-sep" aria-hidden="true">{' / '}</span>}
                <span class="founders__tag">
                  {tag.label}
                  <sup class="founders__tag-index">{tag.index}</sup>
                </span>
              </>
            ))}
          </p>
        </div>
        <h2 class="founders__name-clip" data-founder-name-clip>
          <span class="founders__name" data-founder-name>{slide.name}</span>
        </h2>
      </article>
    ))}

    <!-- Single live treatment layer above BOTH media groups, below the
         portrait/meta/name/index — see the component doc comment above.
         Persistent once revealed; never animates again after its entrance
         fade-in (founders-scroll.js). -->
    <div class="founders__overlay" data-founders-overlay aria-hidden="true"></div>

    <!-- Slide index — fixed order (Robbo top, Ashley bottom). Per Figma,
         the CURRENT slide's thumbnail carries a 0.5px #f9f9f9 border (the
         .founders__thumb-border overlay, opacity-scrubbed by the
         crossfade) and the tick + /0n marker sits at the active thumb's
         vertical centre, travelling to the other during the transition.
         Hidden entirely under prefers-reduced-motion (static layout). -->
    <div class="founders__index" data-founders-index aria-hidden="true">
      {founders.map((slide, i) => (
        <div class="founders__thumb" data-founders-thumb={i}>
          <img src={asset(slide.photo)} alt="" loading="eager" decoding="async" />
          <span class="founders__thumb-border" data-founders-thumb-border={i}></span>
        </div>
      ))}
      <div class="founders__marker" data-founders-marker>
        <span class="founders__marker-labels">
          {founders.map((_, i) => (
            <span class="founders__marker-label" data-founders-label={i}>
              {`/0${i + 1}`}
            </span>
          ))}
        </span>
        <span class="founders__marker-tick"></span>
      </div>
    </div>

    <!-- Exhale-exit veil — #F9F9F9, opacity-scrubbed 0→1 across exit
         beat 2 (founders-scroll.js) while the last slide's media over-
         blurs beneath it, melting the section into the page base colour.
         z 45: above the index (40)/name (30), but beat 1 has already
         faded all content by the time this gains any opacity, so it
         never occludes (or blend-isolates — it's a sibling of the name,
         not an ancestor) anything visible. display: none under reduced
         motion (founders.css). -->
    <div class="founders__exit-veil" data-founders-exit-veil aria-hidden="true"></div>
  </div>
</section>

<script>
  import { initFoundersScroll } from '../../scripts/about-3/founders-scroll.js';

  let cleanupFounders = initFoundersScroll();

  document.addEventListener('astro:before-swap', () => {
    cleanupFounders?.();
    cleanupFounders = undefined;
  }, { once: true });
</script>
