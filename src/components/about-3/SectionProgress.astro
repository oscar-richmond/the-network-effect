---
/**
 * Left-side section-progress indicator — /about-3 only.
 *
 * Rows 01/02 map to real sections (hero runway, founders); 03/04 are
 * placeholders — they render and take part in the distance-opacity/
 * window logic but never activate (no ScrollTrigger anchor). When those
 * sections are built, add their anchor to REAL_ANCHORS in
 * section-progress.js and the row comes alive.
 *
 * The "04 — our partners" row (and its REAL_ANCHORS entry + the
 * partners-side re-show scrub) LEFT with the wheel's relocation to
 * /services — the second AUTHORIZED SectionProgress exception (Oscar,
 * services-page split). With no re-show downstream, the indicator now
 * stays hidden from landing-scroll.js's authorized hide to the end of
 * the page (flagged in the split plan; rotating never had a row).
 *
 * REMAINING FIGMA DISCREPANCY (logged, deliberately NOT resolved here —
 * out of the authorized scope): the Figma nav (node 8:399 recon) shows
 * SIX rows; reconciling count/numbering/labels wholesale needs its own
 * authorization + label copy from Oscar.
 *
 * Labels are cased by `text-transform: lowercase` in CSS, not by how the
 * strings here happen to be written.
 */
import '../../styles/about-3/section-progress.css';

const sections = [
  { numeral: '01', label: 'About' },
  { numeral: '02', label: 'The Founders' },
  { numeral: '03', label: 'Three Pillars' },
  { numeral: '04', label: 'Placeholder' },
];
---

<nav class="section-progress" data-section-progress aria-hidden="true">
  {sections.map((section, i) => (
    <div class="section-progress__row" data-sp-row={i}>
      <span class="section-progress__numeral" data-sp-numeral>{section.numeral}</span>
      <span class="section-progress__dash" data-sp-dash></span>
      <span class="section-progress__label" data-sp-label>{section.label}</span>
    </div>
  ))}
</nav>

<script>
  import { initSectionProgress } from '../../scripts/about-3/section-progress.js';

  let cleanupSectionProgress = initSectionProgress();

  document.addEventListener('astro:before-swap', () => {
    cleanupSectionProgress?.();
    cleanupSectionProgress = undefined;
  }, { once: true });
</script>
