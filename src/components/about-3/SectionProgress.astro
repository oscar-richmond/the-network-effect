---
/**
 * Left-side section-progress indicator — /about-3 only.
 *
 * Rows 01/02 map to real sections (hero runway, founders); 03/04/05 are
 * placeholders for sections that don't exist yet — they render and take
 * part in the distance-opacity/window logic but never activate (no
 * ScrollTrigger anchor). When those sections are built, add their anchor
 * to REAL_ANCHORS in section-progress.js and the row comes alive.
 *
 * Labels are cased by `text-transform: lowercase` in CSS, not by how the
 * strings here happen to be written.
 */
import '../../styles/about-3/section-progress.css';

const sections = [
  { numeral: '01', label: 'About' },
  { numeral: '02', label: 'The Founders' },
  { numeral: '03', label: 'Three Pillars' },
  { numeral: '04', label: 'Our Partners' },
  { numeral: '05', label: 'Placeholder' },
];
---

<nav class="section-progress" data-section-progress aria-hidden="true">
  {sections.map((section, i) => (
    <div class="section-progress__row" data-sp-row={i}>
      <span class="section-progress__numeral" data-sp-numeral>{section.numeral}</span>
      <span class="section-progress__dash" data-sp-dash></span>
      <span class="section-progress__label" data-sp-label>{section.label}</span>
    </div>
  ))}
</nav>

<script>
  import { initSectionProgress } from '../../scripts/about-3/section-progress.js';

  let cleanupSectionProgress = initSectionProgress();

  document.addEventListener('astro:before-swap', () => {
    cleanupSectionProgress?.();
    cleanupSectionProgress = undefined;
  }, { once: true });
</script>
