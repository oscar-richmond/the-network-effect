---
/**
 * The /holding-3 deck-request form (Figma SB1V2GBQ0aBsSIdcXPr7dl,
 * Group 89 in frame 1:90) — rendered only inside HoldingPage's `final`
 * branch, desktop >=1025 only (the whole .holding-final__content is
 * display:none below the breakpoint; mobile keeps the deferred
 * rolling-tagline hero untouched).
 *
 * Left-aligned internally per the file (Oscar-confirmed); the block as
 * a whole still centres on the page's outer axis via the content
 * column. Field labels sit ABOVE inputs (not placeholders). The submit
 * is the CTAs' text-link treatment at 14px (its own data attribute
 * keeps it inside the ported .holding-spin styles + the variant's red
 * underline); "Back" (ink underline, no arrow) returns to the intro
 * state — Contact lives there now (the click-trigger conversion).
 *
 * BLEND SAFETY: the subheading's siblings here — the LABELS — are
 * white + mix-blend-difference roots (per the file). Their ancestors
 * (.holding-final__field, __form, __form-zone, __content, the column)
 * carry position:relative at most, never opacity/transform/filter or
 * position+z-index — no stacking context isolates them. Entry reveals
 * therefore fade the LEAF elements (label, input) individually, never
 * a shared wrapper. The success swap hides the form via visibility
 * (blend-safe, no isolation) and fades IN the plain-colour note — the
 * form itself is never opacity-faded, which would flash the blended
 * labels white mid-fade.
 *
 * Submission: POST /api/deck-request (Vercel function + Resend).
 * Honeypot: the "website" field — off-canvas (not display:none, which
 * savvier bots skip), tab-skipped, aria-hidden; filled => the client
 * mirrors the server and silently "succeeds" without sending.
 */
interface Props {
  /** The studio mailto (built in HoldingPage, .com) — used by the
   * Contact link elsewhere on the page. Received but intentionally
   * unread here: the error fallback below uses its own .co.uk
   * address instead, scoped to this one instance per Oscar's
   * explicit request (see errorMailto). */
  contactMailto: string;
}

// eslint-disable-next-line no-unused-vars -- kept for the Props
// contract; HoldingPage still passes it down for the Contact link.
const { contactMailto: _contactMailto } = Astro.props;

// SCOPED to the error-state fallback only (Oscar's explicit ask) —
// .co.uk, not the shared contactMailto (.com) used by the Contact
// link and the deck-request recipient elsewhere. Oscar noted .co.uk
// is "the correct email going forward"; flagged as a real
// inconsistency worth a broader decision, not applied site-wide here.
const errorMailto = `mailto:hello@thenetworkeffect.co.uk?subject=${encodeURIComponent(
  'The Network Effect — Enquiry',
)}`;
---

<div class="holding-final__form-zone">
  <form
    class="holding-final__form"
    data-holding-deck-form
    method="post"
    action="/api/deck-request"
    novalidate
  >
    <div class="holding-final__field" data-holding-final-field>
      <label class="holding-final__label" for="deck-req-name">Full name</label>
      <input
        class="holding-final__input"
        id="deck-req-name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength="200"
        data-deck-input="name"
      />
      <span
        class="holding-final__field-error"
        id="deck-req-name-error"
        data-deck-error="name"
        hidden></span>
    </div>

    <div class="holding-final__field" data-holding-final-field>
      <label class="holding-final__label" for="deck-req-email">Email address</label>
      <input
        class="holding-final__input"
        id="deck-req-email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="200"
        data-deck-input="email"
      />
      <span
        class="holding-final__field-error"
        id="deck-req-email-error"
        data-deck-error="email"
        hidden></span>
    </div>

    <div class="holding-final__field" data-holding-final-field>
      <label class="holding-final__label" for="deck-req-company">Company</label>
      <input
        class="holding-final__input"
        id="deck-req-company"
        name="company"
        type="text"
        autocomplete="organization"
        maxlength="200"
        data-deck-input="company"
      />
      <span
        class="holding-final__field-error"
        id="deck-req-company-error"
        data-deck-error="company"
        hidden></span>
    </div>

    <!-- Honeypot: humans never see or tab into this; autofilling bots
         do. Off-canvas rather than display:none. -->
    <div class="holding-final__hp" aria-hidden="true">
      <label for="deck-req-website" tabindex="-1">Website</label>
      <input
        id="deck-req-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
        data-deck-input="website"
      />
    </div>

    <div class="holding-final__form-row">
      {/* Back (Oscar-approved: replaces Contact inside the form state —
          Contact stays one click away via the intro). Plain .holding-btn
          text-link treatment: INK underline (deliberately NOT the red
          data-holding-final-button variant), no arrow. Esc mirrors it
          (holding-deck-form.js); gone after success along with the
          whole form (the success note is terminal). */}
      <button class="holding-btn" data-deck-back type="button">
        <span class="holding-btn__clip"
          ><span class="holding-btn__inner">Back</span></span
        >
      </button>
      <button
        class="holding-btn holding-final__submit"
        data-holding-final-button
        data-deck-submit
        type="submit"
      >
        <span class="holding-btn__clip"
          ><span class="holding-btn__inner" data-deck-submit-label>Request</span></span
        >
        <span class="holding-final__cta-arrow" data-deck-submit-arrow aria-hidden="true">
          <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M1.33108 9L0.688252 8.31631L0.0454274 7.67349L6.25 1.61364L1.62559e-07 1.61364L0 0H9V9L7.38636 9L7.38636 2.75L1.33108 9Z"
              fill="currentColor"
            />
          </svg>
        </span>
      </button>
    </div>
  </form>

  <!-- Success: overlays the (visibility-hidden) form in place — same
       container, no layout jump. aria-live so the swap is announced. -->
  <div
    class="holding-final__note holding-final__note--success"
    data-deck-success
    role="status"
    aria-live="polite"
    hidden
  >
    <p class="holding-final__note-title">Sent — we’ll be in touch shortly.</p>
  </div>

  <!-- Error: appears BELOW the intact form (typed data preserved),
       with the direct-email fallback. -->
  <div
    class="holding-final__note holding-final__note--error"
    data-deck-error-note
    role="alert"
    hidden
  >
    {/* One continuous sentence, both clauses in the SAME style (Oscar's
        revision) — a single flowing line, not a title+sub pairing.
        .co.uk here only — see errorMailto's note above. */}
    <p class="holding-final__note-sub">
      Something went wrong — nothing was sent. Email us directly at <a
        href={errorMailto}>hello@thenetworkeffect.co.uk</a>.
    </p>
  </div>
</div>
