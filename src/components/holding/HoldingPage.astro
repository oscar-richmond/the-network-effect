---
/**
 * The holding page body, shared verbatim by /holding and /holding-2 —
 * extracted from holding.astro so the two comparison pages can never
 * drift: a later fix to the tagline/buttons/sign-off/choreography lands
 * here once. The ONLY difference between the pages is the gallery
 * region's children (the "gallery" slot below — /holding's default is
 * the fold gallery's poster; /holding-2 provides its slide stack) and
 * the per-page gallery module booted from each page's own script.
 *
 * PENDING SIGN-OFF: the right-side gallery images and the 5 inline
 * tagline images are placeholder-until-approved, per the site's standing
 * content policy.
 * COPY NOTE for founder review: the tagline reads "CULTURE" here, per the
 * Figma file — the /about-3 hero's equivalent line reads "CULTURAL". Built
 * as the Figma reads; flagging the wording difference for sign-off.
 */
import {
  galleryImages as foldGalleryImages,
  taglineImages,
  travelGalleryImages,
} from '../../data/holding/images.js';
import HoldingDeckForm from './HoldingDeckForm.astro';
import '../../styles/holding/holding-page.css';

interface Props {
  /** The gallery region's image set (data attribute + default-slot
   * poster). Defaults to /holding's fold set; /holding-2 passes its own
   * warp set — the two pages' imagery forked when the warp column got
   * the HPG set. */
  galleryImages?: string[];
  /** /holding-3's FINAL desktop design (.holding-final): renders the
   * new left-column content + accent bar ADDITIVELY alongside the old
   * elements. CSS gates the two sets by breakpoint — old column shows
   * <=1024 (the deferred shared mobile layout), new content >=1025.
   * Off for /holding and /holding-2: their output is unchanged. */
  final?: boolean;
}

const { galleryImages = foldGalleryImages, final = false } = Astro.props;

// The company deck — Google Drive share link (supersedes the never-
// placed local-PDF TODO; nothing existed on disk to remove).
const deckHref =
  'https://drive.google.com/file/d/17njeND6nxOpfHg85g73hopZFS3o37uUu/view?usp=sharing';
// CONTACT: .co.uk — Oscar's FINAL, explicitly confirmed address,
// overriding every prior domain instruction in this build (the old
// .com evidence below is now superseded; the site's OTHER contact
// points outside the holding pages still say .com and are unaddressed
// — out of this scope, flagged separately). Subject is Oscar-approvable
// in one look: "The Network Effect — Enquiry" (em dash, the site's
// typographic register), URL-encoded at build time. contactEmail is
// split out (rather than re-parsed from the mailto string at runtime)
// so the /holding-3 desktop Contact link's click-to-copy behaviour has
// a single source of truth for the literal address to copy.
const contactEmail = 'hello@thenetworkeffect.co.uk';
const contactMailto = `mailto:${contactEmail}?subject=${encodeURIComponent(
  'The Network Effect — Enquiry',
)}`;

const TAGLINE_ROTATE_WORDS = ['CONSULTANCY', 'NETWORK', 'STUDIO', 'COLLECTIVE'];
---

<div class="holding-page__stage">
  <div class="holding-page__column">
    <div class="holding-wordmark" data-holding-wordmark aria-hidden="true">
      THE NETWORK EFFECT
    </div>
    <h1 class="holding-visually-hidden">The Network Effect</h1>

    <!-- Buttons are anchored to the tagline block's bottom edge (48px
         gap, matching the Figma's tagline-ends-y633/buttons-y681 read)
         via normal flow + margin, not page coordinates — the
         relationship survives the tagline resizing. -->
    <div class="holding-page__hero">
      <div class="holding-tagline" data-holding-tagline aria-hidden="true">
        <div class="holding-tagline__text" data-holding-tagline-text>
          <p class="holding-tagline__line holding-tagline__line--left">WE ARE A</p>
          <div class="holding-tagline__line holding-tagline__line--indent">
            <div class="holding-tagline__culture">
              <span class="holding-tagline__culture-word">CULTURE</span>
              <!-- Invisible layout slot only — reserves the exact
                   inline space the image needs so "CULTURE"/"&" wrap
                   correctly, but never paints anything. A real <img>
                   living inside .holding-tagline (the mix-blend-mode:
                   difference root) gets differenced as part of that
                   whole subtree regardless of its own blend-mode —
                   mix-blend-mode:normal on a descendant does not
                   opt it out (see the identical note on the /about-3
                   hero's tagline, about-hero.css). The real, visible
                   image is the fixed overlay below, a SIBLING of
                   .holding-tagline entirely outside the blend subtree. -->
              <span class="holding-tagline__culture-img-wrap" aria-hidden="true"></span>
              <span class="holding-tagline__culture-amp">&amp;</span>
            </div>
          </div>
          <p class="holding-tagline__line holding-tagline__line--left">PARTNERSHIPS</p>
          <p class="holding-tagline__line holding-tagline__line--indent">
            <span
              class="holding-tagline__rotate"
              data-holding-tagline-rotate
              aria-live="polite"
            >
              <span class="holding-tagline__rotate-inner">{TAGLINE_ROTATE_WORDS[0]}</span>
            </span>
          </p>
        </div>
      </div>
      <!-- PENDING SIGN-OFF: placeholder inline images. Position-synced
           to the invisible slot above by holding-entry.js. Two stacked
           layers so rotation is a true cross-fade: the base layer always
           holds a fully-opaque image while the top layer fades in/out
           over it (initImageRotate) — the ground never shows through.
           First paint renders images[0] on the base layer, static. -->
      <div
        class="holding-tagline__culture-overlay"
        data-holding-tagline-img-overlay
        data-tagline-images={JSON.stringify(taglineImages)}
        aria-hidden="true"
      >
        <img
          class="holding-tagline__culture-overlay-img"
          data-holding-tagline-img-base
          src={taglineImages[0]}
          alt=""
          decoding="async"
        />
        <img
          class="holding-tagline__culture-overlay-img holding-tagline__culture-overlay-img--top"
          data-holding-tagline-img-top
          alt=""
          decoding="async"
        />
      </div>
      <p class="holding-visually-hidden">
        We are a culture &amp; partnerships consultancy.
      </p>

      <div class="holding-buttons">
        <a
          class="holding-btn holding-btn--solid"
          data-holding-button
          href={deckHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="holding-btn__clip"
            ><span class="holding-btn__inner">View company deck</span></span
          >
        </a>
        <!-- mailto deliberately has NO target="_blank": a plain mailto
             invokes the mail client without navigating this page, while
             _blank+mailto is exactly what produces the flash-open blank
             tab (the iOS Safari artifact flagged in the task). -->
        <a
          class="holding-btn holding-btn--outline"
          data-holding-button
          href={contactMailto}
        >
          <span class="holding-btn__clip"
            ><span class="holding-btn__inner">Contact</span></span
          >
        </a>
      </div>
    </div>

    <p class="holding-signoff" data-holding-signoff>
      We are a relationship-led consultancy connecting Talent, Brands and
      Audiences through Experiences, Strategic Partnerships and Media.
    </p>

    {
      final && (
        <>
          {/* FINAL desktop content (>=1025 only; see holding-page.css's
              .holding-final section): TWO STATES in one slot, swapped
              by holding-deck-form.js.

              INTRO (default, restored pre-form block): title +
              three-line paragraph + CTA row, per-item centred. The
              deck CTA is now a BUTTON that opens the form — the Drive
              link is retired on this route (Oscar-confirmed; the form
              IS the deck path here; /holding's dormant variant keeps
              the link). All intro content is plain #161616 — no blend
              roots — which is what makes the swap's GROUP fade on this
              container legal (the form side never gets one: its
              subheading/labels are difference roots and only ever fade
              as leaves).

              FORM (hidden until triggered): the deck-request form
              (Figma Group 89), left-aligned internally. The heading is
              a real <h2>; the blended subheading is faithful to the
              file's own inconsistency (reads dark on this ground
              either way). Submit + Back live inside the component. */}
          <div class="holding-final__content" data-holding-final-content>
            <div class="holding-final__intro" data-deck-intro>
              <div
                class="holding-final__intro-title"
                data-holding-final-title
                aria-hidden="true"
              >
                THE NETWORK EFFECT
              </div>
              <p class="holding-final__para" data-holding-final-para>
                <span class="holding-final__para-line">
                  We are a relationship-led consultancy connecting
                </span>
                <span class="holding-final__para-line">
                  Talent, Brands and Audiences through Experiences,
                </span>
                <span class="holding-final__para-line">Strategic Partnerships and Media.</span>
              </p>
              <div class="holding-final__ctas">
                <button class="holding-btn" data-holding-final-button data-deck-open type="button">
                  <span class="holding-btn__clip"
                    ><span class="holding-btn__inner">Request company deck</span></span
                  >
                  <span class="holding-final__cta-arrow" aria-hidden="true">
                    <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M1.33108 9L0.688252 8.31631L0.0454274 7.67349L6.25 1.61364L1.62559e-07 1.61364L0 0H9V9L7.38636 9L7.38636 2.75L1.33108 9Z"
                        fill="currentColor"
                      />
                    </svg>
                  </span>
                </button>
                {/* No target on the mailto — still the real href/fallback if
                    JS fails or is blocked. Click-to-copy: the link itself
                    shows NO feedback (Oscar's revision — the earlier
                    in-button label/icon crossfade is removed); confirmation
                    is the cursor-bound tooltip pill below, driven by
                    holding-deck-form.js's initHoldingContactCopy. */}
                <a
                  class="holding-btn"
                  data-holding-final-button
                  data-holding-contact-copy
                  data-contact-email={contactEmail}
                  href={contactMailto}
                >
                  <span class="holding-btn__clip"
                    ><span class="holding-btn__inner">Contact</span></span
                  >
                  <span class="holding-final__cta-arrow" aria-hidden="true">
                    <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M1.33108 9L0.688252 8.31631L0.0454274 7.67349L6.25 1.61364L1.62559e-07 1.61364L0 0H9V9L7.38636 9L7.38636 2.75L1.33108 9Z"
                        fill="currentColor"
                      />
                    </svg>
                  </span>
                </a>
              </div>
              {/* A genuine live region for the copy confirmation: the
                  visual tooltip is aria-hidden (it chases the cursor —
                  useless to AT); this gets its text SET/CLEARED by JS at
                  the moment of copy, which triggers a real announcement. */}
              <p
                class="holding-visually-hidden"
                aria-live="polite"
                data-holding-contact-announcer
              />
            </div>

            <div class="holding-final__form-block" data-deck-form-block hidden>
              {/* Two literal lines (Oscar's revision — the Figma file's
                  single-line "Request THE deck" is superseded here),
                  same nowrap-line pattern as the intro paragraph so
                  the break holds regardless of container width. */}
              <h2 class="holding-final__title">
                <span class="holding-final__title-line">Request our</span>
                <span class="holding-final__title-line">Company deck</span>
              </h2>
              <p class="holding-final__sub">A few details, and it's on its way.</p>
              <HoldingDeckForm contactMailto={contactMailto} />
            </div>
          </div>
          <p class="holding-final__signoff" data-holding-final-signoff>
            <span
              class="holding-final__signoff-line holding-final__signoff-line--serrif"
              data-holding-final-signoff-serrif>Built on Trust.</span
            >
            <span
              class="holding-final__signoff-line holding-final__signoff-line--dazzed"
              data-holding-final-signoff-dazzed>Powered by access.</span
            >
          </p>
        </>
      )
    }
  </div>

  <!-- The gallery region. Keeps the photo's entry slot and treatment:
       holding-entry.js reveals [data-holding-image] (fade+rise at
       HOLDING_IMAGE_AT). Children come from the "gallery" slot — the
       default below is /holding's fold-gallery poster (the resting
       first card; canvas takes over once every texture is decoded;
       under reduced motion or failed WebGL the poster simply stays).
       /holding-2 slots its server-rendered slide stack instead. -->
  <div
    class="holding-page__photo"
    data-holding-image
    data-holding-gallery
    data-gallery-images={JSON.stringify(galleryImages)}
  >
    <slot name="gallery">
      <!-- PENDING SIGN-OFF: placeholder gallery imagery -->
      <img
        class="holding-gallery__poster"
        data-holding-gallery-poster
        src={galleryImages[0]}
        alt=""
        decoding="async"
      />
    </slot>
    <!-- The SHARED mobile travel mechanic's poked poster (<=1024, all
         routes identical regardless of desktop variant): the static
         frame for RM / no-WebGL / pre-decode. Hidden above the
         breakpoint; the slot content above is hidden below it. -->
    <img
      class="holding-travel__poster"
      data-holding-travel-poster
      src={travelGalleryImages[0]}
      alt=""
      decoding="async"
      aria-hidden="true"
    />
  </div>

  {
    final && (
      <>
        {/* FINAL accent bar: fixed, flush right, full height — the photo
            region's 16px right margin makes their edges touch exactly.
            A sibling of both columns (blend safety: ancestor of nothing),
            z 1 over the photo, under the grain (z 9000). */}
        <div class="holding-final__bar" data-holding-final-bar aria-hidden="true" />
        {/* Copy-confirmation tooltip (Oscar's revision, screenshot spec):
            #161616 pill, tick left, "Email copied" Dazzed Medium 12px
            white. CURSOR-BOUND — fixed at top-left, positioned every
            mousemove by JS transform while visible (holding-deck-form.js's
            initHoldingContactCopy). aria-hidden: it chases the pointer,
            so AT gets the announcer live-region instead. Another fixed
            leaf sibling — ancestor of nothing, blend-safe; sits under the
            grain (z 9000) like all page UI. */}
        <div class="holding-final__copy-tip" data-holding-copy-tip aria-hidden="true" hidden>
          <svg
            width="10"
            height="10"
            viewBox="0 0 10 10"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M1.5 5.4L4 7.9L8.5 2.2"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Email copied</span>
        </div>
      </>
    )
  }
</div>

<div class="holding-page__grain" aria-hidden="true"></div>
