---
/**
 * THE FOUNDERS RAIL (mobile rebuild Part 2, 2026-09-08) — frame 1:34: a
 * 306-tall band of three cards on an 8 gap from the 16 inset, horizontally
 * scrollable, snapping per card:
 *
 *   1:36  Robbo   230 × 306  — 1:40 drawn 240.5 × 335.1 at (−4.69, −11.85)
 *   1:41  Ashley  224.4 × 306 — 1:47 (visible) drawn 239.1 × 333.1 at (−4.08, −5.46);
 *                 the Robbo layer beneath it (1:46) is fully covered, not rendered
 *   1:48  Both    466 × 306  — a 16 lead, then 1:52 drawn 460 × 306 at (−9, 0) in a 450 window
 *
 * 1:54 lays the band's edge gradient over the rail (dark → clear at 5%,
 * clear → dark from 94%); here the two edges are separate overlays whose
 * opacity is a function of the rail's scroll (scripts/mobile/founders.js):
 * the right one while there is content beyond, the left one once scrolled.
 *
 * Same photographs as the desktop's figures (which the gate removes on the
 * phone): Robbo from the frame's own 870×1212 upload (the repo's is 473
 * wide), Ashley and the pair from the repo. PENDING SIGN-OFF as on the
 * desktop — placeholder photographs until approved. Links as R21: each
 * portrait to its founder's slide on /founders.
 */
import { asset } from '../../utils/asset.js';
import { imageSrcset } from '../../utils/thumb-srcset.js';
import { QUERIES } from '../../config/breakpoints.js';
const robbo = asset('/assets/landing/mobile/robbo.jpg');
const ashley = asset('/assets/landing/founders/ashley-portrait.jpg');
const both = asset('/assets/landing/founders/founders-photo.jpg');
const cards = [
  { key: 'robbo', src: robbo, srcset: imageSrcset(robbo, [480, 700], 870), sizes: `${QUERIES.phone} 230px, 230px`, href: '/founders#robbo', label: 'Robbo McCallum — founder profile', alt: 'Robbo McCallum' },
  { key: 'ashley', src: ashley, srcset: undefined, sizes: undefined, href: '/founders#ashley', label: 'Ashley Walters — founder profile', alt: 'Ashley Walters' },
  { key: 'both', src: both, srcset: imageSrcset(both, [780, 1200], 1600), sizes: `${QUERIES.phone} 450px, 450px`, href: '/founders', label: 'The founders', alt: 'Robbo McCallum and Ashley Walters' },
];
---
<div class="m-frail-wrap" data-frail-wrap>
  <div class="m-frail" data-frail aria-label="The founders">
    {cards.map((c) => (
      <a class:list={['m-frail__card', `m-frail__card--${c.key}`]} href={c.href} aria-label={c.label} data-frail-card>
        <img src={c.src} srcset={c.srcset} sizes={c.sizes} alt={c.alt} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
  <div class="m-frail__edge m-frail__edge--l" data-frail-edge="l" aria-hidden="true"></div>
  <div class="m-frail__edge m-frail__edge--r" data-frail-edge="r" aria-hidden="true"></div>
</div>
