---
/**
 * THE CLOSING STATEMENT — the phone's fourteen lines (mobile rebuild Part 3
 * §4, 2026-09-08; frame 1:373): 48/45 uppercase at the frame's indents,
 * four lines right-aligned to the measure. Same words as the desktop's nine
 * placed lines (statements.js). The stage pins centred while the ground
 * scrubs grey → red (closing.js — the driver); the gate removes the
 * desktop's stage on the phone.
 */
import { CLOSING_STATEMENT } from '../../data/landing/statements.js';
---
<div class="m-closing-st" data-closing-st-m>
  <p class="m-closing-st__lines">
    {CLOSING_STATEMENT.mobile.map((l) => (
      <span class:list={['m-closing-st__line', { 'm-closing-st__line--right': 'right' in l }]} style={'right' in l ? `--m-r:${l.right}px` : `--m-x:${l.x}px`}>{l.t}</span>
    ))}
  </p>
</div>
