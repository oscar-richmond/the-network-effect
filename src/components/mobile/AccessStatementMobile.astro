---
/**
 * WE CREATE ACCESS — the phone's label and statement (mobile rebuild Part 3
 * §2, 2026-09-08; frame 1:336 + 1:326): WHAT WE DO centred, then eight
 * 48/45 lines in the frame's fragmented composition, each at its authored
 * indent. Same words as the desktop's seven lines (statements.js); the
 * gate removes the desktop's headline block on the phone.
 */
import { ACCESS_LABEL, ACCESS_STATEMENT } from '../../data/landing/statements.js';
---
<div class="m-access-st" data-access-st-m>
  <p class="m-access-st__label">{ACCESS_LABEL}</p>
  <h2 class="m-access-st__lines">
    {ACCESS_STATEMENT.mobile.map((l) => (
      <span class="m-access-st__line" style={`--m-x:${l.x}px`}>{l.t}</span>
    ))}
  </h2>
</div>
