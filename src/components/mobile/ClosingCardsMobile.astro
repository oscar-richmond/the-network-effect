---
/**
 * MOST BRANDS — THE CARDS (mobile rebuild Part 3 §3, 2026-09-08; frame
 * 1:343): four 280 cards on a 288 pitch — the tile (280 × 280, cover-fit),
 * the keyword at the title tier 24 below, its line at the body tier 36
 * below that — TRUST / BEHAVIOUR / INFLUENCE / CREDIBILITY from the same
 * data as the desktop's tiles and keywords (closing.js). A snapping rail
 * with the light ground's edge gradients (rail.js) and the indicator
 * (1:389) right-aligned beneath. The gate removes the desktop's tiles and
 * keyword blocks on the phone.
 */
import { asset } from '../../utils/asset.js';
import { imageSrcset } from '../../utils/thumb-srcset.js';
import { QUERIES } from '../../config/breakpoints.js';
import { CLOSING_TILES, CLOSING_KEYWORDS } from '../../data/landing/closing.js';
const cards = CLOSING_KEYWORDS.map((k, i) => ({ ...k, src: asset(CLOSING_TILES[i].src) }));
/* the density cap: two thirds of the 280 card (the tablet's 360) — DPR 3 / DPR 2 resolve to the 600 variant, not the original */
const sizes = `${QUERIES.phone} 187px, 240px`;
---
<div class="m-brands-wrap" data-brands-wrap>
  <div class="m-brands" data-brands-rail aria-label="Why access matters">
    {cards.map((c) => (
      <article class="m-brands__card" data-brands-card>
        <figure class="m-brands__img" aria-hidden="true"><img src={c.src} srcset={imageSrcset(c.src, [600], 900)} sizes={sizes} alt="" loading="lazy" decoding="async" /></figure>
        <h3 class="m-brands__word">{c.word}</h3>
        <p class="m-brands__line">{c.line}</p>
      </article>
    ))}
  </div>
  <div class="m-brands__edge m-brands__edge--l" data-brands-edge="l" aria-hidden="true"></div>
  <div class="m-brands__edge m-brands__edge--r" data-brands-edge="r" aria-hidden="true"></div>
</div>
