---
/**
 * START A PROJECT — the site-wide form modal (R40, Oscar 2026-09-04).
 *
 * SHELL: the schedule-a-call modal's machinery reused wholesale (the
 * brand-black frosted backdrop fading via its OWN properties, the
 * logo-only z-order — a top-level fixed logo twin carrying difference
 * itself at z401, everything else behind the z400 backdrop — the focus
 * trap, Esc, return-focus to the trigger, the hidden → reflow → is-open
 * transitions, the scroll lock through Lenis, the [hidden] display
 * guard). The two modals are siblings: opening either closes the other
 * (the `ne:modal-open` event).
 *
 * STEPS (the reference's pattern, adapted — see the R40 report):
 *   /01  WHAT KIND OF PROJECT?  — pillar tiles, MULTI-select (a
 *        checkbox group), at least one required; WHO ARE YOU? — a
 *        single-select chip row (radio group); CANCEL / NEXT.
 *   /02  TELL US MORE.          — name, email, company (optional),
 *        message; the honeypot; BACK / SEND (SENDING while pending).
 *   Success and error states replace the panel's content.
 *
 * TYPE: field labels in the eyebrow tier (Dazzed SemiBold 14 caps);
 * the step headline in the card-title tier (Serrif Condensed Medium
 * 34/38 — the Section serif; the 56 statement tier reads as a page
 * headline, too loud inside the panel — reported); inputs and
 * helper copy in Serrif Condensed. Inputs are hairline-underline
 * fields on the 2px divider grammar.
 *
 * ACCENT TRAIL: R40 (2026-09-04 a.m.) shipped ONE accent, brand red
 * #C1250E (selected tiles, the primary button, focus and validation).
 * R44 (Oscar, 2026-09-04 p.m.) SUPERSEDES it for the FORM ONLY: the
 * accent is brand blue #232A89 — selected tiles and chips (blue fill,
 * white ink), the primary button, the progress bar. Validation stays
 * red (an error, not an accent). The floating case-study CTA stays
 * red — that is the CTA family's variant, not the form's.
 *
 * R44 LAYOUT: a RIGHT-SIDE DRAWER — one third of the viewport wide,
 * flush top / right / bottom, sliding in from the right edge (the
 * nav stays beneath the frosted backdrop; the wordmark twin stays
 * through). The close control is a bare X; clicking the backdrop
 * anywhere closes; the /0N index sits on the content column; the
 * tiles and chips share one resting treatment (black outline, black
 * ink) and one selected treatment (blue fill, white ink); NEXT / SEND
 * are solid blue, CANCEL / BACK the ghost; every field carries a
 * placeholder one tier below its text; a 2px blue progress bar rides
 * the drawer's bottom edge (⅓ → ⅔ → full); the pointer over the
 * backdrop reads "( CLOSE )" via the /work view-case cursor.
 *
 * COPY flagged my-edit-pending (Oscar): the success headline and line;
 * the R44 placeholders.
 * DEEP LINK: ?project=1 or #start-project opens on load.
 */
import { CONTACT_EMAIL } from '../data/landing/contact.js';
const PILLARS = [
  { key: 'immerse', name: 'IMMERSE', desc: 'Experiences & cultural moments' },
  { key: 'connect', name: 'CONNECT', desc: 'Partnerships & talent' },
  { key: 'amplify', name: 'AMPLIFY', desc: 'Narrative & media' },
  { key: 'unsure', name: 'NOT SURE YET', desc: 'We’ll help you find the shape' },
];
const WHO = ['BRAND', 'TALENT', 'AGENCY', 'OTHER'];
const MAILTO = `mailto:${CONTACT_EMAIL}`;
---

<div class="sp-modal" data-sp-modal role="dialog" aria-modal="true" aria-labelledby="sp-title" hidden>
  <div class="sp-modal__backdrop" data-sp-backdrop aria-hidden="true"></div>
  <div class="sp-modal__band">
    <form class="sp-modal__panel" data-sp-panel novalidate action="/api/start-project" method="post">
      <p class="sp-modal__index" data-sp-index aria-hidden="true">/01</p>
      {/* R44 item 2a: a bare X — 16px glyph at the CTA family's 1.6 stroke
          in a 40px hit box, top-right, centred on the index's line. */}
      <button type="button" class="sp-modal__close" data-sp-close aria-label="Close">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 2 L14 14 M14 2 L2 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="butt" /></svg>
      </button>
      {/* R44 item 8: the progress bar — 2px brand blue, flush to the
          drawer's bottom edge, ⅓ / ⅔ / full across the steps (the
          driver writes --sp-progress). */}
      <div class="sp-progress" data-sp-progress aria-hidden="true"><span class="sp-progress__bar"></span></div>
      <div class="sp-modal__scroll" data-sp-scroll>

      {/* ── /01 */}
      <section class="sp-step" data-sp-step="1">
        {/* R57 item 1b: tabindex -1 — the drawer moves initial focus HERE,
            not onto the first tile (which painted a ring at open). */}
        <h2 class="sp-modal__title" id="sp-title" data-sp-title tabindex="-1">What kind of project?</h2>
        <fieldset class="sp-group" data-sp-pillars aria-describedby="sp-pillars-err">
          <legend class="sp-label">Choose one or more</legend>
          <div class="sp-tiles">
            {PILLARS.map((p) => (
              <label class="sp-tile" data-sp-tile data-char-ripple-trigger>
                <input type="checkbox" name="pillars" value={p.key} class="sp-tile__input" />
                <span class="sp-tile__name" data-char-ripple>{p.name}</span>
                <span class="sp-tile__desc">{p.desc}</span>
              </label>
            ))}
          </div>
          <p class="sp-error" id="sp-pillars-err" data-sp-error="pillars" role="alert"></p>
        </fieldset>
        <fieldset class="sp-group sp-group--who" data-sp-who>
          <legend class="sp-label">Who are you?</legend>
          <div class="sp-chips" role="radiogroup" aria-label="Who are you?">
            {WHO.map((w) => (
              <label class="sp-chip" data-sp-chip data-char-ripple-trigger>
                <input type="radio" name="who" value={w.toLowerCase()} class="sp-chip__input" />
                <span data-char-ripple>{w}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="sp-actions">
          <button type="button" class="ne-cta ne-cta--ghost" data-sp-cancel data-char-ripple-trigger><span data-char-ripple>CANCEL</span></button>
          <button type="button" class="ne-cta sp-btn--primary" data-sp-next data-char-ripple-trigger>
            <span data-char-ripple>NEXT</span>
            <svg class="ne-cta__arrow" viewBox="0 0 12 12" width="12.4" height="12.4" aria-hidden="true" data-char-ripple-arrow><path d="M2 10 L10 2 M3.6 2 H10 V8.4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
        </div>
      </section>

      {/* ── /02 */}
      <section class="sp-step" data-sp-step="2" hidden>
        <h2 class="sp-modal__title" data-sp-title2 tabindex="-1">Tell us more.</h2>
        {/* R44 item 7: placeholders on every field — drafts in the site's
            voice, my-edit-pending (Oscar); one tier below the input's text. */}
        <div class="sp-fields">
          <div class="sp-field">
            <label class="sp-label" for="sp-name">Your name</label>
            <input class="sp-input" id="sp-name" name="name" type="text" autocomplete="name" required placeholder="First and last is fine." aria-describedby="sp-name-err" />
            <p class="sp-error" id="sp-name-err" data-sp-error="name" role="alert"></p>
          </div>
          <div class="sp-field">
            <label class="sp-label" for="sp-email">Your email</label>
            <input class="sp-input" id="sp-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="Where we can reach you." aria-describedby="sp-email-err" />
            <p class="sp-error" id="sp-email-err" data-sp-error="email" role="alert"></p>
          </div>
          <div class="sp-field">
            <label class="sp-label" for="sp-company">Company or brand <span class="sp-label__opt">(optional)</span></label>
            <input class="sp-input" id="sp-company" name="company" type="text" autocomplete="organization" placeholder="The name on the door." aria-describedby="sp-company-err" />
            <p class="sp-error" id="sp-company-err" data-sp-error="company" role="alert"></p>
          </div>
          <div class="sp-field">
            <label class="sp-label" for="sp-message">What should we know?</label>
            <textarea class="sp-input sp-input--area" id="sp-message" name="message" rows="4" required placeholder="The brief, the moment, the ambition." aria-describedby="sp-message-err"></textarea>
            <p class="sp-error" id="sp-message-err" data-sp-error="message" role="alert"></p>
          </div>
          {/* the honeypot — invisible, tab-skipped, autofill bait (the deck-request precedent) */}
          <div class="sp-hp" aria-hidden="true"><label for="sp-website">Website</label><input id="sp-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        </div>
        <div class="sp-actions">
          <button type="button" class="ne-cta ne-cta--ghost" data-sp-back data-char-ripple-trigger><span data-char-ripple>BACK</span></button>
          <button type="submit" class="ne-cta sp-btn--primary" data-sp-send data-char-ripple-trigger>
            <span data-char-ripple data-sp-send-label>SEND</span>
            <svg class="ne-cta__arrow" viewBox="0 0 12 12" width="12.4" height="12.4" aria-hidden="true" data-char-ripple-arrow><path d="M2 10 L10 2 M3.6 2 H10 V8.4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
        </div>
      </section>

      {/* ── success / error (replace the panel's content) */}
      <section class="sp-step sp-step--done" data-sp-step="success" hidden>
        {/* COPY: my-edit-pending (Oscar) */}
        <h2 class="sp-modal__title sp-modal__title--done">That’s a good start.</h2>
        <p class="sp-copy">We’ll be in touch within two working days.</p>
        <div class="sp-actions">
          <button type="button" class="ne-cta sp-btn--primary" data-sp-done data-char-ripple-trigger><span data-char-ripple>CLOSE</span></button>
        </div>
      </section>
      <section class="sp-step sp-step--done" data-sp-step="error" hidden>
        <h2 class="sp-modal__title sp-modal__title--done">Something didn’t send.</h2>
        <p class="sp-copy">Try again in a moment, or email us at <a class="sp-mail" href={MAILTO} data-char-ripple-trigger><span data-char-ripple>{CONTACT_EMAIL}</span></a></p>
        <div class="sp-actions">
          <button type="button" class="ne-cta sp-btn--primary" data-sp-retry data-char-ripple-trigger><span data-char-ripple>TRY AGAIN</span></button>
        </div>
      </section>
      <p class="sp-live" data-sp-live aria-live="polite"></p>
      </div>
    </form>
  </div>
</div>
{/* The logo twin — TOP-LEVEL fixed difference element (the contact modal's construction; never inside the backdrop-filter subtree). */}
<a class="sp-modal__logo" data-sp-logo href="/" hidden>THE NETWORK EFFECT</a>
{/* R44 item 9: the BACKDROP CURSOR — /work's view-case cursor verbatim
    (view-case-cursor.js): one top-level fixed element carrying
    mix-blend-mode: difference ITSELF, following the pointer on left/top
    (never transform), live only while the pointer is over the backdrop;
    the site's dot hides meanwhile. Round brackets per the standing
    ruling; uppercase per every label on the site. [hidden] until the
    form's first open on desktop (the driver boots it lazily). */}
<div class="work-cursor sp-cursor" data-sp-cursor aria-hidden="true" hidden>( CLOSE )</div>

<script>
  import { initStartProject } from '../scripts/start-project.js';
  let cleanup = initStartProject();
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:after-swap', () => { cleanup = initStartProject(); });
</script>
