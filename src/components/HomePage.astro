---
import {
  carouselSlides,
  defaultSlideIndex,
} from '../data/carousel.js';
import '../styles/home.css';

const slidesJson = JSON.stringify(carouselSlides);
const defaultSlide = carouselSlides[defaultSlideIndex];
---

<div
  class="home"
  data-home-carousel
  data-slides={slidesJson}
  data-default-slide={defaultSlideIndex}
  style={`--slide-count: ${carouselSlides.length};`}
>
  <div class="home__chrome">
    <h1 class="home__logo">THE NETWORK EFFECT</h1>

    <ul class="home__clients" aria-label="Clients">
      {
        carouselSlides.map((slide) => (
          <li
            data-carousel-client={slide.client}
            class:list={{
              'is-active': slide.client === defaultSlide.client,
            }}
          >
            {slide.client}
          </li>
        ))
      }
    </ul>

    <aside class="home__intro">
      <p>
        Introductions. Partnerships. The conversations before the campaign. The
        dinner before the deal. The afterparty before the collaboration. The
        trust built long before the headlines. Culture rarely moves in public
        first. It moves quietly. Through people. Through relationships.
      </p>
      <div class="home__intro-links">
        <a href="mailto:hello@thenetworkeffect.com">hello@thenetworkeffect.com</a>
        <a href="https://instagram.com/thenetwork_effect" target="_blank" rel="noopener noreferrer">
          @thenetwork_effect
        </a>
      </div>
    </aside>

    <span class="home__meta home__meta--left" data-carousel-left-label>
      {defaultSlide.leftLabel}
    </span>
    <span class="home__meta home__meta--right" data-carousel-right-label>
      {defaultSlide.rightLabel}
    </span>
    <span class="home__meta home__meta--index" data-carousel-index>
      {defaultSlide.number}
    </span>

    <footer class="home__footer">
      <p>All rights reserved. ©2026 The Network Effect</p>
      <div class="home__theme">
        <span>Light mode</span>
        <img src="/assets/images/ui/toggle.svg" alt="" width="51" height="21" />
      </div>
    </footer>
  </div>

  <section class="carousel-pin" data-carousel-pin aria-label="Work carousel">
    <div class="carousel-viewport" data-carousel-viewport>
      <canvas
        class="carousel-viewport__gl"
        data-curve-canvas
        aria-hidden="true"
      ></canvas>
      <div class="carousel-ui" aria-hidden="true">
        <div class="carousel-ui__frame" data-carousel-frame>
          <img
            class="carousel-ui__bracket carousel-ui__bracket--left"
            src="/assets/images/ui/bracket.svg"
            alt=""
            width="48"
            height="95"
          />
          <img
            class="carousel-ui__bracket carousel-ui__bracket--right"
            src="/assets/images/ui/bracket.svg"
            alt=""
            width="48"
            height="95"
          />
          <img
            class="carousel-ui__dot carousel-ui__dot--left"
            src="/assets/images/ui/dot.svg"
            alt=""
            width="13"
            height="13"
          />
          <img
            class="carousel-ui__dot carousel-ui__dot--right"
            src="/assets/images/ui/dot.svg"
            alt=""
            width="13"
            height="13"
          />
        </div>
      </div>

      <div class="carousel-track" data-carousel-track>
        {
          carouselSlides.map((slide, index) => (
            <article
              class:list={['carousel-slide', { 'is-active': index === defaultSlideIndex }]}
              data-carousel-slide
              style={`--slide-aspect-ratio: ${slide.width} / ${slide.height};`}
            >
              <img
                class="carousel-slide__media"
                data-carousel-image
                data-src={slide.image}
                src={index === defaultSlideIndex ? slide.image : undefined}
                alt=""
                width={slide.width}
                height={slide.height}
                decoding="async"
                class:list={[{ 'is-loaded': index === defaultSlideIndex }]}
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="sphere-gallery" data-sphere-overlay hidden>
    <button
      type="button"
      class="sphere-gallery__close"
      data-sphere-close
      aria-label="Close gallery"
    >
      Close
    </button>
    <div class="sphere-gallery__backdrop" data-sphere-backdrop aria-hidden="true"></div>
    <div class="sphere-gallery__surface touch-none" data-sphere-surface>
      <canvas data-sphere-canvas aria-hidden="true"></canvas>
    </div>
    <p class="sphere-gallery__label" data-sphere-label hidden></p>
  </div>
</div>

<script>
  import { initHomeCarousel } from '../scripts/home-carousel.js';
  import { initSphereGalleryOverlay } from '../scripts/sphere-gallery.js';

  const root = document.querySelector('[data-home-carousel]');
  const slideData = JSON.parse(root?.dataset.slides || '[]');
  const galleryItems = slideData.map((slide) => ({
    src: slide.image,
    alt: slide.client,
    label: slide.client,
  }));

  const sphereGallery = initSphereGalleryOverlay(root, galleryItems);
  let cleanup = initHomeCarousel(root, { onImageClick: () => sphereGallery.open() });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    sphereGallery.destroy();
  });
</script>
