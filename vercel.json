{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        { "type": "host", "value": "networkeffectagency.co.uk" },
        { "type": "host", "value": "www.networkeffectagency.co.uk" }
      ],
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-3",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "networkeffectagency.co.uk"
        }
      ],
      "destination": "/holding-3"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.networkeffectagency.co.uk"
        }
      ],
      "destination": "/holding-3"
    }
  ]
}
